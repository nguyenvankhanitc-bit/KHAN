    <!-- ========== TICKET ========== -->
    <record id="view_phan_he_it_ticket_list" model="ir.ui.view">
        <field name="name">phan.he.it.ticket.list</field>
        <field name="model">phan.he.it.ticket</field>
        <field name="arch" type="xml">
            <list class="o_it_framed_list">
                <field name="code"/>
                <field name="asset_id"/>
                <field name="ticket_type"/>
                <field name="name"/>
                <field name="priority"/>
                <field name="date_reported"/>
                <field name="responsible_id"/>
                <field name="cost_amount" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_phan_he_it_ticket_form" model="ir.ui.view">
        <field name="name">phan.he.it.ticket.form</field>
        <field name="model">phan.he.it.ticket</field>
        <field name="arch" type="xml">
            <form class="o_it_ticket_form">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code" class="o_it_underline_field"/>
                            <field name="asset_id" class="o_it_underline_field"/>
                            <field name="ticket_type" class="o_it_underline_field"/>
                            <field name="name" class="o_it_underline_field"/>
                            <field name="priority" class="o_it_underline_field"/>
                        </group>
                        <group>
                            <field name="date_reported" class="o_it_underline_field"/>
                            <field name="date_start" class="o_it_underline_field"/>
                            <field name="date_done" class="o_it_underline_field"/>
                            <field name="responsible_id" class="o_it_underline_field"/>
                            <field name="provider_id" class="o_it_underline_field"/>
                            <field name="currency_id" class="o_it_underline_field"/>
                            <field name="cost_amount" class="o_it_underline_field"/>
                            <field name="linked_cost_id" class="o_it_underline_field"/>
                        </group>
                    </group>
                    <group string="Mô tả" class="o_it_ticket_desc">
                        <field name="description" nolabel="1" colspan="2" class="o_it_underline_field"/>
                    </group>
                    <group class="o_it_ticket_extra">
                        <field name="root_cause" class="o_it_underline_field"/>
                        <field name="resolution" class="o_it_underline_field"/>
                        <field name="note" class="o_it_underline_field"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_phan_he_it_ticket_maintenance" model="ir.actions.act_window">
        <field name="name">Lịch sử bảo trì</field>
        <field name="res_model">phan.he.it.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ticket_type', '=', 'maintenance')]</field>
        <field name="context">{'default_ticket_type': 'maintenance'}</field>
    </record>
