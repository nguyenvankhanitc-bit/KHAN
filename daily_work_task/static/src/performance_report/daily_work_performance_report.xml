<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkPerformanceReport">
        <div class="o_daily_work_dashboard o_daily_work_performance o_action">
            <DailyWorkAppShell t-props="{ activeNav: shellActiveNav }">
        <div class="o_dpr_root">
            <t t-if="state.loading">
                <div class="o_dpr_loading"><i class="fa fa-spinner fa-spin fa-2x"/><span>Đang tải báo cáo hiệu suất…</span></div>
            </t>
            <t t-elif="state.denied">
                <div class="o_dpr_denied">
                    <i class="fa fa-lock"/>
                    <h2>Không có quyền xem</h2>
                    <p t-esc="state.message"/>
                </div>
            </t>
            <t t-else="">
                <header class="o_dpr_header">
                    <div class="o_dpr_title">
                        <h1>Đánh giá hiệu suất tháng</h1>
                        <p t-esc="state.data.month_label || ''"/>
                    </div>
                    <div class="o_dpr_filters" style="display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 0.5rem;">
                        <select class="form-select form-select-sm o_dpr_filter_ctrl" t-model.number="state.month">
                            <t t-foreach="months" t-as="m" t-key="m">
                                <option t-att-value="m" t-esc="'Tháng ' + m"/>
                            </t>
                        </select>
                        <select class="form-select form-select-sm o_dpr_filter_ctrl" t-model.number="state.year">
                            <t t-foreach="years" t-as="y" t-key="y">
                                <option t-att-value="y" t-esc="y"/>
                            </t>
                        </select>
                        <select class="form-select form-select-sm o_dpr_filter_ctrl o_dpr_filter_dept" t-model.number="state.departmentId">
                            <option value="0">Tất cả phòng ban</option>
                            <t t-foreach="state.data.departments or []" t-as="d" t-key="d.id">
                                <option t-att-value="d.id" t-esc="d.name"/>
                            </t>
                        </select>
                        <button type="button" class="btn btn-primary btn-sm o_dpr_filter_btn" t-on-click="onFilter">
                            <i class="fa fa-filter"/> Lọc
                        </button>
                        <button type="button" class="btn btn-success btn-sm o_dpr_filter_btn" t-att-disabled="state.exporting" t-on-click="onExport">
                            <i t-att-class="state.exporting ? 'fa fa-spinner fa-spin' : 'fa fa-file-excel-o'"/> Xuất Excel
                        </button>
                    </div>
                </header>

                <t t-if="state.message">
                    <div class="o_dpr_msg" t-esc="state.message"/>
                </t>

                <!-- KPI: so với tháng trước -->
                <div class="o_dpr_kpi4">
                    <t t-foreach="kpiCards" t-as="c" t-key="c.key">
                        <div class="o_dpr_kpi4_card">
                            <div class="o_dpr_kpi4_top">
                                <span class="o_dpr_kpi4_label" t-esc="c.label"/>
                                <i t-att-class="'fa ' + c.trendIcon + ' o_dpr_trend ' + c.trendClass"/>
                            </div>
                            <strong t-esc="c.value"/>
                            <small><b t-att-class="c.trendClass" t-esc="c.deltaText"/> so với tháng trước</small>
                        </div>
                    </t>
                </div>

                <!-- Biểu đồ: theo phòng ban + xu hướng -->
                <div class="o_dpr_charts">
                    <div class="o_dpr_chart_card">
                        <h3>Hiệu suất theo team</h3>
                        <p>Công việc trong tháng theo trạng thái của từng team</p>
                        <div class="o_dpr_chart_box"><canvas t-ref="deptChart"/></div>
                    </div>
                    <div class="o_dpr_chart_card">
                        <h3>Xu hướng hoàn thành</h3>
                        <p>Tổng công việc và số việc hoàn thành 7 tháng gần nhất</p>
                        <div class="o_dpr_chart_box"><canvas t-ref="trendChart"/></div>
                    </div>
                </div>

                <!-- Bảng hiệu suất nhân sự -->
                <div class="o_dpr_chart_card o_dpr_staff_card">
                    <h3>Hiệu suất nhân sự</h3>
                    <p>Số liệu công việc trong tháng theo từng nhân sự</p>
                    <table class="o_dpr_staff">
                        <thead>
                            <tr>
                                <th>Nhân sự</th>
                                <th class="num">Tổng CV</th>
                                <th class="num">Hoàn thành</th>
                                <th class="num">Đang làm</th>
                                <th class="num">Chưa làm</th>
                                <th class="num">Trễ hạn</th>
                                <th class="num">Hiệu suất</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data.staff_groups or []" t-as="g" t-key="g.key">
                                <!-- Dòng nhóm phòng ban (bấm để thu gọn / mở) -->
                                <tr class="o_dpr_dept_row" t-on-click="() => this.toggleDept(g)">
                                    <td>
                                        <i t-att-class="'fa ' + (isDeptOpen(g) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                        <b t-esc="g.name"/>
                                        <em t-esc="g.count + ' nhân sự'"/>
                                    </td>
                                    <td class="num" t-esc="g.total"/>
                                    <td class="num is-done" t-esc="g.done"/>
                                    <td class="num is-doing" t-esc="g.doing"/>
                                    <td class="num is-todo" t-esc="g.todo"/>
                                    <td class="num is-late" t-esc="g.late"/>
                                    <td class="num">
                                        <span t-att-class="'o_dpr_eff ' + effClass(g.efficiency)" t-esc="g.efficiency + '%'"/>
                                    </td>
                                </tr>
                            <t t-if="isDeptOpen(g)">
                            <t t-foreach="g.rows" t-as="r" t-key="g.key + '-' + r.id">
                                <tr>
                                    <td>
                                        <span class="o_dpr_staff_avatar" t-esc="initials(r.name)"/>
                                        <span class="o_dpr_staff_name">
                                            <b t-esc="r.name"/>
                                            <small t-esc="r.job || ''"/>
                                        </span>
                                    </td>
                                    <td class="num" t-esc="r.total"/>
                                    <td class="num is-done" t-esc="r.done"/>
                                    <td class="num is-doing" t-esc="r.doing"/>
                                    <td class="num is-todo" t-esc="r.todo"/>
                                    <td class="num is-late" t-esc="r.late"/>
                                    <td class="num">
                                        <span t-att-class="'o_dpr_eff ' + effClass(r.efficiency)" t-esc="r.efficiency + '%'"/>
                                    </td>
                                </tr>
                            </t>
                            </t>
                            </t>
                            <tr t-if="!(state.data.staff || []).length">
                                <td colspan="7" class="text-muted text-center">Chưa có dữ liệu nhân sự.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </t>
        </div>
            </DailyWorkAppShell>
        </div>
    </t>

    <t t-name="daily_work_task.DprTreeNodes">
        <t t-foreach="nodes" t-as="node" t-key="node.id">
            <div class="o_dpr_node" t-att-style="'padding-left:' + (depth * 14) + 'px'">
                <button type="button"
                        t-att-class="'o_dpr_node_btn' + (state.selectedEmployeeId === node.id ? ' active' : '')"
                        t-on-click="() => this.selectEmployee(node.id)">
                    <t t-if="node.children and node.children.length">
                        <i t-att-class="'fa o_dpr_caret ' + (isExpanded(node.id) ? 'fa-caret-down' : 'fa-caret-right')"
                           t-on-click="(ev) => this.toggleNode(node.id, ev)"/>
                    </t>
                    <t t-else="">
                        <i class="fa fa-circle o_dpr_leaf"/>
                    </t>
                    <span class="name" t-esc="node.name"/>
                    <t t-if="node.job"><em t-esc="'(' + node.job + ')'"/></t>
                    <strong class="eff" t-esc="(node.stats and node.stats.efficiency) + '%'"/>
                </button>
            </div>
            <t t-if="node.children and node.children.length and isExpanded(node.id)">
                <t t-call="daily_work_task.DprTreeNodes">
                    <t t-set="nodes" t-value="node.children"/>
                    <t t-set="depth" t-value="depth + 1"/>
                </t>
            </t>
        </t>
    </t>
</templates>
