<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_store_checklist">
        <field name="name">Checklist Audit</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="sequence">47</field>
        <field name="placeholder">Không</field>
    </record>

    <record id="group_store_user" model="res.groups">
        <field name="name">Nhân viên</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_store_checklist"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Tạo, chấm điểm phiếu đánh giá và xử lý khắc phục.</field>
    </record>

    <record id="group_store_manager" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_store_checklist"/>
        <field name="implied_ids" eval="[(4, ref('group_store_user'))]"/>
        <field name="comment">Xóa phiếu, cấu hình cửa hàng, mẫu checklist, điểm chuẩn và phân quyền.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <!-- Phân quyền xem phiếu: Quản trị/Quản lý xem tất cả; user có Chức danh "Giám sát" chỉ xem phiếu do mình đánh giá; user khác xem đầy đủ. -->
    <record id="rule_store_audit_manager_all" model="ir.rule">
        <field name="name">Phiếu audit: Quản lý xem tất cả</field>
        <field name="model_id" ref="model_store_audit"/>
        <field name="groups" eval="[(4, ref('group_store_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_store_audit_user_scope" model="ir.rule">
        <field name="name">Phiếu audit: Giám sát chỉ xem phiếu của mình</field>
        <field name="model_id" ref="model_store_audit"/>
        <field name="groups" eval="[(4, ref('group_store_user'))]"/>
        <field name="domain_force">[('auditor_id', '=', user.id)] if 'giám sát' in (user.employee_id.job_title or '').strip().lower() else [(1, '=', 1)]</field>
    </record>
    <record id="rule_store_audit_line_manager_all" model="ir.rule">
        <field name="name">Chi tiết phiếu audit: Quản lý xem tất cả</field>
        <field name="model_id" ref="model_store_audit_line"/>
        <field name="groups" eval="[(4, ref('group_store_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_store_audit_line_user_scope" model="ir.rule">
        <field name="name">Chi tiết phiếu audit: Giám sát chỉ sửa phiếu của mình</field>
        <field name="model_id" ref="model_store_audit_line"/>
        <field name="groups" eval="[(4, ref('group_store_user'))]"/>
        <!-- Đọc không bị chặn: xem hình ảnh lỗi trong Danh sách xử lý sai phạm cần quyền đọc dòng chi tiết -->
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('audit_id.auditor_id', '=', user.id)] if 'giám sát' in (user.employee_id.job_title or '').strip().lower() else [(1, '=', 1)]</field>
    </record>
    <record id="rule_store_audit_action_manager_all" model="ir.rule">
        <field name="name">Khắc phục: Quản lý xem tất cả</field>
        <field name="model_id" ref="model_store_audit_action"/>
        <field name="groups" eval="[(4, ref('group_store_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_store_audit_action_user_scope" model="ir.rule">
        <field name="name">Khắc phục: Giám sát chỉ sửa phiếu của mình hoặc việc được giao</field>
        <field name="model_id" ref="model_store_audit_action"/>
        <field name="groups" eval="[(4, ref('group_store_user'))]"/>
        <!-- Đọc không bị chặn (xem theo ma trận phân quyền; ảnh đính kèm cũng kiểm tra quyền đọc dòng này) -->
        <field name="perm_read" eval="False"/>
        <field name="domain_force">['|', '|', ('audit_id.auditor_id', '=', user.id), ('responsible_ids.user_id', '=', user.id), ('reviewer_ids', '=', user.id)] if 'giám sát' in (user.employee_id.job_title or '').strip().lower() else [(1, '=', 1)]</field>
    </record>
</odoo>