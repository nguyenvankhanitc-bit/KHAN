<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="store_checklist.ViolationHeader">
        <div class="o_store_viol_hdr" t-if="state.d">
            <div class="vh_title">
                <img class="vh_logo" t-att-src="'/web/image/res.company/' + state.d.company_id + '/logo_web'" alt="Logo công ty"/>
                <div>
                    <h2>BIÊN BẢN XỬ LÝ SAI PHẠM</h2>
                    <p>Cửa hàng: <b t-esc="state.d.store"/> &#160;|&#160; Ngày kiểm tra: <t t-esc="state.d.date"/></p>
                </div>
            </div>
            <div class="vh_cards">
                <div class="vh_card is-blue">
                    <i class="fa fa-calendar"/>
                    <div><span>Tổng điểm đạt</span><b><t t-esc="fmt(state.d.got)"/> / <t t-esc="fmt(state.d.max)"/></b>
                        <div class="vh_bar"><div t-attf-style="width: {{gotPct}}%"/></div></div>
                </div>
                <div class="vh_card is-red">
                    <i class="fa fa-minus-circle"/>
                    <div><span>Tổng điểm trừ</span><b class="text-danger" t-esc="fmt(state.d.deduct)"/></div>
                </div>
                <div class="vh_card is-green">
                    <i class="fa fa-check-circle"/>
                    <div><span>Số lỗi cần xử lý</span><b><t t-esc="state.d.total"/> tiêu chí</b></div>
                </div>
                <div class="vh_card is-gray">
                    <i class="fa fa-percent"/>
                    <div><span>Tiến độ khắc phục</span><b><t t-esc="state.d.done"/> / <t t-esc="state.d.total"/></b>
                        <small>(Đã hoàn thành <t t-esc="donePct"/>%)</small></div>
                </div>
            </div>
            <div class="vh_actions">
                <button type="button" class="vh_btn is-excel" t-on-click="exportExcel"><i class="fa fa-file-excel-o"/> Xuất Excel</button>
                <button type="button" class="vh_btn is-print" t-on-click="print"><i class="fa fa-print"/> In</button>
            </div>
        </div>
    </t>

    <t t-name="store_checklist.MgrDetailDialog">
        <Dialog header="false" footer="false" size="'xl'">
            <div class="o_store_mgr_dlg">
                <div class="hd">
                    <button type="button" class="back" t-on-click="props.close"><i class="fa fa-angle-left"/></button>
                    <h4>Chi tiết: <b t-esc="props.row.name"/></h4>
                    <span class="acts">
                        <button type="button" class="o_store_print_btn" t-on-click="print"><i class="fa fa-print"/> In</button>
                        <button type="button" class="o_store_export_btn" t-on-click="exportExcel"><i class="fa fa-download"/> Xuất Excel</button>
                    </span>
                </div>
                <div class="top">
                    <div class="who">
                        <span class="av"><i class="fa fa-user"/></span>
                        <div><b t-esc="props.row.name"/><small>Quản lý cửa hàng</small><em><i class="fa fa-map-marker"/> <t t-esc="props.row.area"/></em></div>
                    </div>
                    <div class="tiles">
                        <div class="t1"><i class="fa fa-building-o"/><small>Số cửa hàng</small><strong t-esc="props.row.store_count"/></div>
                        <div class="bad"><i class="fa fa-exclamation-triangle"/><small>Tổng số lỗi</small><strong t-esc="props.row.errors"/></div>
                        <div class="t3"><i class="fa fa-star"/><small>Điểm TB</small><strong t-esc="props.row.avg"/></div>
                        <div class="ok"><i class="fa fa-check-circle" t-att-style="'color:' + levelColor"/><small>Xếp loại</small><strong class="lv" t-att-style="'color:' + levelColor" t-esc="props.row.level"/></div>
                    </div>
                </div>
                <div class="list">
                    <div class="lh">
                        <h5><i class="fa fa-building-o"/> Danh sách cửa hàng quản lý phụ trách</h5>
                        <span class="pills">
                            <button type="button" t-att-class="state.tab === 'all' ? 'on' : ''" t-on-click="() => this.setTab('all')">Tất cả</button>
                            <button type="button" t-att-class="state.tab === 'ok' ? 'on' : ''" t-on-click="() => this.setTab('ok')">Đạt chuẩn</button>
                            <button type="button" t-att-class="state.tab === 'bad' ? 'on' : ''" t-on-click="() => this.setTab('bad')">Cần cải thiện</button>
                        </span>
                    </div>
                    <table>
                        <thead><tr><th>STT</th><th>Mã cửa hàng</th><th>Tên cửa hàng</th><th>Điểm GS</th><th>Điểm ASM</th><th>Tổng số lỗi</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
                        <tbody>
                            <tr t-foreach="view.page" t-as="s" t-key="s.store">
                                <td t-esc="state.page * view.size + s_index + 1"/><td t-esc="s.code"/><td t-esc="s.store"/>
                                <td t-esc="s.gs === null ? '—' : s.gs"/><td t-esc="s.asm === null ? '—' : s.asm"/><td t-esc="s.errors"/>
                                <td><span t-att-class="'st ' + (s.ok ? 'okc' : 'badc')"><i t-att-class="'fa ' + (s.ok ? 'fa-check-circle' : 'fa-exclamation-circle')"/> <t t-esc="s.ok ? 'Đạt chuẩn' : 'Cần cải thiện'"/></span></td>
                                <td><button type="button" class="vw" t-on-click="() => props.onView(s.audit)"><i class="fa fa-search"/> Xem chi tiết</button></td>
                            </tr>
                            <tr t-if="!view.rows.length"><td colspan="8" class="text-muted">Không có cửa hàng nào.</td></tr>
                        </tbody>
                    </table>
                    <div class="ft">
                        <span><i class="fa fa-info-circle"/> Tổng cộng: <t t-esc="props.row.stores.length"/> cửa hàng • <t t-esc="view.errors"/> lỗi</span>
                        <span class="pg">
                            <button type="button" t-att-disabled="state.page === 0" t-on-click="() => state.page--"><i class="fa fa-angle-left"/></button>
                            <button type="button" t-foreach="Array.from({length: view.pages}, (_, i) => i)" t-as="i" t-key="i" t-att-class="i === state.page ? 'on' : ''" t-on-click="() => state.page = i" t-esc="i + 1"/>
                            <button type="button" t-att-disabled="state.page >= view.pages - 1" t-on-click="() => state.page++"><i class="fa fa-angle-right"/></button>
                        </span>
                    </div>
                </div>
            </div>
        </Dialog>
    </t>

    <t t-name="store_checklist.ViolPickDialog">
        <Dialog title="props.title" size="'md'">
            <p class="text-muted mb-2">Chọn cửa hàng cần <t t-esc="props.confirmLabel.toLowerCase()"/>:</p>
            <label class="d-flex align-items-center gap-2 fw-bold border-bottom pb-2 mb-2">
                <input type="checkbox" t-att-checked="allPicked" t-on-change="toggleAll"/> Chọn tất cả (<t t-esc="props.stores.length"/> cửa hàng)
            </label>
            <div style="max-height: 320px; overflow-y: auto;">
                <label t-foreach="props.stores" t-as="s" t-key="s.id" class="d-flex align-items-center gap-2 py-1">
                    <input type="checkbox" t-model="state.picked[s.id]"/>
                    <span t-esc="s.name"/> <span class="text-muted" t-esc="'(' + s.count + ' lỗi)'"/>
                </label>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!pickedIds.length" t-on-click="confirm"><t t-esc="props.confirmLabel"/> (<t t-esc="pickedIds.length"/>)</button>
                <button class="btn btn-secondary" t-on-click="props.close">Hủy</button>
            </t>
        </Dialog>
    </t>

    <t t-name="store_checklist.ViolationListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <StoreViolationHeader auditId="props.context.default_audit_id" bus="model.bus"/>
        </xpath>
    </t>
</templates>
