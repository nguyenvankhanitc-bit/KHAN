<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_phan_he.PhanHeInternetShell">
        <div class="o_phan_he_shell o_action o_internet_master"
             t-ref="shellRoot"
             t-att-class="(state.collapsed ? 'is-sidebar-collapsed ' : '') + (props.contentMode === 'view' ? 'is-detail' : 'is-overview') + (props.moduleCode === 'internet' ? ' is-internet-nav' : '')"
             t-att-style="sidebarStyle">
            <div class="sidebar-top-actions d-flex align-items-center gap-2 mb-3">
                <button type="button" class="btn-circle-action" t-on-click="onBackToDashboard" title="Quay lại Tổng quan">
                    <i class="fa fa-arrow-left"/>
                </button>
                <button type="button" class="btn-circle-action" t-on-click="toggleSidebar" title="Thu gọn menu">
                    <i class="fa fa-bars"/>
                </button>
            </div>
            <aside class="o_internet_sidebar o_phan_he_sidebar linkq-sidebar">
                <div class="o_phan_he_sidebar_brand" t-on-click="() => this.props.onOverview()" role="button" title="Tổng quan">
                    <span class="o_phan_he_brand_text brand-text" t-esc="props.brand"/>
                </div>
                <nav class="o_phan_he_sidebar_nav">
                    <button type="button"
                            class="o_phan_he_nav_item is-icon-overview"
                            title="Tổng quan"
                            t-if="showOverview"
                            t-att-class="(props.activeNav === 'overview' ? 'is-active' : '') + ' is-icon-overview'"
                            t-on-click="() => this.props.onOverview()">
                        <i class="fa fa-bar-chart" title="Tổng quan"/>
                        <span>Tổng quan</span>
                    </button>
                    <t t-foreach="props.navSections or []" t-as="section" t-key="section.id">
                        <div class="o_phan_he_nav_group"
                             t-att-class="props.isGroupOpen(section.id) ? 'is-open' : ''">
                            <button type="button"
                                    class="o_phan_he_nav_section"
                                    t-att-class="section.iconTone ? ('is-icon-' + section.iconTone) : ''"
                                    t-att-title="section.label"
                                    t-on-click="() => this.props.onToggleGroup(section.id)">
                                <i t-att-class="'fa ' + section.icon" t-att-title="section.label"/>
                                <span t-esc="section.label"/>
                                <i t-att-class="sectionCaretClass(section)"/>
                            </button>
                            <t t-if="showSectionChildren(section)">
                                <t t-foreach="section.children" t-as="child" t-key="child.id">
                                    <button type="button"
                                            class="o_phan_he_nav_sub"
                                            t-att-class="props.navChildClass(child)"
                                            t-att-title="child.label"
                                            t-on-click="() => this.props.onNavChild(child)">
                                        <i t-att-class="'fa ' + (child.icon || 'fa-circle-o')"
                                           t-att-title="child.label"/>
                                        <span t-esc="child.label"/>
                                        <t t-if="child.badgeKey">
                                            <span t-attf-class="o_phan_he_nav_badge {{badgeClass(child)}}"
                                                  t-esc="badgeValue(child)"/>
                                        </t>
                                    </button>
                                </t>
                            </t>
                        </div>
                    </t>
                </nav>
            </aside>
            <div class="o_sidebar_resizer"
                 t-att-class="(state.dragging ? 'is-dragging ' : '') + (state.collapsed ? 'is-disabled' : '')"
                 t-on-mousedown="onResizeStart"
                 title="Kéo để đổi độ rộng sidebar">
                <span class="o_sidebar_resizer_grip"/>
            </div>
            <div class="o_internet_content o_phan_he_dashboard">
                <t t-if="props.contentMode === 'view' and props.embeddedViewProps">
                    <View t-props="props.embeddedViewProps" t-key="props.viewKey"/>
                </t>
                <t t-else="">
                    <t t-slot="default"/>
                </t>
            </div>
        </div>
    </t>
</templates>
