<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lịch xếp ca NVBH: nhân sự (bảng Nhân sự) + Mã ca (Cài đặt > Mã ca) -->
    <record id="view_store_nvbh_schedule_form" model="ir.ui.view">
        <field name="name">store.nvbh.schedule.form</field>
        <field name="model">store.nvbh.schedule</field>
        <field name="arch" type="xml">
            <form string="Lịch xếp ca" class="o_store_audit_form o_store_check_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="is_past" invisible="1"/>
                    <div class="alert alert-secondary mb-2" role="status" invisible="not is_past">
                        <i class="fa fa-lock"/> Lịch quá khứ: chỉ xem, không được chỉnh sửa.
                    </div>
                    <div class="o_store_audit_title">
                        <img class="o_store_logo" src="/web/binary/company_logo" alt="Logo công ty"/>
                        <img class="o_store_audit_icon" src="/store_checklist/static/src/shell/img/audit_icon.png" alt=""/>
                        <div class="o_store_audit_text">
                            <h2>LỊCH XẾP CA</h2>
                            <p>Phân ca làm việc cho nhân viên bán hàng theo cửa hàng và ngày</p>
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;padding:10px 12px;background:#fff;border-radius:10px;box-shadow:0 1px 4px rgba(0,0,0,.08);margin-bottom:14px;">
                        <div><div class="fw-bold mb-1">Cửa hàng</div>
                            <field name="store_id" nolabel="1" options="{'no_create': True}" readonly="is_past"/></div>
                        <div><div class="fw-bold mb-1">Ngày</div>
                            <field name="work_date" nolabel="1" options="{'numeric': true}" readonly="is_past"/></div>
                    </div>
                    <field name="line_ids" nolabel="1" readonly="is_past">
                        <list editable="bottom" string="Lịch xếp ca" decoration-muted="is_locked">
                            <field name="is_locked" column_invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="stt"/>
                            <field name="staff_name" string="Họ và tên NV" required="1" readonly="is_locked" placeholder="Nhập họ và tên"/>
                            <field name="employee_code" string="ID" readonly="is_locked"/>
                            <field name="position" string="Chức vụ" readonly="is_locked"/>
                            <field name="work_status" string="Trạng thái nhân viên" readonly="is_locked"/>
                            <field name="shift_id" string="Mã ca" readonly="is_locked" options="{'no_create': True}"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_store_nvbh_schedule_line_list" model="ir.ui.view">
        <field name="name">store.nvbh.schedule.line.list</field>
        <field name="model">store.nvbh.schedule.line</field>
        <field name="arch" type="xml">
            <list string="Lịch xếp ca" create="false" edit="false" default_order="work_date desc, schedule_id desc, sequence, id">
                <field name="stt"/>
                <field name="staff_name" string="Họ và tên NV"/>
                <field name="employee_code"/>
                <field name="position"/>
                <field name="shift_id"/>
                <field name="store_id"/>
                <field name="work_date" options="{'numeric': true}"/>
                <field name="mien" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_store_nvbh_schedule" model="ir.actions.act_window">
        <field name="name">Lịch xếp ca</field>
        <field name="res_model">store.nvbh.schedule.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_store_nvbh_schedule_line_list"/>
    </record>

    <!-- Checklist NVBH > Lịch ca hôm nay: ca của ngày hôm nay lấy từ Lịch xếp ca (Công việc check list), nhóm theo Miền / Cửa hàng -->
    <record id="view_store_nvbh_today_list" model="ir.ui.view">
        <field name="name">store.nvbh.schedule.line.today.list</field>
        <field name="model">store.nvbh.schedule.line</field>
        <field name="arch" type="xml">
            <list string="Lịch ca hôm nay" create="false" edit="false" delete="false" default_order="store_id, sequence, id" class="o_store_today_list">
                <field name="mien" string="Miền"/>
                <field name="store_id" string="Mã bộ phận"/>
                <field name="employee_code" string="ID HRM" optional="hide"/>
                <field name="staff_name" string="Họ và tên"/>
                <field name="position" string="Mã chức vụ"/>
                <field name="shift_id" string="N (ca hôm nay)"/>
                <field name="work_date" options="{'numeric': true}" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_store_nvbh_today_search" model="ir.ui.view">
        <field name="name">store.nvbh.schedule.line.today.search</field>
        <field name="model">store.nvbh.schedule.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="staff_name"/>
                <field name="store_id"/>
                <field name="shift_id"/>
                <group>
                    <filter name="g_mien" string="Miền" context="{'group_by': 'mien'}"/>
                    <filter name="g_store" string="Cửa hàng" context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_store_nvbh_today" model="ir.actions.act_window">
        <field name="name">Lịch ca hôm nay</field>
        <field name="res_model">store.nvbh.schedule.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_store_nvbh_today_list"/>
        <field name="search_view_id" ref="view_store_nvbh_today_search"/>
        <!-- Chỉ ngày hôm nay: domain tính lại mỗi lần mở mục (20/11 -> dữ liệu 20/11, sang 21/11 -> dữ liệu 21/11) -->
        <field name="domain">[('work_date', '=', context_today().strftime('%Y-%m-%d'))]</field>
        <!-- store_today_shift: server lọc thêm ngày hôm nay + phạm vi cửa hàng (xem _search) -->
        <field name="context">{'store_today_shift': True, 'search_default_g_mien': 1, 'search_default_g_store': 1}</field>
    </record>
</odoo>
