<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_linkq_erp" model="ir.module.category">
        <field name="name">LinkQ ERP - Phân quyền Lịch ca</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_linkq_erp_schedule" model="res.groups.privilege">
        <field name="name">LinkQ ERP - Phân quyền Lịch ca</field>
        <field name="category_id" ref="category_linkq_erp"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_linkq_schedule_user" model="res.groups">
        <field name="name">Xem Lịch Xếp Ca</field>
        <field name="privilege_id" ref="privilege_linkq_erp_schedule"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_linkq_schedule_north" model="res.groups">
        <field name="name">Xem Lịch Miền Bắc</field>
        <field name="privilege_id" ref="privilege_linkq_erp_schedule"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_linkq_schedule_south" model="res.groups">
        <field name="name">Xem Lịch Miền Nam</field>
        <field name="privilege_id" ref="privilege_linkq_erp_schedule"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_linkq_schedule_dtt" model="res.groups">
        <field name="name">Xem Lịch Miền ĐTT</field>
        <field name="privilege_id" ref="privilege_linkq_erp_schedule"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_linkq_schedule_config" model="res.groups">
        <field name="name">Cấu hình Ký hiệu công</field>
        <field name="privilege_id" ref="privilege_linkq_erp_schedule"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Cùng model lịch cửa hàng: ACL chỉ đọc; rule lọc theo miền -->
    <record id="rule_linkq_store_schedule_north" model="ir.rule">
        <field name="name">Lịch cửa hàng: Miền Bắc</field>
        <field name="model_id" ref="model_linkq_store_schedule"/>
        <field name="domain_force">[('region', '=', 'north')]</field>
        <field name="groups" eval="[(4, ref('group_linkq_schedule_north'))]"/>
    </record>
    <record id="rule_linkq_store_schedule_line_north" model="ir.rule">
        <field name="name">Dòng lịch cửa hàng: Miền Bắc</field>
        <field name="model_id" ref="model_linkq_store_schedule_line"/>
        <field name="domain_force">[('region', '=', 'north')]</field>
        <field name="groups" eval="[(4, ref('group_linkq_schedule_north'))]"/>
    </record>
    <record id="rule_linkq_store_schedule_south" model="ir.rule">
        <field name="name">Lịch cửa hàng: Miền Nam</field>
        <field name="model_id" ref="model_linkq_store_schedule"/>
        <field name="domain_force">[('region', '=', 'south')]</field>
        <field name="groups" eval="[(4, ref('group_linkq_schedule_south'))]"/>
    </record>
    <record id="rule_linkq_store_schedule_line_south" model="ir.rule">
        <field name="name">Dòng lịch cửa hàng: Miền Nam</field>
        <field name="model_id" ref="model_linkq_store_schedule_line"/>
        <field name="domain_force">[('region', '=', 'south')]</field>
        <field name="groups" eval="[(4, ref('group_linkq_schedule_south'))]"/>
    </record>
    <record id="rule_linkq_store_schedule_dtt" model="ir.rule">
        <field name="name">Lịch cửa hàng: Miền ĐTT</field>
        <field name="model_id" ref="model_linkq_store_schedule"/>
        <field name="domain_force">[('region', '=', 'dtt')]</field>
        <field name="groups" eval="[(4, ref('group_linkq_schedule_dtt'))]"/>
    </record>
    <record id="rule_linkq_store_schedule_line_dtt" model="ir.rule">
        <field name="name">Dòng lịch cửa hàng: Miền ĐTT</field>
        <field name="model_id" ref="model_linkq_store_schedule_line"/>
        <field name="domain_force">[('region', '=', 'dtt')]</field>
        <field name="groups" eval="[(4, ref('group_linkq_schedule_dtt'))]"/>
    </record>
</odoo>
