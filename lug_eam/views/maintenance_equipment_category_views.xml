<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eam_equipment_category_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.category.form.eam</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_eam_models" type="object" class="oe_stat_button" icon="fa-tags"
                        groups="lug_eam.group_eam_user">
                    <field name="eam_model_count" widget="statinfo" string="Model"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <label for="code"/>
                <h2><field name="code" placeholder="CAT_AC"/></h2>
            </xpath>
            <xpath expr="//field[@name='technician_user_id']" position="before">
                <field name="parent_id"/>
                <field name="complete_name" readonly="1"/>
                <field name="code_token" placeholder="IT"/>
                <field name="require_qr"/>
                <field name="require_warranty"/>
                <field name="maintenance_cycle_month"/>
                <field name="inspection_cycle_month"/>
                <field name="asset_sequence_id" groups="lug_eam.group_eam_admin"/>
            </xpath>
        </field>
    </record>

    <record id="view_eam_equipment_category_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.category.list.eam</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">complete_name</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="code"/>
                <field name="complete_name" optional="show"/>
                <field name="parent_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="require_qr" optional="show"/>
                <field name="maintenance_cycle_month" optional="show"/>
                <field name="eam_model_count" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_eam_equipment_category_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.category.search.eam</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="code"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <filter string="Nhóm gốc" name="root_only" domain="[('parent_id', '=', False)]"/>
                <group>
                    <filter string="Nhóm cha" name="group_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_eam_category" model="ir.actions.act_window">
        <field name="name">Nhóm tài sản</field>
        <field name="res_model">maintenance.equipment.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="maintenance.hr_equipment_category_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo nhóm tài sản</p>
            <p>Phân cấp: HVAC → Máy lạnh, CNTT → Laptop...</p>
        </field>
    </record>
</odoo>
