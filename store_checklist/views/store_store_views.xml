<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_store_form" model="ir.ui.view">
        <field name="name">store.store.form</field>
        <field name="model">store.store</field>
        <field name="arch" type="xml">
            <form string="Cửa hàng / Gian hàng">
                <sheet>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên cửa hàng..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="province"/>
                            <field name="area"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Địa chỉ / TTTM">
                        <field name="address" nolabel="1" colspan="2" placeholder="Nhập địa chỉ cửa hàng..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_store_store_list" model="ir.ui.view">
        <field name="name">store.store.list</field>
        <field name="model">store.store</field>
        <field name="arch" type="xml">
            <list group_edit="0" group_delete="0" string="Danh sách cửa hàng">
                <field name="code"/>
                <field name="name"/>
                <field name="province"/>
                <field name="address"/>
                <field name="area"/>
                <field name="manager"/>
            </list>
        </field>
    </record>

    <record id="action_store_store" model="ir.actions.act_window">
        <field name="name">Cửa hàng</field>
        <field name="res_model">store.store</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Danh sách chọn cửa hàng gọn (điện thoại mở hộp thoại "Tìm kiếm thêm"): không đọc quản lý/công ty nên không lỗi quyền -->
    <record id="view_hr_store_pick_list" model="ir.ui.view">
        <field name="name">hr.store.pick.list</field>
        <field name="model">hr.store</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Cửa hàng">
                <field name="name"/>
                <field name="code"/>
                <field name="mien"/>
            </list>
        </field>
    </record>
</odoo>
