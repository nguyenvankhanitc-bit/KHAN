<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_daily_task_list" model="ir.ui.view">
        <field name="name">daily.task.list</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <list string="Danh sách công việc" decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'" decoration-muted="state == 'not_started'"
                  decoration-danger="is_overdue">
                <field name="name"/>
                <field name="assign_date" string="Ngày giao" optional="show"/>
                <field name="assigned_by_id" string="Người giao" optional="show"/>
                <field name="deadline"/>
                <field name="department_id" optional="hide"/>
                <field name="work_group_id" optional="show"/>
                <field name="assignee_id"/>
                <field name="priority" widget="badge"
                         decoration-danger="priority == 'high'"
                         decoration-warning="priority == 'medium'"
                         decoration-muted="priority == 'low'"/>
                <field name="duration_minutes" string="Phút" optional="show"/>
                <field name="duration_hours" string="Giờ" optional="show" sum="Tổng giờ"/>
                <field name="completion_percent" string="% Hoàn thành CV" optional="show"/>
                <field name="state" widget="badge"
                         decoration-success="state == 'done'"
                         decoration-info="state == 'in_progress'"
                         decoration-muted="state == 'not_started'"/>
                <field name="is_overdue" optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form chuẩn Odoo: sheet giữa + Chatter phải -->
    <record id="view_daily_task_form" model="ir.ui.view">
        <field name="name">daily.task.form</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <form string="Công việc">
                <header>
                    <button name="action_set_not_started" type="object" string="Chưa bắt đầu"
                            invisible="state == 'not_started'" class="btn-secondary"/>
                    <button name="action_set_in_progress" type="object" string="Đang xử lý"
                            invisible="state == 'in_progress'" class="btn-primary"/>
                    <button name="action_set_done" type="object" string="Hoàn thành"
                            invisible="state == 'done'" class="btn-success"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="not_started,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Quá hạn" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <label for="name" string="Tên công việc"/>
                        <h1>
                            <field name="name" placeholder="Nhập tên công việc..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin giao việc">
                            <field name="assigned_by_id" widget="many2one_avatar_user"/>
                            <field name="assignee_id"/>
                            <field name="assignee_user_id" widget="many2one_avatar_user"
                                   string="User nhận việc"/>
                            <field name="employee_hr_id" invisible="1"/>
                            <field name="assign_date"/>
                            <field name="deadline"/>
                        </group>
                        <group string="Phân loại &amp; tiến độ">
                            <field name="department_id"/>
                            <field name="work_group_id"/>
                            <field name="priority"/>
                            <field name="duration_minutes"/>
                            <field name="duration_hours" readonly="1"/>
                            <field name="completion_percent" widget="progressbar"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả" name="page_description">
                            <field name="description" nolabel="1"
                                   placeholder="Mô tả yêu cầu / nội dung công việc..."/>
                            <separator string="Ghi chú ngắn"/>
                            <field name="note" nolabel="1" placeholder="Ghi chú bổ sung"/>
                        </page>
                        <page string="Checklist" name="page_checklist">
                            <field name="checklist_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="done" widget="boolean"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter: gửi tin, ghi chú nội bộ, đính kèm ảnh/tài liệu -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban mặc định: nhóm theo trạng thái -->
    <record id="view_daily_task_kanban" model="ir.ui.view">
        <field name="name">daily.task.kanban</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kanban_column"
                    class="o_kanban_small_column o_daily_task_kanban"
                    records_draggable="1"
                    quick_create="false"
                    sample="1"
                    highlight_color="color">
                <field name="name"/>
                <field name="deadline"/>
                <field name="days_to_deadline"/>
                <field name="assignee_id"/>
                <field name="assignee_user_id"/>
                <field name="work_group_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="kanban_column"/>
                <field name="completion_percent"/>
                <field name="color"/>
                <field name="is_overdue"/>
                <field name="activity_ids"/>
                <templates>
                    <t t-name="card">
                        <main t-att-class="'o_daily_kcard o_daily_kcard_' + (record.kanban_column.raw_value or 'not_started')">
                            <div class="o_daily_kcard_top">
                                <div class="o_daily_kcard_title_wrap">
                                    <i t-if="record.kanban_column.raw_value == 'done'"
                                       class="fa fa-check-circle o_daily_kcard_done_ico"/>
                                    <field name="name" class="o_daily_kcard_title"/>
                                </div>
                                <field name="priority" widget="badge"
                                         decoration-danger="priority == 'high'"
                                         decoration-warning="priority == 'medium'"
                                         decoration-info="priority == 'low'"/>
                            </div>

                            <div class="o_daily_kcard_meta">
                                <div class="o_daily_kcard_line">
                                    <i class="fa fa-calendar o_daily_kcard_ico_cal"/>
                                    <field name="deadline"/>
                                </div>
                                <div t-if="record.work_group_id.raw_value" class="o_daily_kcard_line">
                                    <i class="fa fa-folder o_daily_kcard_ico_folder"/>
                                    <field name="work_group_id"/>
                                </div>
                            </div>

                            <div t-if="record.kanban_column.raw_value == 'in_progress'"
                                 class="o_daily_kcard_progress">
                                <div class="o_daily_kcard_progress_label">
                                    <t t-esc="record.completion_percent.value or 0"/>%
                                </div>
                                <div class="o_daily_kcard_progress_track">
                                    <div class="o_daily_kcard_progress_bar"
                                         t-attf-style="width: #{record.completion_percent.raw_value or 0}%"/>
                                </div>
                            </div>

                            <div t-if="record.kanban_column.raw_value == 'upcoming'"
                                 class="o_daily_kcard_countdown">
                                <t t-if="record.days_to_deadline.raw_value == 0">Còn hôm nay</t>
                                <t t-elif="record.days_to_deadline.raw_value == 1">Còn 1 ngày</t>
                                <t t-else="">Còn <t t-esc="record.days_to_deadline.value"/> ngày</t>
                            </div>

                            <div t-if="record.kanban_column.raw_value == 'overdue'"
                                 class="o_daily_kcard_overdue_tag">
                                Quá hạn
                            </div>

                            <footer class="o_daily_kcard_foot">
                                <div class="o_daily_kcard_assignee">
                                    <field name="assignee_user_id" widget="many2one_avatar_user"/>
                                    <field name="assignee_id"/>
                                </div>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar -->
    <record id="view_daily_task_calendar" model="ir.ui.view">
        <field name="name">daily.task.calendar</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <calendar string="Calendar To Do List" date_start="deadline" color="color"
                      mode="month" quick_create="0" event_open_popup="1">
                <field name="name"/>
                <field name="assignee_id"/>
                <field name="priority"/>
                <field name="state" filters="1"/>
                <field name="department_id"/>
                <field name="color"/>
            </calendar>
        </field>
    </record>

    <!-- Search -->
    <record id="view_daily_task_search" model="ir.ui.view">
        <field name="name">daily.task.search</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="assignee_id"/>
                <field name="department_id"/>
                <filter string="Hoàn thành" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Đang xử lý" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Chưa bắt đầu" name="filter_not_started" domain="[('state', '=', 'not_started')]"/>
                <separator/>
                <filter string="Quá hạn" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Ưu tiên cao" name="filter_high" domain="[('priority', '=', 'high')]"/>
                <group>
                    <filter string="Cột Kanban" name="group_kanban_column" context="{'group_by': 'kanban_column'}"/>
                    <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Người phụ trách" name="group_assignee" context="{'group_by': 'assignee_id'}"/>
                    <filter string="Bộ phận" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Ưu tiên" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Hạn" name="group_deadline" context="{'group_by': 'deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions: Kanban ưu tiên (Odoo 19 dùng list thay cho tree) -->
    <record id="action_daily_task" model="ir.actions.act_window">
        <field name="name">Quản lý dữ liệu công việc</field>
        <field name="res_model">daily.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="view_id" ref="view_daily_task_kanban"/>
        <field name="search_view_id" ref="view_daily_task_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm công việc mới</p>
            <p>Kéo thả thẻ giữa các cột trạng thái: Chưa bắt đầu → Đang xử lý → Đã hoàn thành.</p>
        </field>
    </record>

    <record id="action_daily_task_kanban" model="ir.actions.act_window">
        <field name="name">Kanban công việc</field>
        <field name="res_model">daily.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_daily_task_kanban"/>
        <field name="search_view_id" ref="view_daily_task_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có công việc</p>
            <p>Xem và kéo thả theo cột: Quá hạn · Chưa bắt đầu · Đang xử lý · Đã hoàn thành.</p>
        </field>
    </record>

    <!-- Giao việc dùng OWL client action_daily_work_assign (xem daily_task_dashboard_views.xml) -->

    <record id="action_daily_task_employee_workspace" model="ir.actions.act_window">
        <field name="name">Nhân viên nhập CV</field>
        <field name="res_model">daily.task</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_assignee': 1}</field>
        <field name="help" type="html">
            <p>Chọn / lọc theo người phụ trách để xem việc được giao.</p>
        </field>
    </record>

    <record id="action_daily_task_calendar" model="ir.actions.act_window">
        <field name="name">Calendar To Do List</field>
        <field name="res_model">daily.task</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <record id="action_daily_task_overdue" model="ir.actions.act_window">
        <field name="name">Công việc quá hạn</field>
        <field name="res_model">daily.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_daily_task_kanban"/>
        <field name="search_view_id" ref="view_daily_task_search"/>
        <field name="domain">[('is_overdue', '=', True)]</field>
        <field name="context">{'search_default_filter_overdue': 1}</field>
    </record>
</odoo>
