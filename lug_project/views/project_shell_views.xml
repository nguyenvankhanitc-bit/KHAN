<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Free path du-an from act_window first (path must be unique). -->
    <record id="action_lug_project_main" model="ir.actions.act_window">
        <field name="name">Dự án (danh sách)</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_template', '=', False)]</field>
        <field name="context">{'display_milestone_deadline': True}</field>
        <field name="path">du-an-list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có dự án</p>
        </field>
    </record>

    <!-- Primary entry — same as workspace: /odoo/du-an = OWL shell + left sidebar. -->
    <record id="action_lug_project_shell" model="ir.actions.client">
        <field name="name">Dự án</field>
        <field name="tag">lug_project_shell</field>
        <field name="path">du-an</field>
        <field name="target">current</field>
    </record>
</odoo>
