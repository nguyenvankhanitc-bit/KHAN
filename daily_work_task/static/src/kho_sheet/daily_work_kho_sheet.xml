<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkKhoSheet">
        <div class="o_daily_work_dashboard o_daily_work_kho_sheet o_action">
            <DailyWorkAppShell t-props="{ activeNav: shellActiveNav }">
                <div class="o_dks">
                    <!-- Đầu báo cáo (giống Báo cáo cá nhân): tiêu đề giữa · bộ lọc + nút bên phải -->
                    <div class="o_dks_head">
                        <div class="o_dks_head_side"/>
                        <div class="o_dks_head_center">
                            <h2 class="o_dks_head_title">BÁO CÁO CÔNG VIỆC KHO</h2>
                            <div class="o_dks_head_line">Họ và tên: <b t-esc="state.me"/></div>
                            <div t-if="meSub" class="o_dks_head_sub" t-esc="meSub"/>
                            <div class="o_dks_head_line" t-esc="'Tháng ' + state.month + ' Năm ' + state.year"/>
                        </div>
                        <div class="o_dks_toolbar">
                            <select class="form-select form-select-sm" t-on-change="(ev) => this.onPeriod('month', ev)">
                                <t t-foreach="monthNums" t-as="m" t-key="m">
                                    <option t-att-value="m" t-att-selected="m === state.month" t-esc="'Tháng ' + m"/>
                                </t>
                            </select>
                            <select class="form-select form-select-sm" t-on-change="(ev) => this.onPeriod('year', ev)">
                                <t t-foreach="yearNums" t-as="y" t-key="y">
                                    <option t-att-value="y" t-att-selected="y === state.year" t-esc="y"/>
                                </t>
                            </select>
                            <select t-if="state.teams.length &gt; 1" class="form-select form-select-sm" t-on-change="onTeam">
                                <t t-foreach="state.teams" t-as="tm" t-key="tm.id">
                                    <option t-att-value="tm.id" t-att-selected="tm.id === state.teamId" t-esc="'Team: ' + tm.name"/>
                                </t>
                            </select>
                            <button type="button" class="btn btn-light btn-sm o_dks_refresh" t-on-click="onRefresh">
                                <i class="fa fa-refresh"/> Làm mới
                            </button>
                            <button t-if="state.canExport" type="button" class="btn btn-success btn-sm"
                                    t-att-disabled="state.exporting or state.loading"
                                    title="Xuất Excel khổ A4 ngang (theo tháng / tuần đang lọc)"
                                    t-on-click="onExport">
                                <i class="fa fa-file-excel-o"/> <t t-esc="state.exporting ? 'Đang xuất...' : 'Xuất Excel'"/>
                            </button>
                        </div>
                    </div>

                    <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-spinner fa-spin fa-2x"/></div>
                    <div t-elif="state.message" class="alert alert-warning m-0" t-esc="state.message"/>
                    <t t-else="">
                        <!-- Chỉ số -->
                        <div class="o_dks_kpis">
                            <div class="o_dks_kpi">
                                <span class="o_dks_kpi_ico is-blue"><i class="fa fa-clipboard"/></span>
                                <div><div class="o_dks_kpi_lbl">TỔNG CÔNG VIỆC</div><div class="o_dks_kpi_val" t-esc="kpi.total"/></div>
                            </div>
                            <div class="o_dks_kpi">
                                <span class="o_dks_kpi_ico is-green"><i class="fa fa-check"/></span>
                                <div>
                                    <div class="o_dks_kpi_lbl is-green">HOÀN THÀNH</div>
                                    <div class="o_dks_kpi_val"><t t-esc="kpi.done"/> <small t-esc="'(' + kpi.donePct + '%)'"/></div>
                                </div>
                            </div>
                            <div class="o_dks_kpi">
                                <span class="o_dks_kpi_ico is-amber"><i class="fa fa-clock-o"/></span>
                                <div>
                                    <div class="o_dks_kpi_lbl is-amber">ĐANG THỰC HIỆN</div>
                                    <div class="o_dks_kpi_val"><t t-esc="kpi.doing"/> <small t-esc="'(' + kpi.doingPct + '%)'"/></div>
                                </div>
                            </div>
                            <div class="o_dks_kpi">
                                <span class="o_dks_kpi_ico is-gray"><i class="fa fa-pause"/></span>
                                <div>
                                    <div class="o_dks_kpi_lbl">CHƯA BẮT ĐẦU</div>
                                    <div class="o_dks_kpi_val"><t t-esc="kpi.todo"/> <small t-esc="'(' + kpi.todoPct + '%)'"/></div>
                                </div>
                            </div>
                            <div class="o_dks_kpi">
                                <span class="o_dks_kpi_ico is-violet"><i class="fa fa-clock-o"/></span>
                                <div><div class="o_dks_kpi_lbl is-violet">TỔNG THỜI GIAN (giờ)</div><div class="o_dks_kpi_val" t-esc="kpi.hours"/></div>
                            </div>
                            <div class="o_dks_kpi">
                                <span class="o_dks_kpi_ico is-teal"><i class="fa fa-line-chart"/></span>
                                <div>
                                    <div class="o_dks_kpi_lbl is-teal">HIỆU SUẤT</div>
                                    <div class="o_dks_kpi_val" t-esc="kpi.efficiency + '%'"/>
                                    <div class="o_dks_kpi_sub">Theo QL đánh giá</div>
                                </div>
                            </div>
                        </div>

                        <!-- Tuần -->
                        <div class="o_dks_weeks">
                            <div t-foreach="weeks" t-as="w" t-key="w.no"
                                 t-att-class="'o_dks_week' + (state.weekNo === w.no ? ' is-active' : '')"
                                 role="button" t-att-title="state.weekNo === w.no ? 'Bấm để xem cả tháng' : 'Lọc công việc Tuần ' + w.no"
                                 t-on-click="() => this.onWeek(w.no)">
                                <i class="fa fa-calendar o_dks_week_cal"/>
                                <span class="o_dks_week_no" t-esc="w.no"/>
                                <div>
                                    <b t-esc="'TUẦN ' + w.no"/>
                                    <div t-esc="w.label"/>
                                    <small t-esc="'(' + w.days + ' ngày)'"/>
                                </div>
                            </div>
                        </div>

                        <!-- Biểu đồ (giống hình mẫu): 1. Tổng công việc · 2. Kết quả đánh giá QL -->
                        <div class="o_dks_charts">
                            <div class="o_dks_chart_card">
                                <div class="o_dks_chart_title"><i class="fa fa-bar-chart"/> 1. TỔNG CÔNG VIỆC</div>
                                <div class="o_dks_donut">
                                    <canvas t-ref="stateChart"/>
                                    <div class="o_dks_donut_center">
                                        <b t-esc="stateStats.total"/>
                                        <small>TỔNG CÔNG VIỆC</small>
                                    </div>
                                </div>
                                <div class="o_dks_legend">
                                    <div t-foreach="stateLegend" t-as="l" t-key="l.key" class="o_dks_legend_item">
                                        <span class="o_dks_dot" t-att-style="'background:' + l.color"/>
                                        <div>
                                            <div t-esc="l.label"/>
                                            <small><b t-esc="l.count"/> (<t t-esc="fmtPct(l.pct)"/>)</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="o_dks_chart_card">
                                <div class="o_dks_chart_title"><i class="fa fa-bullseye"/> 2. KẾT QUẢ ĐÁNH GIÁ QUẢN LÝ CÔNG VIỆC</div>
                                <div class="o_dks_eval_body">
                                    <div class="o_dks_donut">
                                        <canvas t-ref="rateChart"/>
                                        <div class="o_dks_donut_center">
                                            <b t-esc="rateStats.rated"/>
                                            <small>ĐÃ ĐƯỢC ĐÁNH GIÁ</small>
                                        </div>
                                    </div>
                                    <div class="o_dks_rate_side">
                                        <table class="o_dks_rate_table">
                                            <thead>
                                                <tr><th>XẾP LOẠI</th><th>SỐ CÔNG VIỆC</th><th>TỶ LỆ</th></tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="rateRows" t-as="rr" t-key="rr.key">
                                                    <td><span t-att-class="'o_dks_dot is-' + rr.key"/> <t t-esc="rr.label"/></td>
                                                    <td t-esc="rr.count"/>
                                                    <td t-esc="fmtPct(rr.pct)"/>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <div class="o_dks_rate_info">
                                            <i class="fa fa-info-circle"/>
                                            <t t-esc="rateStats.unrated"/> công việc chưa được đánh giá
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Nút -->
                        <div class="o_dks_actions">
                            <span class="o_dks_team" t-if="state.teamName">Team: <b t-esc="state.teamName"/></span>
                            <span t-if="state.weekNo" class="o_dks_week_filter">
                                <i class="fa fa-filter"/> Đang lọc: <b t-esc="'Tuần ' + state.weekNo"/>
                                <button type="button" class="btn btn-link p-0" title="Bỏ lọc tuần" t-on-click="() => this.onWeek(state.weekNo)">
                                    <i class="fa fa-times"/>
                                </button>
                            </span>
                            <span class="o_dks_spacer"/>
                            <t t-if="state.canWrite">
                                <button t-if="!state.editing" type="button" class="btn btn-sm btn-outline-primary" t-on-click="onEdit">
                                    <i class="fa fa-pencil"/> Chỉnh sửa
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" t-on-click="onAdd">
                                    <i class="fa fa-plus"/> Thêm công việc
                                </button>
                                <t t-if="state.editing">
                                    <button type="button" class="btn btn-sm btn-light" t-att-disabled="state.saving" t-on-click="onCancel">
                                        <i class="fa fa-times"/> Hủy
                                    </button>
                                    <button type="button" class="btn btn-sm btn-success" t-att-disabled="state.saving" t-on-click="onSave">
                                        <i class="fa fa-save"/> <t t-esc="state.saving ? 'Đang lưu...' : 'Lưu'"/>
                                    </button>
                                </t>
                            </t>
                        </div>

                        <!-- Bảng -->
                        <div class="o_dks_table_wrap">
                            <table t-att-class="'o_dks_table' + (state.editing ? ' is-editing' : '')">
                                <thead>
                                    <tr>
                                        <th rowspan="2" class="c-stt">STT</th>
                                        <th rowspan="2" class="c-week">Tuần</th>
                                        <th rowspan="2" class="c-name">Nội dung công việc</th>
                                        <th rowspan="2" class="c-date2">Ngày bắt đầu</th>
                                        <th rowspan="2" class="c-date2">Deadline</th>
                                        <th rowspan="2" class="c-hours">Tổng TG (giờ)</th>
                                        <th rowspan="2" class="c-state">Trạng thái</th>
                                        <th rowspan="2" class="c-person">Kiểm soát</th>
                                        <th rowspan="2" class="c-note">Ghi chú</th>
                                        <th colspan="6" class="o_dks_th_eval_group">QUẢN LÝ ĐÁNH GIÁ</th>
                                        <th t-if="state.editing" rowspan="2" class="c-del"/>
                                    </tr>
                                    <tr class="o_dks_th_eval_row">
                                        <th class="o_dks_th_eval c-eval-pct">% Hoàn thành</th>
                                        <th class="o_dks_th_eval c-eval-note">Ghi chú</th>
                                        <th class="o_dks_th_eval c-eval-rate is-pass">Đạt</th>
                                        <th class="o_dks_th_eval c-eval-rate is-average">Trung bình</th>
                                        <th class="o_dks_th_eval c-eval-rate is-fail">Không đạt</th>
                                        <th class="o_dks_th_eval c-eval-confirm">Xác nhận QL</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="groups" t-as="g" t-key="g.key">
                                        <!-- Hạng mục (group giống Danh sách công việc) -->
                                        <tr class="o_dks_group" t-on-click="() => this.toggleGroup(g)">
                                            <td t-att-colspan="colCount">
                                                <i t-att-class="'fa o_dks_group_caret ' + (isGroupOpen(g) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                                <i class="fa fa-folder-o o_dks_group_icon"/>
                                                <b t-esc="g.label"/>
                                                <span class="o_dks_group_meta">
                                                    <t t-esc="g.count"/> việc · <t t-esc="g.hours"/> giờ · % Hoàn thành CV TB hạng mục (AVERAGE): <b t-esc="g.avg + '%'"/>
                                                </span>
                                            </td>
                                        </tr>
                                        <t t-if="isGroupOpen(g)">
                                        <tr t-foreach="g.rows" t-as="r" t-key="r.key">
                                            <td class="text-center" t-esc="r_index + 1"/>
                                            <td class="text-center o_dks_day" t-esc="weekOf(r.date)"/>
                                            <!-- Chế độ xem -->
                                            <t t-if="!state.editing">
                                                <td>
                                                    <i t-if="r.linked" class="fa fa-link o_dks_link" title="Từ Phân công việc team"/>
                                                    <t t-esc="r.name"/>
                                                    <small t-if="state.wholeTeam and r.responsible" class="o_dks_who"><i class="fa fa-user-o"/> <t t-esc="r.responsible"/></small>
                                                </td>
                                                <td class="text-center" t-esc="dayLabel(r.date_start) || '—'"/>
                                                <td class="text-center" t-esc="fmt(r.deadline) || '—'"/>
                                                <td class="text-center" t-esc="hoursOf(r)"/>
                                                <td class="text-center">
                                                    <span t-att-class="'o_dks_state is-' + r.state">
                                                        <i t-att-class="'fa ' + stateIcon(r.state)"/> <t t-esc="stateLabel(r.state)"/>
                                                    </span>
                                                </td>
                                                <td t-esc="r.controller"/>
                                                <td t-esc="r.note"/>
                                                <!-- QUẢN LÝ ĐÁNH GIÁ (từ Kiểm tra CV) — chỉ xem -->
                                                <td class="o_dks_eval text-center">
                                                    <t t-if="r.eval and r.eval.percent !== null and r.eval.percent !== undefined" t-esc="r.eval.percent + '%'"/>
                                                </td>
                                                <td class="o_dks_eval o_dks_eval_note" t-esc="r.eval and r.eval.note or ''"/>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.rating === 'pass'" class="fa fa-check-square o_dks_rate is-pass" title="Đạt"/>
                                                </td>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.rating === 'average'" class="fa fa-check-square o_dks_rate is-average" title="Trung bình"/>
                                                </td>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.rating === 'fail'" class="fa fa-check-square o_dks_rate is-fail" title="Không đạt"/>
                                                </td>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.confirmed" class="fa fa-check-circle o_dks_rate is-pass" title="Quản lý đã xác nhận"/>
                                                </td>
                                            </t>
                                            <!-- Chế độ nhập tay -->
                                            <t t-else="">
                                                <t t-if="r.linked">
                                                    <!-- Dòng từ Phân công việc team: chỉ nhập Ghi chú (ngày / TG theo công việc đã phân) -->
                                                    <td class="o_dks_locked" title="Từ Phân công việc team — sửa bên trang phân công">
                                                        <i class="fa fa-link o_dks_link"/> <t t-esc="r.name"/>
                                                        <small t-if="state.wholeTeam and r.responsible" class="o_dks_who"><i class="fa fa-user-o"/> <t t-esc="r.responsible"/></small>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                <td class="o_dks_name_edit">
                                                    <select class="form-select form-select-sm" title="Hạng mục" t-on-change="(ev) => this.onField(r, 'work_group_id', ev)">
                                                        <option value="" t-att-selected="!r.work_group_id">— Chọn hạng mục —</option>
                                                        <t t-foreach="categoryOptions(r)" t-as="c" t-key="c.id">
                                                            <option t-att-value="c.id" t-att-selected="c.id === r.work_group_id" t-esc="c.name"/>
                                                        </t>
                                                    </select>
                                                    <input type="text" class="form-control form-control-sm" placeholder="Nội dung công việc..."
                                                           t-att-value="r.name" t-on-change="(ev) => this.onField(r, 'name', ev)"/>
                                                    <input t-if="state.wholeTeam" type="text" class="form-control form-control-sm" list="o_dks_people"
                                                           placeholder="Người phụ trách" title="Người phụ trách"
                                                           t-att-value="r.responsible" t-on-change="(ev) => this.onField(r, 'responsible', ev)"/>
                                                </td>
                                                </t>
                                                <td t-if="r.linked" class="text-center o_dks_locked" t-esc="dayLabel(r.date_start) || '—'"/>
                                                <td t-else="">
                                                    <div class="o_dks_date">
                                                        <input type="text" class="form-control form-control-sm" placeholder="dd/mm/yyyy"
                                                               t-att-value="fmt(r.date_start)" t-on-change="(ev) => this.onDateText(r, ev, 'date_start')"/>
                                                        <button type="button" class="btn btn-link p-0 o_dks_date_btn" title="Chọn ngày"
                                                                t-on-click="(ev) => this.openPicker(ev)"><i class="fa fa-calendar"/></button>
                                                        <input type="date" class="o_dks_date_picker" tabindex="-1" t-att-value="r.date_start"
                                                               t-on-change="(ev) => this.ondate_startield(r, 'date_start', ev)"/>
                                                    </div>
                                                </td>
                                                <td t-if="r.linked" class="text-center o_dks_locked" t-esc="fmt(r.deadline) || '—'"/>
                                                <td t-else="">
                                                    <div class="o_dks_date">
                                                        <input type="text" class="form-control form-control-sm" placeholder="dd/mm/yyyy"
                                                               t-att-value="fmt(r.deadline)" t-on-change="(ev) => this.onDateText(r, ev, 'deadline')"/>
                                                        <button type="button" class="btn btn-link p-0 o_dks_date_btn" title="Chọn ngày"
                                                                t-on-click="(ev) => this.openPicker(ev)"><i class="fa fa-calendar"/></button>
                                                        <input type="date" class="o_dks_date_picker" tabindex="-1" t-att-value="r.deadline"
                                                               t-on-change="(ev) => this.ondeadlineield(r, 'deadline', ev)"/>
                                                    </div>
                                                </td>
                                                <td t-if="r.linked" class="text-center o_dks_hours o_dks_locked" title="Theo Tổng TG ở Danh sách công việc" t-esc="hoursOf(r)"/>
                                                <td t-else=""><input type="number" min="0" step="0.5" class="form-control form-control-sm text-center"
                                                           t-att-value="r.hours" t-on-change="(ev) => this.onField(r, 'hours', ev)"/></td>
                                                <td t-if="r.linked" class="text-center o_dks_locked">
                                                    <span t-att-class="'o_dks_state is-' + r.state">
                                                        <i t-att-class="'fa ' + stateIcon(r.state)"/> <t t-esc="stateLabel(r.state)"/>
                                                    </span>
                                                </td>
                                                <td t-else="">
                                                    <select t-att-class="'form-select form-select-sm o_dks_state_sel is-' + r.state" t-on-change="(ev) => this.onField(r, 'state', ev)">
                                                        <t t-foreach="state.states" t-as="s" t-key="s.key">
                                                            <option t-att-value="s.key" t-att-selected="s.key === r.state" t-esc="s.label"/>
                                                        </t>
                                                    </select>
                                                </td>
                                                <td t-if="r.linked" class="o_dks_locked" t-esc="r.controller"/>
                                                <td t-else=""><input type="text" class="form-control form-control-sm" list="o_dks_people"
                                                           t-att-value="r.controller" t-on-change="(ev) => this.onField(r, 'controller', ev)"/></td>
                                                <td><input type="text" class="form-control form-control-sm"
                                                           t-att-value="r.note" t-on-change="(ev) => this.onField(r, 'note', ev)"/></td>
                                                <!-- QUẢN LÝ ĐÁNH GIÁ (từ Kiểm tra CV) — chỉ xem -->
                                                <td class="o_dks_eval text-center">
                                                    <t t-if="r.eval and r.eval.percent !== null and r.eval.percent !== undefined" t-esc="r.eval.percent + '%'"/>
                                                </td>
                                                <td class="o_dks_eval o_dks_eval_note" t-esc="r.eval and r.eval.note or ''"/>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.rating === 'pass'" class="fa fa-check-square o_dks_rate is-pass" title="Đạt"/>
                                                </td>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.rating === 'average'" class="fa fa-check-square o_dks_rate is-average" title="Trung bình"/>
                                                </td>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.rating === 'fail'" class="fa fa-check-square o_dks_rate is-fail" title="Không đạt"/>
                                                </td>
                                                <td class="o_dks_eval text-center">
                                                    <i t-if="r.eval and r.eval.confirmed" class="fa fa-check-circle o_dks_rate is-pass" title="Quản lý đã xác nhận"/>
                                                </td>
                                                <td class="text-center">
                                                    <button t-if="!r.linked" type="button" class="btn btn-link text-danger p-0" title="Xoá dòng"
                                                            t-on-click="() => this.onRemove(r)"><i class="fa fa-trash"/></button>
                                                </td>
                                            </t>
                                        </tr>
                                        </t>
                                    </t>
                                    <tr t-if="groups.length" class="o_dks_group_total">
                                        <td t-att-colspan="colCount">
                                            Tổng % hoàn thành công việc trong tháng (AVERAGE các hạng mục): <b t-esc="groupsAvg + '%'"/>
                                        </td>
                                    </tr>
                                    <tr t-if="!visibleRows.length">
                                        <td t-att-colspan="colCount" class="text-center text-muted py-4">
                                            Chưa có công việc. <t t-if="state.canWrite">Bấm «Thêm công việc» để nhập.</t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <datalist id="o_dks_people">
                                <t t-foreach="state.people" t-as="p" t-key="p"><option t-att-value="p"/></t>
                            </datalist>
                        </div>
                    </t>
                </div>
                <!-- Danh sách giờ (mốc 30 phút) — chọn nhanh, vẫn gõ tay được trong ô -->
                <ul t-if="state.timePick" class="o_dks_time_list" t-att-style="timeListStyle" role="listbox">
                    <t t-foreach="timeSlots" t-as="slot" t-key="slot">
                        <li t-att-class="(slot === timePickValue ? 'is-active ' : '') + (slot === timePickNear ? 'is-near' : '')"
                            role="option"
                            t-on-mousedown.prevent="() => this.pickTime(slot)"
                            t-esc="slot"/>
                    </t>
                </ul>
            </DailyWorkAppShell>
        </div>
    </t>
</templates>
