<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_eam_stock_issue" model="ir.actions.report">
        <field name="name">PHIẾU XUẤT KHO</field>
        <field name="model">eam.transaction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lug_eam.report_eam_stock_issue</field>
        <field name="report_file">lug_eam.report_eam_stock_issue</field>
        <field name="print_report_name">'Phieu_PX_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_eam_transaction"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_eam_stock_issue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: 'Times New Roman', Times, serif; font-size: 12px; color: #000;">
                    <table style="width:100%; margin-bottom: 8px;">
                        <tr>
                            <td style="width:40%; vertical-align:top;">
                                <div style="font-weight:bold; text-transform:uppercase;" t-esc="doc.company_id.name"/>
                                <div t-if="doc.company_id.partner_id.contact_address"
                                     t-esc="doc.company_id.partner_id.contact_address"
                                     style="white-space:pre-line; font-size:11px;"/>
                                <div t-if="doc.company_id.phone" style="font-size:11px;">
                                    Tel: <t t-esc="doc.company_id.phone"/>
                                </div>
                            </td>
                            <td style="width:25%; vertical-align:top; font-size:11px;">
                                <div>Nợ: <t t-esc="doc.debit_account or ''"/>
                                    <span style="float:right;"
                                          t-esc="'{:,.0f}'.format(doc.debit_amount or 0).replace(',', '.')"/>
                                </div>
                                <div>Có: <t t-esc="doc.credit_account or ''"/>
                                    <span style="float:right;"
                                          t-esc="'{:,.0f}'.format(doc.credit_amount or 0).replace(',', '.')"/>
                                </div>
                            </td>
                            <td style="width:35%; text-align:center; vertical-align:top;">
                                <div style="font-size:18px; font-weight:bold; letter-spacing:1px;">PHIẾU XUẤT KHO</div>
                                <div>Ngày: <span t-field="doc.date" t-options="{'widget': 'date'}"/></div>
                                <div>Mã CT: <t t-esc="doc.doc_type_code or 'PX'"/>
                                    &#160;&#160; Số CT: <t t-esc="doc.name"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="margin: 8px 0; line-height: 1.6;">
                        <div>- Xuất tại kho:
                            <span style="font-weight:bold;" t-if="doc.warehouse_id">
                                <t t-esc="doc.warehouse_id.name"/>
                                (<t t-esc="doc.warehouse_id.code"/>)
                            </span>
                            <span style="font-weight:bold;" t-else="" t-esc="doc.src_location_note or ''"/>
                        </div>
                        <div>- Nhập tại kho:
                            <span style="font-weight:bold;" t-if="doc.dest_warehouse_id">
                                <t t-esc="doc.dest_warehouse_id.name"/>
                                (<t t-esc="doc.dest_warehouse_id.code"/>)
                            </span>
                            <span style="font-weight:bold;" t-else="" t-esc="doc.dest_location_note or ''"/>
                        </div>
                        <div>- Họ tên người nhận hàng:
                            <span style="font-weight:bold;"
                                  t-esc="doc.receiver_name or (doc.owner_employee_id.name if doc.owner_employee_id else '')"/>
                            <span style="margin-left:24px;">Điện thoại:
                                <t t-esc="doc.receiver_phone or ''"/>
                            </span>
                        </div>
                        <div>- Lý do xuất kho:
                            <span t-esc="doc.reason or doc.content or ''"/>
                        </div>
                    </div>

                    <table style="width:100%; border-collapse:collapse; margin-top:8px;" border="1" cellpadding="4">
                        <thead>
                            <tr style="text-align:center; font-weight:bold; background:#f5f5f5;">
                                <th style="width:5%;">STT</th>
                                <th style="width:28%;">Mặt hàng</th>
                                <th style="width:14%;">Mã số</th>
                                <th style="width:8%;">Đvt</th>
                                <th style="width:12%;">Số lượng</th>
                                <th style="width:15%;">Đơn giá</th>
                                <th style="width:18%;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="idx" t-value="0"/>
                            <t t-set="sum_qty" t-value="0.0"/>
                            <t t-set="sum_amt" t-value="0.0"/>
                            <tr t-foreach="doc.line_ids" t-as="line">
                                <t t-set="idx" t-value="idx + 1"/>
                                <t t-set="qty" t-value="line.qty_received or line.qty_document or 1.0"/>
                                <t t-set="amt" t-value="line.subtotal or ((line.unit_cost or 0.0) * qty)"/>
                                <t t-set="sum_qty" t-value="sum_qty + qty"/>
                                <t t-set="sum_amt" t-value="sum_amt + amt"/>
                                <td style="text-align:center;" t-esc="idx"/>
                                <td t-esc="line.product_name or (line.asset_id.name if line.asset_id else '')"/>
                                <td style="text-align:center;"
                                    t-esc="line.product_code or (line.asset_id.asset_code if line.asset_id else '')"/>
                                <td style="text-align:center;" t-esc="line.uom_name or 'Cái'"/>
                                <td style="text-align:right;"
                                    t-esc="'{:,.0f}'.format(qty).replace(',', '.')"/>
                                <td style="text-align:right;"
                                    t-esc="'{:,.0f}'.format(line.unit_cost or 0).replace(',', '.')"/>
                                <td style="text-align:right;"
                                    t-esc="'{:,.0f}'.format(amt).replace(',', '.')"/>
                            </tr>
                            <tr style="font-weight:bold;">
                                <td colspan="4" style="text-align:center;">Tổng cộng</td>
                                <td style="text-align:right;"
                                    t-esc="'{:,.0f}'.format(doc.qty_total or sum_qty).replace(',', '.')"/>
                                <td></td>
                                <td style="text-align:right;"
                                    t-esc="'{:,.0f}'.format(doc.amount_grand or sum_amt).replace(',', '.')"/>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-top:10px;">
                        <div>- Tổng số tiền (Viết bằng chữ):
                            <span style="font-style:italic;" t-esc="doc.amount_in_words"/>
                        </div>
                        <div style="margin-top:4px;">- Số chứng từ gốc kèm theo:
                            <t t-esc="doc.attached_docs or ''"/>
                        </div>
                    </div>

                    <div style="text-align:right; margin-top:16px; font-size:11px;">
                        Ngày ...... tháng ...... năm ......
                    </div>

                    <table style="width:100%; margin-top:12px; text-align:center; font-size:11px;">
                        <tr>
                            <td style="width:20%;">
                                <div style="font-weight:bold;">Người lập phiếu</div>
                                <div>(Ký, họ tên)</div>
                                <div style="height:48px;"></div>
                                <div t-esc="doc.prepared_by_id.name or ''"/>
                            </td>
                            <td style="width:20%;">
                                <div style="font-weight:bold;">Người nhận hàng</div>
                                <div>(Ký, họ tên)</div>
                                <div style="height:48px;"></div>
                                <div t-esc="doc.receiver_name or (doc.receiver_id.name if doc.receiver_id else '')"/>
                            </td>
                            <td style="width:20%;">
                                <div style="font-weight:bold;">Thủ kho</div>
                                <div>(Ký, họ tên)</div>
                                <div style="height:48px;"></div>
                                <div t-esc="doc.warehouse_keeper_id.name or ''"/>
                            </td>
                            <td style="width:20%;">
                                <div style="font-weight:bold;">Người giao hàng</div>
                                <div>(Ký, họ tên)</div>
                                <div style="height:48px;"></div>
                                <div t-esc="doc.deliverer_name or ''"/>
                            </td>
                            <td style="width:20%;">
                                <div style="font-weight:bold;">Người kiểm soát</div>
                                <div>(Ký, họ tên)</div>
                                <div style="height:48px;"></div>
                                <div t-esc="doc.controller_id.name or ''"/>
                            </td>
                        </tr>
                    </table>

                    <div style="margin-top:24px; font-size:10px; border-top:1px solid #ccc; padding-top:4px;">
                        <span t-esc="doc.doc_type_code or 'PX'"/> |
                        <span t-esc="doc.name"/> |
                        <span t-field="doc.date" t-options="{'widget': 'date'}"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
