<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phiếu theo loại checklist: mở từ sidebar NVBH / ASM / GS -->
    <record id="action_store_audit_nvbh" model="ir.actions.act_window">
        <field name="name">Checklist NVBH</field>
        <field name="res_model">store.audit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('audit_type', '=', 'nvbh')]</field>
        <field name="context">{'store_audit_type': 'nvbh', 'search_default_group_store': 1}</field>
    </record>
    <record id="action_store_audit_asm" model="ir.actions.act_window">
        <field name="name">Checklist ASM</field>
        <field name="res_model">store.audit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('audit_type', '=', 'asm')]</field>
        <field name="context">{'store_audit_type': 'asm', 'search_default_group_store': 1}</field>
    </record>
    <record id="action_store_audit_gs" model="ir.actions.act_window">
        <field name="name">Checklist GS</field>
        <field name="res_model">store.audit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('audit_type', '=', 'gs')]</field>
        <field name="context">{'store_audit_type': 'gs', 'search_default_group_store': 1}</field>
    </record>

    <!-- Xử lý sai phạm: cửa hàng đã có biên bản do giám sát kiểm tra -->
    <record id="view_store_audit_list_violation" model="ir.ui.view">
        <field name="name">store.audit.list.violation</field>
        <field name="model">store.audit</field>
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" group_edit="0" group_delete="0" string="Cửa hàng sai phạm" class="o_store_audit_list o_store_viol_stores">
                <field name="name" string="Mã phiếu" width="190px"/>
                <field name="audit_date" options="{'numeric': true}"/>
                <field name="store_id" string="Cửa hàng" width="130px"/>
                <field name="auditor_id"/>
                <field name="error_count" string="Tổng số lỗi" width="140px" class="text-danger fw-bold"/>
                <button name="action_open_violation_popup" type="object" icon="fa-wrench" string="Xử lý sai phạm" class="btn btn-link o_store_violation_btn"/>
            </list>
        </field>
    </record>

    <record id="action_store_violation_stores" model="ir.actions.act_window">
        <field name="name">Cửa hàng sai phạm</field>
        <field name="res_model">store.audit</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_store_audit_list_violation"/>
        <field name="domain">[('state', '!=', 'draft'), ('error_count', '>', 0)]</field>
        <field name="context">{'search_default_group_store': 1}</field>
    </record>

    <!-- Danh sách xử lý sai phạm: tổng thể mọi dòng lỗi của các biên bản giám sát + 6 cột xử lý -->
    <record id="view_store_audit_action_violation_all" model="ir.ui.view">
        <field name="name">store.audit.action.violation.all</field>
        <field name="model">store.audit.action</field>
        <field name="arch" type="xml">
            <list js_class="store_violation_readonly" create="0" delete="0" edit="0" string="Danh sách xử lý sai phạm" class="o_store_audit_list o_store_viol_all" default_group_by="store_id">
                <field name="line_sequence" string="STT" width="55px"/>
                <field name="line_id" string="Tiêu chuẩn, yêu cầu" width="200px"/>
                <field name="line_requirement" string="Quy định cơ bản" width="280px"/>
                <field name="line_max_score" string="Điểm chuẩn" width="80px" options="{'hide_trailing_zeros': true}"/>
                <field name="line_actual_score" string="Điểm đánh giá" width="90px" options="{'hide_trailing_zeros': true}"/>
                <field name="issue" string="Chi tiết lỗi" width="200px"/>
                <field name="line_attachment_ids" widget="store_photo" string="Hình ảnh" width="130px"/>
                <field name="score_deduct" width="80px" options="{'hide_trailing_zeros': true}"/>
                <field name="responsible_ids" widget="many2many_tags" width="150px"/>
                <field name="action_plan" string="Nội dung khắc phục" width="200px"/>
                <field name="date_done" width="110px" options="{'numeric': true}"/>
                <field name="state" string="Trạng thái xử lý" width="110px"
                       decoration-warning="state == 'doing'" decoration-success="state == 'done'" decoration-muted="state == 'todo'"/>
                <field name="reviewer_ids" widget="many2many_tags" width="130px"/>
                <field name="control_done" width="110px"/>
            </list>
        </field>
    </record>

    <record id="action_store_violation_all" model="ir.actions.act_window">
        <field name="name">Danh sách xử lý sai phạm</field>
        <field name="res_model">store.audit.action</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_store_audit_action_violation_all"/>
        <field name="domain">[('line_id.error_count', '>', 0), ('audit_id.state', '!=', 'draft')]</field>
        <field name="context">{'sync_violations': True}</field>
    </record>

    <!-- Báo cáo GS: các cửa hàng đã được kiểm tra (phiếu giám sát không còn ở trạng thái nháp) -->
    <record id="action_store_report_gs" model="ir.actions.act_window">
        <field name="name">Báo cáo GS</field>
        <field name="res_model">store.audit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('audit_type', '=', 'gs'), ('state', '!=', 'draft')]</field>
        <field name="context">{'store_audit_type': 'gs', 'search_default_group_store': 1}</field>
    </record>

    <!-- Điểm chuẩn: STT - Nhóm tiêu chí - Tiêu chí đánh giá - Yêu cầu / Tiêu chuẩn - Điểm chuẩn -->
    <record id="view_store_benchmark_list" model="ir.ui.view">
        <field name="name">store.audit.template.line.benchmark.list</field>
        <field name="model">store.audit.template.line</field>
        <field name="arch" type="xml">
            <list group_edit="0" group_delete="0" string="Điểm chuẩn" class="o_store_benchmark" default_order="template_id, sequence, id">
                <field name="sequence" string="STT" width="60px"/>
                <field name="category" width="150px"/>
                <field name="sub_group_id" width="170px"/>
                <field name="name" width="220px"/>
                <field name="requirement" width="700px"/>
                <field name="responsible_ids" widget="many2many_tags" width="160px"/>
                <field name="controller_ids" widget="many2many_tags" width="150px"/>
                <field name="lug_group_ids" widget="many2many_tags" width="140px"/>
                <field name="max_score" sum="Tổng" options="{'hide_trailing_zeros': true}"/>
                <button name="action_open_popup" type="object" icon="fa-pencil" title="Chỉnh sửa"/>
                <button name="unlink" type="object" icon="fa-trash" title="Xóa" class="text-danger"
                        confirm="Xóa hạng mục này?"/>
            </list>
        </field>
    </record>

    <record id="view_store_benchmark_form" model="ir.ui.view">
        <field name="name">store.audit.template.line.benchmark.form</field>
        <field name="model">store.audit.template.line</field>
        <field name="arch" type="xml">
            <form string="Điểm chuẩn" class="o_store_benchmark_form">
                <sheet>
                    <group>
                        <group>
                            <field name="template_id" string="Loại checklist"/>
                            <field name="category"/>
                            <field name="sub_group_id" options="{'no_create': true}" domain="category and [('category', '=', category), ('audit_type', '=', audit_type)] or [('audit_type', '=', audit_type)]"/>
                            <field name="audit_type" invisible="1"/>
                        </group>
                        <group>
                            <field name="sequence" string="STT"/>
                            <field name="max_score" options="{'hide_trailing_zeros': true}"/>
                            <field name="responsible_ids" widget="many2many_tags" options="{'no_create': true}"/>
                            <field name="controller_ids" widget="many2many_tags" options="{'no_create': true}"/>
                            <field name="lug_group_ids" widget="many2many_tags" options="{'no_create': true}"/>
                        </group>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="requirement"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_store_benchmark_search" model="ir.ui.view">
        <field name="name">store.audit.template.line.benchmark.search</field>
        <field name="model">store.audit.template.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <group>
                    <filter name="group_template" string="Loại checklist" context="{'group_by': 'template_id'}"/>
                    <filter name="group_category" string="Nhóm tiêu chí" context="{'group_by': 'category'}"/>
                    <filter name="group_sub_group" string="Phân nhóm" context="{'group_by': 'sub_group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_store_benchmark" model="ir.actions.act_window">
        <field name="name">Điểm chuẩn</field>
        <field name="res_model">store.audit.template.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('template_id.audit_type', '!=', 'gs')]</field>
        <field name="search_view_id" ref="view_store_benchmark_search"/>
        <field name="context">{'search_default_group_sub_group': 1}</field>
    </record>

    <record id="action_store_benchmark_gs" model="ir.actions.act_window">
        <field name="name">Điểm chuẩn giám sát</field>
        <field name="res_model">store.audit.template.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('template_id.audit_type', '=', 'gs')]</field>
        <field name="search_view_id" ref="view_store_benchmark_search"/>
        <field name="context" eval="{'search_default_group_sub_group': 1, 'default_template_id': ref('tmpl_gs')}"/>
    </record>

    <record id="view_store_sub_group_list" model="ir.ui.view">
        <field name="name">store.audit.sub.group.list</field>
        <field name="model">store.audit.sub.group</field>
        <field name="arch" type="xml">
            <list group_edit="0" group_delete="0" string="Phân nhóm" editable="bottom" default_order="sequence, id">
                <field name="sequence" string="STT"/>
                <field name="category"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_store_sub_group" model="ir.actions.act_window">
        <field name="name">Phân nhóm</field>
        <field name="res_model">store.audit.sub.group</field>
        <field name="view_mode">list</field>
        <field name="domain">[('audit_type', '!=', 'gs')]</field>
    </record>

    <record id="action_store_sub_group_gs" model="ir.actions.act_window">
        <field name="name">Phân nhóm giám sát</field>
        <field name="res_model">store.audit.sub.group</field>
        <field name="view_mode">list</field>
        <field name="domain">[('audit_type', '=', 'gs')]</field>
        <field name="context">{'default_audit_type': 'gs'}</field>
    </record>

    <record id="view_store_level_list" model="ir.ui.view">
        <field name="name">store.audit.level.list</field>
        <field name="model">store.audit.level</field>
        <field name="arch" type="xml">
            <list group_edit="0" group_delete="0" string="Mức đánh giá" class="o_store_level">
                <field name="name" string="Xếp loại"/>
                <field name="min_score" options="{'hide_trailing_zeros': true}"/>
                <field name="score_range"/>
                <field name="tone" widget="badge"
                       decoration-success="tone == 'green'" decoration-info="tone == 'blue'"
                       decoration-warning="tone == 'orange'" decoration-danger="tone in ('red', 'darkred')"/>
                <button name="action_open_popup" type="object" icon="fa-pencil" title="Chỉnh sửa" width="48px"/>
                <button name="unlink" type="object" icon="fa-trash" title="Xóa" class="text-danger" width="48px"
                        confirm="Xóa mức đánh giá này?"/>
            </list>
        </field>
    </record>

    <record id="view_store_level_form" model="ir.ui.view">
        <field name="name">store.audit.level.form</field>
        <field name="model">store.audit.level</field>
        <field name="arch" type="xml">
            <form string="Mức đánh giá">
                <sheet>
                    <group>
                        <field name="name" string="Xếp loại"/>
                        <field name="min_score" options="{'hide_trailing_zeros': true}"/>
                        <field name="tone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_store_level" model="ir.actions.act_window">
        <field name="name">Mức Đánh giá</field>
        <field name="res_model">store.audit.level</field>
        <field name="view_mode">list</field>
        <field name="domain">[('audit_type', '!=', 'gs')]</field>
    </record>

    <record id="action_store_level_gs" model="ir.actions.act_window">
        <field name="name">Mức đánh giá giám sát</field>
        <field name="res_model">store.audit.level</field>
        <field name="view_mode">list</field>
        <field name="domain">[('audit_type', '=', 'gs')]</field>
        <field name="context">{'default_audit_type': 'gs'}</field>
    </record>

    <record id="action_store_groups" model="ir.actions.act_window">
        <field name="name">Phân quyền</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('privilege_id', '=', ref('res_groups_privilege_store_checklist'))]"/>
        <field name="group_ids" eval="[(4, ref('group_store_manager'))]"/>
    </record>

    <record id="action_store_shell" model="ir.actions.client">
        <field name="name">Checklist Audit</field>
        <field name="tag">store_checklist_shell</field>
    </record>
</odoo>
