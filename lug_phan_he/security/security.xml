<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_shift_management" model="ir.module.category">
            <field name="name">Quản Lý Lịch Ca</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_shift_management" model="res.groups.privilege">
            <field name="name">Quản Lý Lịch Ca</field>
            <field name="category_id" ref="module_category_shift_management"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_shift_report_access" model="res.groups">
            <field name="name">Quyền xem Báo cáo &amp; Giám sát</field>
            <field name="privilege_id" ref="privilege_shift_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
