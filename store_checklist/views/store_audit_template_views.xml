<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_audit_template_form" model="ir.ui.view">
        <field name="name">store.audit.template.form</field>
        <field name="model">store.audit.template</field>
        <field name="arch" type="xml">
            <form string="Mẫu checklist">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên mẫu checklist..."/></h1>
                    </div>
                    <group><field name="audit_type"/></group>
                    <field name="active" invisible="1"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="category"/>
                            <field name="sub_group_id" domain="category and [('category', '=', category)] or []"/>
                            <field name="name"/>
                            <field name="requirement"/>
                            <field name="max_score" sum="Tổng"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_store_audit_template_list" model="ir.ui.view">
        <field name="name">store.audit.template.list</field>
        <field name="model">store.audit.template</field>
        <field name="arch" type="xml">
            <list string="Mẫu checklist">
                <field name="name"/>
                <field name="audit_type"/>
            </list>
        </field>
    </record>

    <record id="action_store_audit_template" model="ir.actions.act_window">
        <field name="name">Mẫu checklist</field>
        <field name="res_model">store.audit.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
