<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eam_asset_history_list" model="ir.ui.view">
        <field name="name">eam.asset.history.list</field>
        <field name="model">eam.asset.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="event_date"/>
                <field name="asset_id"/>
                <field name="event_type"/>
                <field name="name"/>
                <field name="from_state" optional="hide"/>
                <field name="to_state" optional="hide"/>
                <field name="location_note" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eam_asset_history_form" model="ir.ui.view">
        <field name="name">eam.asset.history.form</field>
        <field name="model">eam.asset.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event_date"/>
                            <field name="asset_id"/>
                            <field name="event_type"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="from_state"/>
                            <field name="to_state"/>
                            <field name="location_note"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="user_id"/>
                            <field name="transaction_id"/>
                        </group>
                    </group>
                    <group string="Chi tiết">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eam_asset_history" model="ir.actions.act_window">
        <field name="name">Lịch sử / Timeline</field>
        <field name="res_model">eam.asset.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
