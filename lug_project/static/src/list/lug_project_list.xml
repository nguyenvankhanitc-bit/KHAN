<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="lug_project.LugPlistUserChip">
        <span class="o_lug_plist_user" t-att-title="user.name">
            <t t-if="user.avatar_url">
                <img class="o_lug_plist_user_img" t-att-src="user.avatar_url" t-att-alt="user.name"/>
            </t>
            <t t-else="">
                <span class="o_lug_plist_user_init" t-att-style="'background:' + user.color" t-esc="user.initial"/>
            </t>
            <span t-if="showName" class="o_lug_plist_user_name" t-esc="user.name"/>
        </span>
    </t>

    <t t-name="lug_project.LugPlistAssignees">
        <div class="o_lug_plist_assignees">
            <t t-if="!assignees.users.length">
                <span class="o_lug_plist_muted">—</span>
            </t>
            <t t-else="">
                <t t-foreach="assignees.users" t-as="user" t-key="user.id">
                    <t t-call="lug_project.LugPlistUserChip">
                        <t t-set="user" t-value="user"/>
                        <t t-set="showName" t-value="false"/>
                    </t>
                </t>
                <span t-if="assignees.extra" class="o_lug_plist_user_more">+<t t-esc="assignees.extra"/></span>
            </t>
        </div>
    </t>

    <t t-name="lug_project.LugProjectList">
        <div class="o_lug_plist" data-lug-plist="v6-cards-fix">
            <header class="o_lug_plist_toolbar">
                <button t-if="!props.archived" type="button" class="o_lug_plist_btn o_lug_plist_btn--primary" t-on-click="onNew">
                    + Tạo mới
                </button>
                <span t-if="props.overdue" class="o_lug_plist_overdue_title">
                    Dự án trễ hạn
                    <small>Deadline đã qua, chưa hoàn thành</small>
                </span>
                <span t-if="props.archived" class="o_lug_plist_archive_title">
                    Thùng rác
                    <small>Tự xóa vĩnh viễn sau 30 ngày</small>
                </span>
                <button type="button"
                        class="o_lug_plist_btn o_lug_plist_btn--export"
                        t-att-disabled="state.exporting"
                        t-on-click="exportExcel">
                    <i class="fa fa-file-excel-o"/> Xuất Excel
                </button>
                <div class="o_lug_plist_search">
                    <i class="fa fa-search"/>
                    <input type="search"
                           placeholder="Tìm mã, tên dự án, cửa hàng, trưởng DA..."
                           t-att-value="state.search"
                           t-on-input="onSearchInput"/>
                </div>
                <button type="button"
                        t-att-class="'o_lug_plist_urgent_btn' + (state.priority === 'urgent' ? ' is-on' : '')"
                        t-on-click="onUrgentOnly">
                    Chỉ hiện dự án Gấp
                </button>
                <div class="o_lug_plist_pager">
                    <span t-esc="pagerLabel"/>
                    <button type="button" class="o_lug_plist_pg" t-att-disabled="!canPrev" t-on-click="prevPage">
                        <i class="fa fa-angle-left"/>
                    </button>
                    <button type="button" class="o_lug_plist_pg" t-att-disabled="!canNext" t-on-click="nextPage">
                        <i class="fa fa-angle-right"/>
                    </button>
                </div>
            </header>

            <div class="o_lug_plist_filters">
                <label>
                    Độ ưu tiên
                    <select t-att-value="state.priority" t-on-change="(ev) => this.onFilterChange('priority', ev)">
                        <option value="">Tất cả</option>
                        <option value="urgent">Gấp</option>
                        <option value="normal">Không gấp</option>
                    </select>
                </label>
                <label>
                    Loại dự án
                    <select t-att-value="state.typeId" t-on-change="(ev) => this.onFilterChange('typeId', ev)">
                        <option value="">Tất cả</option>
                        <t t-foreach="state.types" t-as="type" t-key="type.id">
                            <option t-att-value="type.id" t-esc="type.name"/>
                        </t>
                    </select>
                </label>
                <label>
                    Trạng thái
                    <select t-att-value="state.status" t-on-change="(ev) => this.onFilterChange('status', ev)">
                        <option value="">Tất cả</option>
                        <t t-foreach="state.statuses" t-as="st" t-key="st.key">
                            <option t-att-value="st.key" t-esc="st.label"/>
                        </t>
                    </select>
                </label>
                <label>
                    Trưởng DA
                    <select t-att-value="state.managerId" t-on-change="(ev) => this.onFilterChange('managerId', ev)">
                        <option value="">Tất cả</option>
                        <t t-foreach="state.managers" t-as="mgr" t-key="mgr.id">
                            <option t-att-value="mgr.id" t-esc="mgr.name"/>
                        </t>
                    </select>
                </label>
                <label>
                    Bộ lọc ngày
                    <select t-att-value="state.datePreset" t-on-change="(ev) => this.onFilterChange('datePreset', ev)">
                        <option value="">Tất cả thời gian</option>
                        <option value="today">Hôm nay</option>
                        <option value="week">Tuần này</option>
                        <option value="month">Tháng này</option>
                        <option value="quarter">Quý này</option>
                        <option value="year">Năm nay</option>
                        <option value="custom">Khoảng tùy chọn</option>
                    </select>
                </label>
                <label>
                    Lọc theo
                    <select t-att-value="state.dateField" t-on-change="(ev) => this.onFilterChange('dateField', ev)">
                        <option value="start">Ngày bắt đầu</option>
                        <option value="deadline">Deadline</option>
                    </select>
                </label>
                <t t-if="state.datePreset === 'custom'">
                    <label>
                        Từ ngày
                        <input type="date" t-att-value="state.dateFrom" t-on-change="(ev) => this.onFilterChange('dateFrom', ev)"/>
                    </label>
                    <label>
                        Đến ngày
                        <input type="date" t-att-value="state.dateTo" t-on-change="(ev) => this.onFilterChange('dateTo', ev)"/>
                    </label>
                </t>
            </div>

            <t t-if="state.loading">
                <div class="o_lug_plist_loading">
                    <i class="fa fa-spinner fa-spin"/> Đang tải danh sách...
                </div>
            </t>
            <t t-elif="!state.rows.length">
                <div class="o_lug_plist_empty">
                    <t t-if="props.archived">Thùng rác trống.</t>
                    <t t-elif="props.overdue">Không có dự án trễ hạn.</t>
                    <t t-else="">Không có dự án nào.</t>
                </div>
            </t>
            <t t-else="">
                <div class="o_lug_plist_board">
                    <t t-foreach="state.rows" t-as="row" t-key="row.id">
                        <article t-att-class="'o_lug_dash_card' + (row.deadline_late ? ' is-late' : '')"
                                 t-on-click="() => this.toggleRow(row.id)">
                            <header class="o_lug_dash_head">
                                <div class="o_lug_dash_title">
                                    <span class="o_lug_dash_code">[<t t-esc="row.code"/>]</span>
                                    <span class="o_lug_dash_name" t-esc="row.name"/>
                                    <span t-if="row.type_tone !== 'none'"
                                          t-att-class="'o_lug_dash_type is-' + row.type_tone"
                                          t-esc="row.type_label"/>
                                </div>
                                <span t-att-class="'o_lug_dash_status is-' + row.status_tone"
                                      t-esc="row.status_badge"/>
                            </header>
                            <div class="o_lug_dash_body">
                                <section class="o_lug_dash_col o_lug_dash_col--people">
                                    <h4>NHÂN SỰ &amp; QUẢN TRỊ</h4>
                                    <p>
                                        <span>Trưởng DA:</span>
                                        <b t-esc="row.manager_name"/>
                                    </p>
                                    <div class="o_lug_dash_people_row">
                                        <span>Phụ trách:</span>
                                        <div class="o_lug_plist_assignees">
                                            <t t-if="!row.assignees.users.length">
                                                <span class="o_lug_plist_muted">—</span>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="row.assignees.users" t-as="user" t-key="user.id">
                                                    <span class="o_lug_plist_user" t-att-title="user.name">
                                                        <t t-if="user.avatar_url">
                                                            <img class="o_lug_plist_user_img" t-att-src="user.avatar_url" t-att-alt="user.name"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="o_lug_plist_user_init" t-att-style="'background:' + user.color" t-esc="user.initial"/>
                                                        </t>
                                                    </span>
                                                </t>
                                                <span t-if="row.assignees.extra" class="o_lug_plist_user_more">+<t t-esc="row.assignees.extra"/></span>
                                            </t>
                                        </div>
                                    </div>
                                    <p>
                                        <span>Độ ưu tiên:</span>
                                        <b t-if="row.urgent" class="is-urgent">Gấp</b>
                                        <b t-else="">Bình thường</b>
                                    </p>
                                </section>
                                <section class="o_lug_dash_col o_lug_dash_col--plan">
                                    <h4>KẾ HOẠCH &amp; DEADLINE</h4>
                                    <p><span>Bắt đầu:</span> <b t-esc="row.date_start or '—'"/></p>
                                    <p><span>Deadline:</span> <b t-esc="row.deadline or '—'"/></p>
                                    <div t-att-class="'o_lug_dash_dl is-' + row.dl_state" t-esc="row.dl_badge"/>
                                </section>
                                <section class="o_lug_dash_col o_lug_dash_col--progress">
                                    <div class="o_lug_dash_donut" t-att-style="row.donut_style">
                                        <div class="o_lug_dash_donut_inner">
                                            <strong><t t-esc="row.progress_pct"/>%</strong>
                                        </div>
                                    </div>
                                    <div class="o_lug_dash_progress_meta">
                                        <div class="o_lug_dash_progress_label">
                                            TIẾN ĐỘ THỰC HIỆN DỰ ÁN (<t t-esc="row.progress_pct"/>%)
                                        </div>
                                        <div t-att-class="'o_lug_dash_bar ' + row.bar_class">
                                            <i t-att-style="'width:' + row.progress_pct + '%'"/>
                                        </div>
                                        <div class="o_lug_dash_phases_cap">4 GIAI ĐOẠN QUẢN TRỊ DỰ ÁN</div>
                                        <div class="o_lug_dash_pills">
                                            <t t-foreach="row.pills" t-as="pill" t-key="pill.index">
                                                <span t-att-class="'o_lug_dash_pill is-' + pill.state">
                                                    <t t-if="pill.state === 'done'">✓ </t>
                                                    <t t-elif="pill.state === 'active'">▶ </t>
                                                    GĐ <t t-esc="pill.index"/>: <t t-esc="pill.name"/>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </section>
                            </div>
                            <t t-if="isExpanded(row.id)">
                                <div class="o_lug_dash_expand" t-on-click.stop="() => this.keepOpen()">
                                    <t t-if="state.detailLoading === row.id">
                                        <div class="o_lug_plist_detail_loading">
                                            <i class="fa fa-spinner fa-spin"/> Đang tải chi tiết...
                                        </div>
                                    </t>
                                    <t t-elif="state.details[row.id]">
                                        <section class="o_lug_plist_detail">
                                            <header class="o_lug_plist_detail_head">
                                                <h3>CHI TIẾT THÔNG TIN DỰ ÁN BAN ĐẦU</h3>
                                                <div class="o_lug_plist_wf">
                                                    <t t-foreach="workflowOptions" t-as="opt" t-key="opt.key">
                                                        <button type="button"
                                                                t-att-class="'o_lug_plist_wf_btn' + (state.details[row.id].workflow_state === opt.key ? ' is-active' : '')"
                                                                t-on-click.stop="() => this.setWorkflow(row.id, opt.key)"
                                                                t-esc="opt.label"/>
                                                    </t>
                                                </div>
                                            </header>
                                            <footer class="o_lug_plist_detail_actions">
                                                <button type="button" class="o_lug_plist_btn o_lug_plist_btn--primary" t-on-click.stop="() => this.editProject(row.id)">
                                                    <i class="fa fa-pencil"/> Sửa dự án
                                                </button>
                                                <button type="button" class="o_lug_plist_btn o_lug_plist_btn--ghost" t-on-click.stop="() => this.addTask(row.id)">
                                                    + Thêm công việc
                                                </button>
                                                <button type="button" class="o_lug_plist_btn o_lug_plist_btn--ghost" t-on-click.stop="() => this.viewGantt(row.id)">
                                                    <i class="fa fa-bar-chart"/> Xem Gantt Chart
                                                </button>
                                            </footer>
                                        </section>
                                    </t>
                                </div>
                            </t>
                        </article>
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>
