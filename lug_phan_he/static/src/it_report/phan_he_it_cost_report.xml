<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_phan_he.PhanHeItCostReport">
        <div class="o_it_pie_report">
            <header class="o_it_pie_head">
                <div>
                    <h1 t-esc="state.title"/>
                    <p>
                        <span t-esc="state.period"/>
                        <span> · </span>
                        <span t-esc="state.dimension"/>
                    </p>
                </div>
                <button type="button"
                        class="o_it_pie_export"
                        t-att-disabled="state.exporting or state.loading"
                        t-on-click="exportExcel">
                    <i class="fa fa-file-excel-o"/>
                    <t t-if="state.exporting">Đang xuất...</t>
                    <t t-else="">Xuất Excel</t>
                </button>
            </header>

            <t t-if="state.loading">
                <div class="o_it_pie_loading">Đang tải báo cáo...</div>
            </t>
            <t t-else="">
                <section class="o_it_pie_card">
                    <div class="o_it_pie_chart_wrap">
                        <t t-if="state.slices.length">
                            <canvas t-ref="pie"/>
                        </t>
                        <t t-else="">
                            <div class="o_it_pie_empty">Chưa có số liệu để vẽ biểu đồ.</div>
                        </t>
                    </div>
                    <ul class="o_it_pie_legend">
                        <li t-foreach="state.slices" t-as="slice" t-key="slice_index">
                            <i t-att-style="'background:' + slice.color"/>
                            <span class="o_it_pie_legend_label">
                                <em t-esc="state.sliceField"/> - <t t-esc="slice.label"/>
                            </span>
                            <span class="o_it_pie_legend_value">
                                <strong t-esc="formatMoney(slice.amount)"/>
                                <small>(<t t-esc="slice.percent"/>%)</small>
                            </span>
                        </li>
                    </ul>
                </section>

                <section class="o_it_pie_list">
                    <div class="o_it_pie_list_head">
                        <h2>Phiếu danh sách</h2>
                        <span>
                            <t t-esc="state.count"/> phiếu ·
                            <t t-esc="formatMoney(state.total)"/> đ
                        </span>
                    </div>
                    <div class="o_it_pie_table_wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tên thiết bị</th>
                                    <th>Nhà cung cấp</th>
                                    <th>Băng thông</th>
                                    <th>Ngày bắt đầu</th>
                                    <th>Ngày kết thúc</th>
                                    <th class="num">Cước tháng</th>
                                    <th class="num">Số tiền thanh toán</th>
                                    <th>Ghi chú</th>
                                    <th>Thời gian còn lại</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-if="!state.rows.length">
                                    <td colspan="10" class="o_it_pie_empty">Không có phiếu trong kỳ này.</td>
                                </tr>
                                <tr t-foreach="state.rows" t-as="row" t-key="row.id" t-on-click="() => this.openRow(row)">
                                    <td t-esc="row.asset_name"/>
                                    <td t-esc="row.provider"/>
                                    <td t-esc="row.bandwidth"/>
                                    <td t-esc="row.date_start"/>
                                    <td t-esc="row.date_end"/>
                                    <td class="num" t-esc="formatMoney(row.amount_untaxed)"/>
                                    <td class="num" t-esc="formatMoney(row.amount_total)"/>
                                    <td t-esc="row.note"/>
                                    <td t-esc="row.remaining_label"/>
                                    <td>
                                        <span t-att-class="'o_it_pie_badge is-' + (row.renewal_state || 'active')" t-esc="row.renewal_label"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
