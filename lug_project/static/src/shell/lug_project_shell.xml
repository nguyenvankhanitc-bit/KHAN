<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_project.LugProjectShell">
        <div t-att-class="shellClass"
             data-lps-ui="topbar-plist-v1">
            <div class="o_lps_shell">
                <header class="o_lps_topbar">
                    <div class="o_lps_topbar_brand">
                        <i class="fa fa-th"/>
                        <span>DỰ ÁN SÁNG TÂM</span>
                    </div>
                    <nav class="o_lps_topbar_nav">
                        <t t-foreach="topNavItems" t-as="nav" t-key="nav.code">
                            <button type="button"
                                    t-att-class="'o_lps_topbar_link' + (isTopNavActive(nav.code) ? ' is-active' : '')"
                                    t-on-click="() => this.setActive(nav.code === 'list' ? 'list' : nav.code)"
                                    t-esc="nav.label"/>
                        </t>
                    </nav>
                    <div class="o_lps_topbar_user">
                        <span class="o_lps_topbar_avatar" t-esc="state.userInitial"/>
                        <span class="o_lps_topbar_company" t-esc="state.companyName"/>
                    </div>
                </header>
                <div class="o_lps_body" style="display:flex;flex-direction:row;flex:1;min-height:0;height:100%;align-items:stretch;">
                    <aside t-att-class="railClass" t-att-style="railStyle">
                        <button type="button" class="o_lps_rail_brand" title="Trang chủ" t-on-click="goHome">
                            <img t-att-src="state.companyLogoUrl" alt="SATACO"/>
                            <span>
                                <strong>SATACO</strong>
                                <small>GIẢI PHÁP TÀI CHÍNH TOÀN DIỆN</small>
                            </span>
                        </button>
                        <nav class="o_lps_rail_nav">
                            <button type="button" class="o_lps_rail_item" title="Trang chủ" t-on-click="goHome">
                                <i class="fa fa-home"/>
                                <span>Trang chủ</span>
                            </button>
                            <t t-foreach="state.apps" t-as="app" t-key="app.xmlid">
                                <button type="button"
                                        class="o_lps_rail_item"
                                        t-att-title="app.name"
                                        t-on-click="() => this.openApp(app)">
                                    <i t-att-class="'fa ' + app.icon"/>
                                    <span t-esc="app.name"/>
                                </button>
                            </t>
                            <button type="button" class="o_lps_rail_item active" title="Dự án">
                                <i class="fa fa-folder-open"/>
                                <span>Dự án</span>
                            </button>
                        </nav>
                        <div t-att-class="railResizerClass"
                             style="position:absolute;top:0;right:-7px;bottom:0;width:14px;z-index:80;cursor:col-resize;"
                             t-on-pointerdown="onRailResizeStart"
                             t-on-dblclick="resetRailWidth"
                             title="Kéo để đổi độ rộng cột SATACO">
                            <b class="o_lps_edge_bar"
                               style="position:absolute;top:10px;bottom:10px;left:50%;width:4px;margin-left:-2px;border-radius:99px;background:#1e293b;display:block;"/>
                            <span class="o_lps_edge_btn"
                                  role="button"
                                  style="position:absolute;top:50%;left:50%;width:22px;height:22px;margin:16px 0 0 -11px;border-radius:50%;background:#4c1d95;color:#fff;font-size:16px;font-weight:800;line-height:22px;text-align:center;cursor:pointer;display:block;"
                                  t-on-click.stop="toggleRail"
                                  t-on-pointerdown="stopPointer"
                                  t-att-title="state.railCollapsed ? 'Mở cột SATACO' : 'Thu gọn cột SATACO'"
                                  t-esc="state.railCollapsed ? '›' : '‹'"/>
                        </div>
                    </aside>

                    <aside t-att-class="sidebarClass" t-att-style="sidebarStyle">
                        <div class="o_lps_side_scroll">
                            <t t-foreach="navSections" t-as="section" t-key="section.key">
                                <div class="o_lps_side_section">
                                    <div class="o_lps_side_label">
                                        <span t-if="section.emoji" t-esc="section.emoji"/>
                                        <span t-esc="section.label"/>
                                    </div>
                                    <t t-foreach="section.items" t-as="item" t-key="item.code">
                                        <button type="button"
                                                t-att-class="'o_lps_side_item' + (item.cta ? ' is-cta' : '') + (state.active === item.code ? (item.code === 'kpi' ? ' active is-kpi' : ' active') : '')"
                                                t-att-title="item.label"
                                                t-on-click="() => this.setActive(item.code)">
                                            <span t-att-class="'o_lps_ico ico-' + item.code">
                                                <i t-att-class="'fa ' + item.icon"/>
                                            </span>
                                            <span class="o_lps_side_text" t-esc="item.label"/>
                                            <t t-if="itemBadge(item)">
                                                <em t-att-class="'o_lps_side_count' + (item.badgeKey === 'overdue' ? ' red' : '')"
                                                    t-esc="itemBadge(item)"/>
                                            </t>
                                        </button>
                                    </t>
                                </div>
                            </t>
                        </div>
                        <div t-att-class="sidebarResizerClass"
                             style="position:absolute;top:0;right:-7px;bottom:0;width:14px;z-index:80;cursor:col-resize;"
                             t-on-pointerdown="onSidebarResizeStart"
                             t-on-dblclick="resetSidebarWidth"
                             title="Kéo để đổi độ rộng menu">
                            <b class="o_lps_edge_bar"
                               style="position:absolute;top:10px;bottom:10px;left:50%;width:4px;margin-left:-2px;border-radius:99px;background:#1e293b;display:block;"/>
                            <span class="o_lps_edge_btn"
                                  role="button"
                                  style="position:absolute;top:50%;left:50%;width:22px;height:22px;margin:16px 0 0 -11px;border-radius:50%;background:#4c1d95;color:#fff;font-size:16px;font-weight:800;line-height:22px;text-align:center;cursor:pointer;display:block;"
                                  t-on-click.stop="toggleSidebar"
                                  t-on-pointerdown="stopPointer"
                                  t-att-title="state.sidebarCollapsed ? 'Mở menu dự án' : 'Thu gọn menu dự án'"
                                  t-esc="state.sidebarCollapsed ? '›' : '‹'"/>
                        </div>
                    </aside>

                    <main class="o_lps_content" style="position:relative;overflow:hidden;flex:1;min-height:0;min-width:0;">
                        <t t-if="isHome">
                            <div class="o_lps_scroll_controls" aria-label="Cuộn tổng quan">
                                <button type="button" class="o_lps_scroll_btn" title="Cuộn lên" t-on-click="scrollOverviewUp">▲</button>
                                <button type="button" class="o_lps_scroll_btn" title="Cuộn xuống" t-on-click="scrollOverviewDown">▼</button>
                            </div>
                            <div class="o_lps_scroll"
                                 t-ref="overviewScroll"
                                 style="position:absolute;top:0;right:0;bottom:0;left:0;overflow-y:scroll;overflow-x:hidden;overscroll-behavior:contain;">
                            <section class="o_lps_overview" data-lps-dash="overview-v1">
                                <header class="o_lps_ov_top">
                                    <div>
                                        <h1>
                                            <span class="o_lps_ov_title_ico"><i class="fa fa-pie-chart"/></span>
                                            TỔNG QUAN QUẢN TRỊ DỰ ÁN
                                        </h1>
                                        <p>Cập nhật số liệu theo thời gian thực</p>
                                    </div>
                                    <div class="o_lps_ov_filters">
                                        <select class="o_lps_ov_select" t-on-change="onOverviewPeriodChange">
                                            <option value="month">Tháng này</option>
                                            <option value="quarter">Quý này</option>
                                            <option value="year">Năm 2026</option>
                                        </select>
                                        <select class="o_lps_ov_select" t-on-change="onOverviewTypeChange">
                                            <option value="0">Tất cả loại DA</option>
                                            <t t-foreach="overviewTypes" t-as="ptype" t-key="ptype.id">
                                                <option t-att-value="ptype.id" t-esc="ptype.name"/>
                                            </t>
                                        </select>
                                        <button type="button" class="o_lps_ov_export" t-on-click="exportOverview">
                                            <i class="fa fa-file-excel-o"/>
                                            Xuất Báo Cáo
                                        </button>
                                    </div>
                                </header>
                                <div class="o_lps_ov_kpis">
                                    <t t-foreach="overviewKpis" t-as="kpi" t-key="kpi.key">
                                        <article t-att-class="kpi.cardClass">
                                            <div>
                                                <p t-esc="kpi.label"/>
                                                <strong t-esc="kpi.value"/>
                                                <span t-esc="kpi.hint"/>
                                            </div>
                                            <em><i t-att-class="kpi.iconClass"/></em>
                                        </article>
                                    </t>
                                </div>
                                <div class="o_lps_ov_charts">
                                    <article class="o_lps_ov_card">
                                        <header>
                                            <h2><i class="fa fa-users"/> Phân bổ dự án theo nhân sự</h2>
                                            <span>Số dự án / Nhân sự</span>
                                        </header>
                                        <div class="o_lps_ov_chart">
                                            <canvas t-ref="staffChart"/>
                                        </div>
                                    </article>
                                    <article class="o_lps_ov_card">
                                        <header>
                                            <h2><i class="fa fa-line-chart"/> Xu hướng dự án (6 tháng)</h2>
                                            <span>Phát sinh vs Hoàn tất</span>
                                        </header>
                                        <div class="o_lps_ov_chart">
                                            <canvas t-ref="trendChart"/>
                                        </div>
                                    </article>
                                    <article class="o_lps_ov_card">
                                        <header>
                                            <h2><i class="fa fa-money"/> Top chi phí theo dự án (Triệu VNĐ)</h2>
                                            <span>Ngân sách dự toán</span>
                                        </header>
                                        <div class="o_lps_ov_chart">
                                            <canvas t-ref="costChart"/>
                                        </div>
                                    </article>
                                    <article class="o_lps_ov_card">
                                        <header>
                                            <h2><i class="fa fa-bullseye"/> Hiệu suất tiến độ thực tế</h2>
                                            <span>Tỷ lệ hoàn thành hạn chót</span>
                                        </header>
                                        <div class="o_lps_ov_chart o_lps_ov_chart--donut">
                                            <canvas t-ref="perfChart"/>
                                        </div>
                                    </article>
                                </div>
                                <div class="o_lps_scroll_spacer" aria-hidden="true"/>
                            </section>
                            </div>
                        </t>
                        <t t-elif="isGantt">
                            <div class="o_lps_scroll">
                            <section class="o_lps_dash" data-lps-dash="gantt-cal-v6">
                                <article class="o_lps_card">
                                    <header class="o_lps_card_head">
                                        <div>
                                            <h3>Gantt Chart</h3>
                                            <p>Tiến độ các dự án theo thời gian</p>
                                        </div>
                                        <t t-call="lug_project.LugProjectFilter"/>
                                    </header>
                                    <t t-if="!state.dashboard.gantt.length">
                                        <p class="o_lps_empty">Chưa có dự án để vẽ Gantt.</p>
                                    </t>
                                    <div t-else="" class="o_lps_gantt_wrap is-lg">
                                        <t t-call="lug_project.LugGanttBoard"/>
                                    </div>
                                </article>
                            </section>
                            </div>
                        </t>
                        <t t-elif="state.viewError">
                            <div class="o_lps_view_error">
                                <p>Không tải được màn hình này.</p>
                                <pre t-esc="state.viewError"/>
                                <button type="button" class="btn btn-primary" t-on-click="() => this.setActive('list')">
                                    Về danh sách
                                </button>
                            </div>
                        </t>
                        <div t-elif="isProjectList" class="o_lps_view_host o_lps_view_host--plist">
                            <LugProjectList t-key="state.active"
                                            archived="state.active === 'archived'"
                                            overdue="state.active === 'overdue'"
                                            onNew.bind="() => this.setActive('intake')"
                                            onGantt.bind="(id) => this.viewGanttForProject(id)"/>
                        </div>
                        <div t-else="" class="o_lps_view_host">
                            <View t-props="viewProps" t-key="state.active"/>
                        </div>
                    </main>
                </div>
            </div>
        </div>
    </t>

    <t t-name="lug_project.LugProjectFilter">
        <div class="o_lps_filter" t-on-pointerdown.stop="">
            <button type="button" class="o_lps_filter_btn" t-on-click.stop="toggleProjectFilter">
                <i class="o_lps_filter_dot"/>
                <span>Dự án: <t t-esc="filterProjectLabel"/></span>
                <em class="fa fa-angle-down"/>
            </button>
            <div t-if="state.filterOpen" class="o_lps_filter_menu">
                <input type="text"
                       class="o_lps_filter_search"
                       placeholder="Tìm dự án..."
                       t-att-value="state.filterQuery"
                       t-on-input="onFilterSearch"/>
                <button type="button"
                        t-att-class="'o_lps_filter_opt' + (!state.filterProjectId ? ' is-on' : '')"
                        t-on-click="() => this.selectProjectFilter(0)">
                    <span>Tất cả dự án</span>
                    <i t-if="!state.filterProjectId" class="fa fa-check"/>
                </button>
                <t t-foreach="visibleFilterProjects" t-as="proj" t-key="proj.id">
                    <button type="button"
                            t-att-class="'o_lps_filter_opt' + (state.filterProjectId === proj.id ? ' is-on' : '')"
                            t-on-click="() => this.selectProjectFilter(proj.id)">
                        <span t-esc="proj.name"/>
                        <i t-if="state.filterProjectId === proj.id" class="fa fa-check"/>
                    </button>
                </t>
                <p t-if="!visibleFilterProjects.length" class="o_lps_filter_empty">Không tìm thấy dự án.</p>
            </div>
        </div>
    </t>

    <t t-name="lug_project.LugGanttBoard">
        <div class="o_lps_gantt o_lps_gantt--cal" data-lps-gantt="compact-v5">
            <div class="o_lps_gantt_scroll">
                <div class="o_lps_gantt_board">
                    <div class="o_lps_gantt_names">
                        <div class="o_lps_gantt_names_head">Dự án</div>
                        <div class="o_lps_gantt_name_body">
                            <t t-foreach="ganttVisibleRows" t-as="row" t-key="row.id">
                                <div t-att-class="'o_lps_gantt_name_row is-' + row.kind"
                                     t-att-style="ganttNameRowStyle(row)"
                                     t-on-click="() => this.onGanttRowClick(row)">
                                    <t t-if="row.kind === 'project' and row.has_children">
                                        <button type="button"
                                                class="o_lps_gantt_tog"
                                                t-on-click.stop="() => this.toggleGanttGroup(row.project_id)"
                                                t-esc="isGanttCollapsed(row.project_id) ? '+' : '−'"/>
                                    </t>
                                    <t t-elif="row.kind === 'project'">
                                        <span class="o_lps_gantt_tog is-empty"/>
                                    </t>
                                    <i t-if="row.kind === 'task'" class="o_lps_gantt_swatch" t-att-style="'background:' + (row.color or '#3b82f6')"/>
                                    <span t-att-class="row.kind === 'task' ? 'o_lps_gantt_task_name' : 'o_lps_gantt_proj_name'"
                                          t-esc="row.name"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="o_lps_gantt_cal" t-att-style="ganttCalStyle">
                        <div class="o_lps_gantt_months">
                            <t t-foreach="ganttCal.months" t-as="month" t-key="month_index">
                                <div t-att-style="ganttMonthStyle(month)" t-esc="month.label"/>
                            </t>
                        </div>
                        <div class="o_lps_gantt_plot">
                            <div class="o_lps_gantt_days">
                                <t t-foreach="ganttCal.days" t-as="day" t-key="day_index">
                                    <em t-att-class="ganttDayClass(day)" t-att-style="ganttDayStyle(day)" t-esc="day.n"/>
                                </t>
                            </div>
                            <div class="o_lps_gantt_track_body">
                                <t t-foreach="ganttVisibleRows" t-as="row" t-key="'track-' + row.id">
                                    <div t-att-class="'o_lps_gantt_track is-' + row.kind"
                                         t-att-style="ganttTrackStyle(row)"
                                         t-on-click="() => this.onGanttRowClick(row)">
                                        <div class="o_lps_gantt_cols">
                                            <t t-foreach="ganttCal.days" t-as="col" t-key="col_index">
                                                <i t-att-class="ganttDayClass(col)" t-att-style="ganttDayStyle(col)"/>
                                            </t>
                                        </div>
                                        <t t-if="row.kind === 'project'">
                                            <span class="o_lps_gantt_bar is-project" t-att-style="ganttBarStyle(row)"/>
                                        </t>
                                        <t t-elif="row.kind === 'task'">
                                            <span class="o_lps_gantt_bar is-task" t-att-style="ganttBarStyle(row)"/>
                                            <span t-if="row.label" class="o_lps_gantt_bar_label" t-att-style="ganttLabelStyle(row)" t-esc="row.label"/>
                                        </t>
                                        <t t-foreach="row.ms" t-as="ms" t-key="ms_index">
                                            <i class="o_lps_gantt_ms" t-att-style="ganttMsStyle(ms)"/>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="o_lps_gantt_legend">
                <i class="lg-bar"/> Mẫu dự án
                <i class="lg-ms"/> Milestone
            </div>
        </div>
    </t>
</templates>
