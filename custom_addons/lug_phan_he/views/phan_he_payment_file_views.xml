<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_phan_he_payment_file_list" model="ir.ui.view">
        <field name="name">phan.he.payment.file.list</field>
        <field name="model">phan.he.payment.file</field>
        <field name="arch" type="xml">
            <list string="File thanh toán">
                <field name="code"/>
                <field name="name"/>
                <field name="period_label" string="Kỳ"/>
                <field name="line_count" string="Số dòng"/>
                <field name="amount_total" sum="Tổng"/>
                <field name="pay_before_days" string="TT trước (ngày)"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'ready'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_phan_he_payment_file_form" model="ir.ui.view">
        <field name="name">phan.he.payment.file.form</field>
        <field name="model">phan.he.payment.file</field>
        <field name="arch" type="xml">
            <form string="File thanh toán Internet">
                <header>
                    <button name="action_generate_lines" type="object" string="Lấy dữ liệu"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_export_excel" type="object" string="Xuất Excel"
                            invisible="not line_ids"/>
                    <button name="action_create_payments" type="object" string="Tạo phiếu TT"
                            invisible="state != 'ready'"/>
                    <button name="action_confirm_done" type="object" string="Hoàn tất"
                            invisible="state != 'ready'"/>
                    <button name="action_reset_draft" type="object" string="Về nháp"
                            invisible="state not in ('ready', 'done')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Thanh toán internet T7 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="period_label"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="pay_before_days"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                            <field name="line_count"/>
                            <field name="excel_filename" invisible="1"/>
                            <field name="excel_file" filename="excel_filename" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ghi chú">
                        <field name="note" nolabel="1"
                               placeholder="Ví dụ: Thanh toán trước hạn 3 ngày..."/>
                    </group>
                    <notebook>
                        <page string="Danh sách thanh toán" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" decoration-muted="amount == 0">
                                    <field name="stt" string="STT" width="50px"/>
                                    <field name="company_code" string="CÔNG TY" width="70px"/>
                                    <field name="store_name" string="CỬA HÀNG"/>
                                    <field name="customer_code" string="MÃ KH"/>
                                    <field name="content" string="NỘI DUNG"/>
                                    <field name="amount" string="SỐ TIỀN" sum="Tổng"/>
                                    <field name="account_info" string="TÊN TÀI KHOẢN"/>
                                    <field name="date_due" string="Hạn TT"/>
                                    <field name="date_pay" string="Ngày TT (trước 3 ngày)"/>
                                    <field name="mien_id" optional="hide"/>
                                    <field name="service_id" optional="hide"/>
                                    <field name="payment_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_phan_he_payment_file_search" model="ir.ui.view">
        <field name="name">phan.he.payment.file.search</field>
        <field name="model">phan.he.payment.file</field>
        <field name="arch" type="xml">
            <search string="Tìm file thanh toán">
                <field name="name"/>
                <field name="code"/>
                <field name="period_label"/>
                <filter name="filter_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_ready" string="Đã lấy dữ liệu" domain="[('state', '=', 'ready')]"/>
                <filter name="filter_done" string="Hoàn tất" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_year" string="Năm" context="{'group_by': 'year'}"/>
                    <filter name="group_month" string="Tháng" context="{'group_by': 'month'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_phan_he_payment_file" model="ir.actions.act_window">
        <field name="name">File thanh toán</field>
        <field name="res_model">phan.he.payment.file</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có file thanh toán</p>
            <p>Tạo file theo tháng, bấm <b>Lấy dữ liệu</b> để tự động lấy từ theo dõi Internet.
               Ngày TT đề nghị = hạn thanh toán − 3 ngày.</p>
        </field>
    </record>
</odoo>
