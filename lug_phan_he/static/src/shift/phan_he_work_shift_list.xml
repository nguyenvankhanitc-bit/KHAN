<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_phan_he.WorkShiftListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <PhanHeAppSidebar activeKey="sidebarActiveKey"/>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button">
                <button t-if="!editedRecord and activeActions.create and props.showButtons"
                        type="button"
                        class="btn btn-primary o_list_button_add o_phan_he_btn_create"
                        data-hotkey="c"
                        t-on-click="onClickCreate"
                        data-bounce-button="">
                    <i class="fa fa-plus"/>
                    Tạo mới
                </button>
                <button t-if="!editedRecord and props.showButtons and !env.inDialog"
                        type="button"
                        class="btn btn-secondary o_phan_he_btn_import"
                        t-on-click="onClickImport">
                    <i class="fa fa-download"/>
                    Nhập bản ghi
                </button>
                <CogMenu t-if="!hasSelectedRecords and !editedRecord"/>
                <t t-if="props.showButtons and !env.inDialog" t-call="web.ListView.EditableButtons"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="replace">
            <t t-set-slot="control-panel-additional-actions">
                <CogMenu t-if="hasSelectedRecords and env.isSmall and (props.info.actionMenus or archInfo.headerButtons.length)"
                         t-props="this.actionMenuProps"
                         hasSelectedRecords="hasSelectedRecords">
                    <t t-foreach="archInfo.headerButtons" t-as="button" t-key="button.id" t-if="!evalViewModifier(button.invisible)">
                        <DropdownItem class="'o-dropdown-item-unstyled-button'">
                            <MultiRecordViewButton
                                t-if="button.display !== 'always'"
                                list="model.root"
                                className="button.className"
                                clickParams="button.clickParams"
                                defaultRank="'btn-secondary'"
                                domain="props.domain"
                                icon="button.icon"
                                string="button.string"
                                title="button.title"
                                attrs="button.attrs"
                            />
                        </DropdownItem>
                    </t>
                </CogMenu>
            </t>
        </xpath>
    </t>

    <t t-name="lug_phan_he.WorkShiftFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//div[@class='o_form_view_container']" position="before">
            <PhanHeAppSidebar activeKey="sidebarActiveKey"/>
        </xpath>
        <xpath expr="//button[@data-hotkey='c']" position="replace">
            <button t-if="canCreate" type="button" class="btn btn-primary o_form_button_create o_phan_he_btn_create" data-hotkey="c" t-on-click.stop="create">
                <i class="fa fa-plus"/> Tạo mới
            </button>
        </xpath>
    </t>

    <t t-name="lug_phan_he.NorthScheduleListView" t-inherit="lug_phan_he.WorkShiftListView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.NorthScheduleFormView" t-inherit="lug_phan_he.WorkShiftFormView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.StoreScheduleListView" t-inherit="lug_phan_he.WorkShiftListView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.StoreScheduleFormView" t-inherit="lug_phan_he.WorkShiftFormView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.DttScheduleListView" t-inherit="lug_phan_he.WorkShiftListView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.RosterListView" t-inherit="lug_phan_he.WorkShiftListView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.RosterGroupRow">
        <tr t-attf-class="{{group.count > 0 ? 'o_group_has_content' : ''}} o_group_header o_linkq_roster_group {{!group.isFolded ? 'o_group_open' : ''}} cursor-pointer"
            t-att-data-group-id="group.id"
            t-on-click="(ev) => this.onGroupHeaderClicked(ev, group)">
            <th class="o_group_name" t-att-colspan="nbCols" tabindex="-1">
                <div class="o_linkq_emp_group_bar">
                    <i t-attf-class="o_linkq_emp_group_caret fa {{group.isFolded ? 'fa-angle-right' : 'fa-angle-down'}}"/>
                    <span class="o_linkq_emp_group_title" t-esc="getRosterGroupTitle(group)"/>
                </div>
            </th>
        </tr>
    </t>

    <t t-name="lug_phan_he.AccessListView" t-inherit="lug_phan_he.WorkShiftListView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.TodayShiftListView" t-inherit="lug_phan_he.WorkShiftListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button"/>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="replace">
            <t t-set-slot="control-panel-additional-actions"/>
        </xpath>
    </t>

    <t t-name="lug_phan_he.EmployeeListView" t-inherit="lug_phan_he.WorkShiftListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button"/>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="replace">
            <t t-set-slot="control-panel-additional-actions"/>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-selection-actions']" position="replace">
            <t t-set-slot="control-panel-selection-actions">
                <div t-if="hasSelectedRecords" class="o_selection_container m-1 m-md-0 d-flex align-items-center gap-2">
                    <SelectionBox root="this.model.root"/>
                    <button t-if="isHrAdmin" type="button" class="btn btn-danger btn-sm fw-bold"
                            t-on-click="onBulkHardDeleteEmployees"
                            title="Xóa vĩnh viễn các nhân sự đã chọn">
                        <i class="fa fa-trash me-1"/> Xóa vĩnh viễn
                    </button>
                </div>
            </t>
        </xpath>
    </t>

    <t t-name="lug_phan_he.EmployeeGroupRow">
        <tr t-attf-class="{{group.count > 0 ? 'o_group_has_content' : ''}} o_group_header o_linkq_emp_group_header {{!group.isFolded ? 'o_group_open' : ''}} cursor-pointer"
            t-att-data-group-id="group.id"
            t-on-click="(ev) => this.onGroupHeaderClicked(ev, group)">
            <th class="o_group_name o_linkq_emp_group_name" t-att-colspan="nbCols" tabindex="-1">
                <div class="o_linkq_emp_group_bar">
                    <i t-attf-class="o_linkq_emp_group_caret fa {{group.isFolded ? 'fa-angle-right' : 'fa-angle-down'}}"/>
                    <i class="fa fa-home o_linkq_emp_group_icon"/>
                    <span class="o_linkq_emp_group_title" t-esc="getEmployeeGroupTitle(group)"/>
                    <span class="o_linkq_emp_group_count" t-esc="getEmployeeGroupCount(group)"/>
                </div>
            </th>
        </tr>
    </t>

    <t t-name="lug_phan_he.LinkqEmpStateField">
        <span t-attf-class="o_linkq_emp_status o_linkq_emp_status_{{stateValue}}">
            <span class="o_linkq_emp_dot"/>
            <span class="o_linkq_emp_status_label" t-esc="stateLabel"/>
        </span>
    </t>

    <t t-name="lug_phan_he.EmployeeFormButtons">
        <t t-if="!model.root.isInEdition">
            <button t-if="isHrAdmin" type="button" class="btn btn-outline-primary" t-on-click.stop="onEmployeeEdit">Chỉnh sửa</button>
            <button t-if="isHrAdmin" type="button" class="btn btn-outline-success" t-on-click.stop="onEmployeeCreate">Thêm mới</button>
            <button type="button" class="btn btn-secondary" t-on-click.stop="onEmployeeClose">Đóng</button>
        </t>
        <t t-else="">
            <button type="button" class="btn btn-primary o_linkq_btn_purple" data-hotkey="s" t-on-click.stop="onEmployeeSave">Lưu</button>
            <button type="button" class="btn btn-secondary" t-on-click.stop="onEmployeeCancel">Hủy bỏ</button>
        </t>
    </t>

    <t t-name="lug_phan_he.AccessFormView" t-inherit="lug_phan_he.WorkShiftFormView" t-inherit-mode="primary"/>

    <t t-name="lug_phan_he.RosterFormView" t-inherit="lug_phan_he.WorkShiftFormView" t-inherit-mode="primary">
        <xpath expr="//button[@data-hotkey='c']" position="replace">
            <div class="o_mm_form_header_btns d-flex align-items-center flex-nowrap gap-2">
                <button t-if="!model.root.isInEdition and canEdit and model.root.resId and model.root.data.state != 'confirmed' and !model.root.data.is_locked and !model.root.data.period_edit_blocked"
                        type="button"
                        class="btn btn-outline-secondary fw-bold px-3 o_mm_btn_edit flex-shrink-0"
                        t-on-click.stop="() => this.onRosterEdit()">
                    <i class="fa fa-pencil me-1"/> Chỉnh sửa
                </button>
                <button t-if="!model.root.isInEdition and canUnlock"
                        type="button"
                        class="btn btn-danger fw-bold px-3 flex-shrink-0"
                        t-on-click.stop="() => this.onRosterUnlock()">
                    <i class="fa fa-unlock me-1"/> Mở khóa lịch
                </button>
                <button t-if="model.root.isInEdition and !model.root.data.period_edit_blocked"
                        type="button"
                        class="btn btn-primary fw-bold px-3 o_mm_btn_save flex-shrink-0"
                        data-hotkey="s"
                        t-on-click.stop="() => this.onRosterSave()">
                    <i class="fa fa-floppy-o me-1"/> Lưu
                </button>
                <button t-if="model.root.isInEdition"
                        type="button"
                        class="btn btn-outline-secondary fw-bold px-3 o_mm_btn_cancel flex-shrink-0"
                        data-hotkey="j"
                        t-on-click.stop="() => this.onRosterDiscard()">
                    Hủy
                </button>
            </div>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-status-indicator']" position="replace">
            <t t-set-slot="control-panel-status-indicator"/>
        </xpath>
    </t>
</templates>
