<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkKhoReport">
        <div class="o_daily_work_dashboard o_daily_work_kho_report o_action">
            <DailyWorkAppShell t-props="{ activeNav: shellActiveNav }">
                <div class="o_dkr_shell">
                    <!-- Đầu báo cáo (giống Báo cáo cá nhân): tiêu đề giữa · bộ lọc + nút bên phải -->
                    <div class="o_dkr_head">
                        <div class="o_dkr_head_side"/>
                        <div class="o_dkr_head_center">
                            <h2 class="o_dkr_head_title" t-esc="title"/>
                            <div class="o_dkr_head_sub" t-esc="subLine"/>
                            <div class="o_dkr_head_line" t-esc="'Tháng ' + state.month + ' Năm ' + state.year"/>
                        </div>
                        <div class="o_dkr_toolbar">
                            <select class="form-select form-select-sm" t-on-change="(ev) => this.onFilter('month', ev)">
                                <t t-foreach="months" t-as="m" t-key="m">
                                    <option t-att-value="m" t-att-selected="m === state.month" t-esc="'Tháng ' + m"/>
                                </t>
                            </select>
                            <select class="form-select form-select-sm" t-on-change="(ev) => this.onFilter('year', ev)">
                                <t t-foreach="years" t-as="y" t-key="y">
                                    <option t-att-value="y" t-att-selected="y === state.year" t-esc="y"/>
                                </t>
                            </select>
                            <select class="form-select form-select-sm o_dkr_team" t-on-change="(ev) => this.onFilter('teamId', ev)"
                                    t-att-disabled="state.teams.length &lt; 2">
                                <t t-foreach="state.teams" t-as="tm" t-key="tm.id">
                                    <option t-att-value="tm.id" t-att-selected="tm.id === state.teamId" t-esc="'Team: ' + tm.name"/>
                                </t>
                            </select>
                            <select t-if="state.canPick" class="form-select form-select-sm o_dkr_emp"
                                    t-on-change="(ev) => this.onFilter('employeeId', ev)">
                                <option value="0" t-att-selected="!state.employeeId">Tất cả nhân viên</option>
                                <t t-foreach="state.employees" t-as="e" t-key="e.id">
                                    <option t-att-value="e.id" t-att-selected="e.id === state.employeeId" t-esc="e.name"/>
                                </t>
                            </select>
                            <span class="o_dkr_spacer"/>
                            <button t-if="state.rows.length" type="button" class="btn btn-light btn-sm" t-on-click="toggleAll">
                                <i t-att-class="'fa ' + (allOpen ? 'fa-compress' : 'fa-expand')"/>
                                <t t-esc="allOpen ? ' Thu gọn tất cả' : ' Mở tất cả'"/>
                            </button>
                            <button type="button" class="btn btn-light btn-sm" t-on-click="() => this.load()">
                                <i class="fa fa-refresh"/> Làm mới
                            </button>
                            <button t-if="state.canExport" type="button" class="btn btn-success btn-sm"
                                    t-att-disabled="state.exporting or !state.rows.length" t-on-click="onExport">
                                <i class="fa fa-file-excel-o"/> Xuất Excel
                            </button>
                        </div>
                    </div>

                    <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-spinner fa-spin fa-2x"/></div>
                    <div t-elif="state.message" class="alert alert-warning m-0" t-esc="state.message"/>
                    <!-- Biểu đồ (giống Báo cáo cá nhân): Xếp loại · Hiệu suất QL đánh giá · Hiệu suất theo hạng mục -->
                    <div t-if="!state.loading and !state.message" class="o_dkr_charts">
                        <div class="o_dkr_card">
                            <h3>Tỷ lệ xếp loại công việc</h3>
                            <div class="o_dkr_donut_wrap">
                                <div class="o_dkr_donut_box">
                                    <canvas t-ref="ratingChart"/>
                                    <div class="o_dkr_donut_center">
                                        <strong t-esc="state.rows.length"/>
                                        <span>Tổng việc</span>
                                    </div>
                                </div>
                                <div class="o_dkr_legend">
                                    <t t-foreach="ratingLegend" t-as="leg" t-key="leg.key">
                                        <div class="o_dkr_legend_item">
                                            <span class="o_dkr_legend_dot" t-att-style="'background:' + leg.color"/>
                                            <span class="o_dkr_legend_label" t-esc="leg.label"/>
                                            <strong t-esc="leg.count"/>
                                            <span class="o_dkr_muted" t-esc="'(' + leg.pct + '%)'"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <!-- Hiệu suất công việc: % QL đánh giá TB (chưa đánh giá = 0%) -->
                        <div class="o_dkr_card">
                            <h3>Hiệu suất công việc</h3>
                            <div class="o_dkr_eval">
                                <div class="o_dkr_eval_ring">
                                    <canvas t-ref="perfChart"/>
                                    <div class="o_dkr_eval_center"><strong t-esc="perf.score + '%'"/></div>
                                </div>
                            </div>
                            <p class="o_dkr_muted o_dkr_card_note">
                                % Hoàn thành quản lý đánh giá ở Kiểm tra CV · đã đánh giá
                                <b t-esc="perf.evaluated + '/' + perf.total"/> việc
                            </p>
                        </div>
                        <!-- Tổng thời gian: tổng giờ + giờ theo hạng mục -->
                        <div class="o_dkr_card">
                            <h3>Tổng thời gian</h3>
                            <div class="o_dkr_time_total">
                                <strong t-esc="totalHours"/> <span>giờ</span>
                                <em class="o_dkr_muted" t-esc="'(' + totalMinutes + ' phút)'"/>
                            </div>
                            <div t-if="timeByCat.length" class="o_dkr_bar_box" t-att-style="timeBoxStyle">
                                <canvas t-ref="timeChart"/>
                            </div>
                            <div t-else="" class="o_dkr_muted text-center py-3">Chưa có thời gian thực hiện.</div>
                        </div>
                    </div>

                    <div t-if="!state.loading and !state.message" class="o_dkr_sheet">
                        <div class="o_dkr_meta">
                            <span class="o_dkr_meta_sum">
                                <t t-esc="state.rows.length"/> việc · <t t-esc="totalMinutes"/> phút ·
                                <b class="is-pass">Đạt <t t-esc="ratingCount.pass"/></b> ·
                                <b class="is-average">Trung bình <t t-esc="ratingCount.average"/></b> ·
                                <b class="is-fail">Không đạt <t t-esc="ratingCount.fail"/></b>
                            </span>
                        </div>
                        <div class="o_dkr_table_wrap">
                            <table class="o_dkr_table">
                                <thead>
                                    <tr>
                                        <th class="o_dkr_c_stt">STT</th>
                                        <th class="o_dkr_c_cat">Hạng mục</th>
                                        <th class="o_dkr_c_detail">Tên chi tiết hạng mục</th>
                                        <th class="o_dkr_c_name">Tên công việc</th>
                                        <th t-if="state.showEmployee" class="o_dkr_c_emp">Nhân viên</th>
                                        <th class="o_dkr_c_date">Ngày bắt đầu</th>
                                        <th class="o_dkr_c_date">Deadline</th>
                                        <th class="o_dkr_c_min">Thời gian (phút)</th>
                                        <th class="o_dkr_c_rate">Xếp loại</th>
                                        <th class="o_dkr_c_note">Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="groups" t-as="g" t-key="g.key">
                                        <!-- Hạng mục: bấm để mở / thu gọn -->
                                        <tr class="o_dkr_group" t-on-click="() => this.toggleGroup(g)" role="button"
                                            t-att-aria-expanded="isOpen(g) ? 'true' : 'false'">
                                            <td t-att-colspan="state.showEmployee ? 10 : 9">
                                                <i t-att-class="'fa o_dkr_group_chev ' + (isOpen(g) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                                <span class="o_dkr_group_name" t-esc="g.label"/>
                                                <span class="o_dkr_group_meta">
                                                    <t t-esc="g.rows.length"/> việc · <t t-esc="g.minutes"/> phút
                                                    <t t-if="g.pass"> · <b class="is-pass">Đạt <t t-esc="g.pass"/></b></t>
                                                    <t t-if="g.average"> · <b class="is-average">Trung bình <t t-esc="g.average"/></b></t>
                                                    <t t-if="g.fail"> · <b class="is-fail">Không đạt <t t-esc="g.fail"/></b></t>
                                                </span>
                                            </td>
                                        </tr>
                                        <t t-if="isOpen(g)">
                                            <tr t-foreach="g.rows" t-as="r" t-key="r.id" class="o_dkr_row">
                                                <td class="text-center" t-esc="r.stt"/>
                                                <td t-esc="r.category"/>
                                                <td t-esc="r.detail"/>
                                                <td t-esc="r.name"/>
                                                <td t-if="state.showEmployee" t-esc="r.employee"/>
                                                <td class="text-center" t-esc="r.start"/>
                                                <td class="text-center" t-esc="r.deadline"/>
                                                <td class="text-center" t-esc="r.minutes"/>
                                                <td class="text-center"><span t-att-class="ratingClass(r.rating)" t-esc="r.rating"/></td>
                                                <td class="o_dkr_note" t-esc="r.note"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr t-if="!state.rows.length">
                                        <td t-att-colspan="state.showEmployee ? 10 : 9" class="text-center text-muted py-4">
                                            Không có công việc trong tháng này.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </DailyWorkAppShell>
        </div>
    </t>
</templates>
