<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_phan_he.PhanHeHub">
        <div class="o_phan_he_hub" t-att-class="state.sidebarCollapsed ? 'is-collapsed' : ''">
            <aside class="o_phan_he_hub_sidebar">
                <div class="o_phan_he_hub_side_brand">
                    <button type="button" class="o_phan_he_hub_back" t-on-click="goToAppCenter" title="Về giao diện chính">
                        <i class="fa fa-arrow-left"/>
                    </button>
                    <span class="o_phan_he_hub_side_title">Quản lý dịch vụ</span>
                </div>
                <nav class="o_phan_he_hub_nav">
                    <button type="button"
                            class="o_phan_he_hub_nav_item"
                            t-att-class="state.activeNav === 'home' ? 'is-active' : ''"
                            t-on-click="setHome">
                        <i class="fa fa-home"/>
                        <span>Trang chủ</span>
                    </button>
                    <div class="o_phan_he_hub_nav_group">QUẢN LÝ DỊCH VỤ</div>
                    <t t-foreach="state.apps" t-as="app" t-key="'nav-' + app.code">
                        <button type="button"
                                class="o_phan_he_hub_nav_item"
                                t-att-class="state.activeNav === app.code ? 'is-active' : ''"
                                t-att-data-code="app.code"
                                t-on-click="onNavService">
                            <img class="o_phan_he_hub_nav_img" t-att-src="app.icon" t-att-alt="app.name"/>
                            <span t-esc="app.name"/>
                        </button>
                    </t>
                    <t t-if="state.showConfig">
                        <div class="o_phan_he_hub_nav_group">CẤU HÌNH</div>
                        <t t-foreach="configItems" t-as="cfg" t-key="'cfg-' + cfg.code">
                            <button type="button"
                                    class="o_phan_he_hub_nav_item"
                                    t-att-data-code="cfg.code"
                                    t-on-click="onNavConfig">
                                <i t-att-class="'fa ' + cfg.fa"/>
                                <span t-esc="cfg.name"/>
                            </button>
                        </t>
                    </t>
                </nav>
            </aside>
            <div class="o_phan_he_hub_main">
                <div class="o_phan_he_hub_top_search">
                    <i class="fa fa-search"/>
                    <input type="search"
                           placeholder="Tìm dịch vụ..."
                           t-att-value="state.query"
                           t-on-input="onSearch"/>
                </div>
                <div class="o_phan_he_hub_grid">
                    <t t-foreach="filteredApps" t-as="card" t-key="'card-' + card.code">
                        <button type="button"
                                class="o_phan_he_hub_card"
                                t-att-data-code="card.code"
                                t-on-click="onNavService">
                            <span class="o_phan_he_hub_icon">
                                <img t-att-src="card.icon" t-att-alt="card.name"/>
                            </span>
                            <span class="o_phan_he_hub_name" t-esc="card.name"/>
                        </button>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
