<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_daily_task_project_search" model="ir.ui.view">
        <field name="name">daily.task.project.search</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm công việc dự án">
                <field name="name" string="Tên công việc"/>
                <field name="lug_project_id" string="Dự án"/>
                <field name="assignee_id" string="Người phụ trách"/>
                <filter string="Chưa hoàn thành" name="filter_open" domain="[('state', '!=', 'done')]"/>
                <filter string="Đang xử lý" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Chưa bắt đầu" name="filter_not_started" domain="[('state', '=', 'not_started')]"/>
                <filter string="Đã hoàn thành" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Quá hạn" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Ưu tiên cao" name="filter_high" domain="[('priority', '=', 'high')]"/>
                <group expand="1" string="Gom nhóm">
                    <filter string="Dự án" name="group_by_project" context="{'group_by': 'lug_project_id'}"/>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Mức ưu tiên" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Hạn chót" name="group_by_deadline" context="{'group_by': 'deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree / List View (Grouped by Project) -->
    <record id="view_daily_task_project_tree" model="ir.ui.view">
        <field name="name">daily.task.project.tree</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <list string="Công việc theo dự án" default_group_by="lug_project_id"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'"
                  decoration-muted="state == 'not_started'"
                  decoration-danger="is_overdue">
                <field name="lug_project_id" string="Dự án"/>
                <field name="name" string="Tên công việc"/>
                <field name="assign_date" string="Ngày bắt đầu" optional="show"/>
                <field name="deadline" string="Hạn chót"/>
                <field name="priority" widget="badge"
                       decoration-danger="priority == 'high'"
                       decoration-warning="priority == 'medium'"
                       decoration-muted="priority == 'low'"/>
                <field name="duration_hours" string="Giờ" optional="show" sum="Tổng giờ"/>
                <field name="completion_percent" string="% Hoàn thành" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'"
                       decoration-muted="state == 'not_started'"/>
                <field name="is_overdue" string="Quá hạn" optional="show"/>
                <field name="note" string="Ghi chú" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_daily_task_project_kanban" model="ir.ui.view">
        <field name="name">daily.task.project.kanban</field>
        <field name="model">daily.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="1">
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="lug_project_id"/>
                <field name="completion_percent"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <main class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title text-truncate">
                                        <field name="name"/>
                                    </strong>
                                    <small t-if="record.lug_project_id.value" class="text-primary d-block">
                                        <i class="fa fa-folder-open-o me-1"/> <t t-esc="record.lug_project_id.value"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body my-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span t-if="record.deadline.value" t-attf-class="badge #{record.is_overdue.raw_value ? 'text-bg-danger' : 'text-bg-light'}">
                                        <i class="fa fa-clock-o me-1"/> <t t-esc="record.deadline.value"/>
                                    </span>
                                    <span t-if="record.priority.value" class="badge text-bg-secondary">
                                        <t t-esc="record.priority.value"/>
                                    </span>
                                </div>
                                <div t-if="record.completion_percent.value" class="progress mt-1" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         t-attf-style="width: #{record.completion_percent.raw_value}%"
                                         t-att-aria-valuenow="record.completion_percent.raw_value"
                                         aria-valuemin="0" aria-valuemax="100"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Server: Mở danh sách công việc theo dự án của user hiện tại -->
    <record id="action_daily_task_my_projects" model="ir.actions.server">
        <field name="name">Dự án</field>
        <field name="model_id" ref="daily_work_task.model_daily_task"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_project_tasks()</field>
    </record>

    <!-- Menuitem: Nằm ngay dưới "Quản lý công việc" trong Công việc hàng ngày -->
    <menuitem id="menu_daily_work_projects"
              name="Dự án"
              parent="daily_work_task.menu_daily_work_cat_tasks"
              action="action_daily_task_my_projects"
              sequence="2"
              groups="daily_work_task.group_daily_work_user"/>
</odoo>
