<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_linkq_rbac" model="res.groups.privilege">
        <field name="name">Quản lý dịch vụ / LinkQ ERP</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="sequence">21</field>
    </record>

    <record id="group_linkq_user" model="res.groups">
        <field name="name">User (Nhân viên)</field>
        <field name="comment">Nhân viên ca: xem/thêm/sửa bảng xếp ca trong phạm vi cửa hàng; không xóa; không cấu hình hệ thống; không xem Báo cáo &amp; Giám sát trừ khi được gán thêm.</field>
        <field name="privilege_id" ref="privilege_linkq_rbac"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_linkq_schedule_user'))]"/>
    </record>

    <record id="group_linkq_manager" model="res.groups">
        <field name="name">Manager (Quản trị / Trưởng bộ phận)</field>
        <field name="comment">Toàn quyền tạo/sửa/xóa bảng xếp ca, khóa/mở khóa, xem báo cáo giám sát, cấu hình khóa lịch. Không thay Administrator hệ thống.</field>
        <field name="privilege_id" ref="privilege_linkq_rbac"/>
        <field name="implied_ids" eval="[(4, ref('group_linkq_user')), (4, ref('group_shift_report_access')), (4, ref('group_phan_he_lock_settings'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_phan_he_admin')), (4, ref('group_shift_report_access')), (4, ref('group_linkq_manager'))]"/>
    </record>
</odoo>
