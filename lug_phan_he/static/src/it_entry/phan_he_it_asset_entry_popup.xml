<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_phan_he.PhanHeItAssetEntryPopup" owl="1">
        <div class="lq-entry-overlay" t-on-click="onOverlayClick">
            <div class="lq-entry-modal is-excel" t-on-click.stop="">
                <header class="lq-entry-head">
                    <div class="lq-entry-head-text">
                        <h2 t-esc="title"/>
                        <p>Nhập thông tin tài sản Máy chủ — bố cục dạng bảng (desktop)</p>
                    </div>
                    <button type="button" class="lq-entry-close" title="Đóng"
                            t-att-disabled="state.saving"
                            t-on-click="onCancel">
                        <i class="fa fa-times"/>
                    </button>
                </header>

                <t t-if="state.loading">
                    <div class="lq-entry-loading">Đang tải...</div>
                </t>
                <t t-else="">
                    <div class="lq-entry-body">
                        <div class="lq-entry-sheet">
                            <div class="lq-entry-sheet-title">1. Thông tin tài sản</div>
                            <div class="lq-entry-grid">
                                <div class="lq-entry-field">
                                    <label>Loại tài sản <span class="lq-req">*</span></label>
                                    <select t-att-value="state.form.asset_type_id"
                                            t-on-change="onAssetTypeChange">
                                        <option t-att-selected="!state.form.asset_type_id" value="">Chọn loại</option>
                                        <t t-foreach="state.types" t-as="tp" t-key="tp.id">
                                            <option t-att-selected="isSel(tp.id, state.form.asset_type_id)" t-att-value="tp.id" t-esc="tp.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Mã tài sản <span class="lq-req">*</span></label>
                                    <input type="text" readonly="readonly" class="is-ro"
                                           placeholder="Tự sinh khi chọn loại"
                                           t-att-value="state.form.code"
                                           title="Mã tự sinh theo loại tài sản (SRV-0001, NET-0001…)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>
                                        <t t-if="isVirtual">Tên VM <span class="lq-req">*</span></t>
                                        <t t-else="">Tên tài sản <span class="lq-req">*</span></t>
                                    </label>
                                    <input type="text"
                                           t-att-placeholder="isVirtual ? 'VD: VM-ERP-01' : 'VD: Máy chủ vật lý 03'"
                                           t-att-value="state.form.name"
                                           t-on-input="(ev) => this.onField('name', ev)"/>
                                </div>
                                <div t-if="isVirtual" class="lq-entry-field">
                                    <label>Tên máy chủ <span class="lq-req">*</span></label>
                                    <select t-att-value="state.form.host_asset_id"
                                            t-on-change="onHostChange">
                                        <option t-att-selected="!state.form.host_asset_id" value="">— Chọn Dell R530 / Dell R650 —</option>
                                        <t t-foreach="state.hosts" t-as="h" t-key="h.id">
                                            <option t-att-selected="isSel(h.id, state.form.host_asset_id)" t-att-value="h.id" t-esc="hostOptionLabel(h)"/>
                                        </t>
                                    </select>
                                </div>

                                <div class="lq-entry-field">
                                    <label>Hãng sản xuất</label>
                                    <input type="text" placeholder="VD: Dell, Sophos..."
                                           t-att-value="state.form.manufacturer"
                                           t-on-input="(ev) => this.onField('manufacturer', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Model</label>
                                    <input type="text" placeholder="VD: PowerEdge R650"
                                           t-att-value="state.form.model_name"
                                           t-on-input="(ev) => this.onField('model_name', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Serial Number</label>
                                    <input type="text" placeholder="Để trống nếu chưa có"
                                           t-att-value="state.form.serial_number"
                                           t-on-input="(ev) => this.onField('serial_number', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Trạng thái</label>
                                    <select t-att-value="state.form.state"
                                            t-on-change="(ev) => this.onField('state', ev)">
                                        <t t-foreach="assetStates" t-as="st" t-key="st.value">
                                            <option t-att-selected="isSel(st.value, state.form.state)" t-att-value="st.value" t-esc="st.label"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Hợp đồng</label>
                                    <div class="lq-entry-file">
                                        <label class="lq-entry-file-btn">
                                            <i class="fa fa-paperclip"/> Chọn file
                                            <input type="file" class="d-none"
                                                   accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx"
                                                   t-on-change="(ev) => this.onFile('contract', ev)"/>
                                        </label>
                                        <t t-if="state.form.contract_filename">
                                            <a t-if="fileUrl('contract')" class="lq-entry-file-name" t-att-href="fileUrl('contract')"
                                               target="_blank" t-att-title="state.form.contract_filename" t-esc="state.form.contract_filename"/>
                                            <span t-else="" class="lq-entry-file-name" t-att-title="state.form.contract_filename"
                                                  t-esc="state.form.contract_filename"/>
                                            <button type="button" class="lq-entry-file-del" title="Xóa file"
                                                    t-on-click="() => this.clearFile('contract')"><i class="fa fa-times"/></button>
                                        </t>
                                        <span t-else="" class="lq-entry-file-empty">Chưa có file</span>
                                    </div>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Số tiền (VNĐ)</label>
                                    <input type="text" inputmode="numeric" placeholder="VD: 15.000.000"
                                           t-att-value="state.form.contract_amount"
                                           t-on-input="(ev) => this.onAmount(ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Nhà cung cấp</label>
                                    <input type="text" placeholder="Nhập tên nhà cung cấp"
                                           t-att-value="state.form.supplier_name"
                                           t-on-input="(ev) => this.onField('supplier_name', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Hóa đơn</label>
                                    <div class="lq-entry-file">
                                        <label class="lq-entry-file-btn">
                                            <i class="fa fa-paperclip"/> Chọn file
                                            <input type="file" class="d-none"
                                                   accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx"
                                                   t-on-change="(ev) => this.onFile('invoice', ev)"/>
                                        </label>
                                        <t t-if="state.form.invoice_filename">
                                            <a t-if="fileUrl('invoice')" class="lq-entry-file-name" t-att-href="fileUrl('invoice')"
                                               target="_blank" t-att-title="state.form.invoice_filename" t-esc="state.form.invoice_filename"/>
                                            <span t-else="" class="lq-entry-file-name" t-att-title="state.form.invoice_filename"
                                                  t-esc="state.form.invoice_filename"/>
                                            <button type="button" class="lq-entry-file-del" title="Xóa file"
                                                    t-on-click="() => this.clearFile('invoice')"><i class="fa fa-times"/></button>
                                        </t>
                                        <span t-else="" class="lq-entry-file-empty">Chưa có file</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="lq-entry-sheet">
                            <div class="lq-entry-sheet-title">2. Vị trí &amp; phụ trách</div>
                            <div class="lq-entry-grid">
                                <div class="lq-entry-field">
                                    <label>Vị trí lắp đặt</label>
                                    <input type="text" placeholder="Rack / phòng máy..."
                                           t-att-value="state.form.location"
                                           t-on-input="(ev) => this.onField('location', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Khu vực / Miền</label>
                                    <select t-att-value="state.form.mien_id"
                                            t-on-change="(ev) => this.onField('mien_id', ev)">
                                        <option t-att-selected="!state.form.mien_id" value="">— Chọn —</option>
                                        <t t-foreach="state.miens" t-as="m" t-key="m.id">
                                            <option t-att-selected="isSel(m.id, state.form.mien_id)" t-att-value="m.id" t-esc="m.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Đơn vị / Cửa hàng</label>
                                    <select t-att-value="state.form.store_id"
                                            t-on-change="(ev) => this.onField('store_id', ev)">
                                        <option t-att-selected="!state.form.store_id" value="">— Chọn —</option>
                                        <t t-foreach="state.stores" t-as="s" t-key="s.id">
                                            <option t-att-selected="isSel(s.id, state.form.store_id)" t-att-value="s.id" t-esc="s.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Ngày mua / bắt đầu</label>
                                    <input type="text" placeholder="dd/mm/yyyy"
                                           t-att-value="state.form.date_start"
                                           t-on-input="(ev) => this.onField('date_start', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Người phụ trách</label>
                                    <select t-att-value="state.form.responsible_id"
                                            t-on-change="(ev) => this.onField('responsible_id', ev)">
                                        <option t-att-selected="!state.form.responsible_id" value="">— Chọn —</option>
                                        <t t-foreach="state.employees" t-as="e" t-key="e.id">
                                            <option t-att-selected="isSel(e.id, state.form.responsible_id)" t-att-value="e.id" t-esc="e.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="lq-entry-field is-span-3">
                                    <label>Ghi chú</label>
                                    <input type="text" placeholder="Ghi chú..."
                                           t-att-value="state.form.note"
                                           t-on-input="(ev) => this.onField('note', ev)"/>
                                </div>
                            </div>
                        </div>

                        <div class="lq-entry-sheet">
                            <div class="lq-entry-sheet-title" t-esc="techSectionTitle"/>
                            <t t-if="!selectedTypeCode">
                                <p class="lq-entry-hint">Chọn loại tài sản ở mục 1 để hiện các trường kỹ thuật phù hợp.</p>
                            </t>
                            <div t-if="isPhysical" class="lq-entry-grid">
                                <div class="lq-entry-field">
                                    <label>CPU</label>
                                    <input type="text" t-att-value="state.form.cpu_info"
                                           t-on-input="(ev) => this.onField('cpu_info', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>RAM (GB)</label>
                                    <input type="number" min="0" step="1" t-att-value="state.form.ram_gb"
                                           t-on-input="(ev) => this.onField('ram_gb', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Lưu trữ (GB)</label>
                                    <input type="number" min="0" step="1" t-att-value="state.form.storage_gb"
                                           t-on-input="(ev) => this.onField('storage_gb', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>RAID</label>
                                    <input type="text" t-att-value="state.form.raid_info"
                                           t-on-input="(ev) => this.onField('raid_info', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Card mạng</label>
                                    <input type="text" t-att-value="state.form.nic_info"
                                           t-on-input="(ev) => this.onField('nic_info', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>vCPUs</label>
                                    <input type="text" t-att-value="state.form.hypervisor"
                                           t-on-input="(ev) => this.onField('hypervisor', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Hết hạn bảo hành</label>
                                    <input type="text" placeholder="dd/mm/yyyy"
                                           t-att-value="state.form.warranty_end"
                                           t-on-input="(ev) => this.onField('warranty_end', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Địa chỉ IP</label>
                                    <input type="text" placeholder="Để trống nếu chưa có"
                                           t-att-value="state.form.ip_address"
                                           t-on-input="(ev) => this.onField('ip_address', ev)"/>
                                </div>
                            </div>
                            <div t-if="isVirtual" class="lq-entry-grid">
                                <div class="lq-entry-field">
                                    <label>Tên VM (chi tiết)</label>
                                    <input type="text" t-att-value="state.form.vm_name"
                                           t-on-input="(ev) => this.onField('vm_name', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>vCPUs</label>
                                    <input type="text" t-att-value="state.form.hypervisor"
                                           t-on-input="(ev) => this.onField('hypervisor', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>CPU</label>
                                    <input type="text" t-att-value="state.form.cpu_info"
                                           t-on-input="(ev) => this.onField('cpu_info', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>RAM (GB)</label>
                                    <input type="number" min="0" t-att-value="state.form.ram_gb"
                                           t-on-input="(ev) => this.onField('ram_gb', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Dung lượng SSD (GB)</label>
                                    <input type="number" min="0" t-att-value="state.form.storage_gb"
                                           t-on-input="(ev) => this.onField('storage_gb', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Dung lượng HDD (GB)</label>
                                    <input type="number" min="0" t-att-value="state.form.hdd_gb"
                                           t-on-input="(ev) => this.onField('hdd_gb', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Địa chỉ IP</label>
                                    <input type="text" t-att-value="state.form.ip_address"
                                           t-on-input="(ev) => this.onField('ip_address', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>IP WAN</label>
                                    <input type="text" placeholder="Để trống nếu chưa có"
                                           t-att-value="state.form.ip_wan"
                                           t-on-input="(ev) => this.onField('ip_wan', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>User</label>
                                    <input type="text" t-att-value="state.form.login_user"
                                           t-on-input="(ev) => this.onField('login_user', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Pass</label>
                                    <input type="text" t-att-value="state.form.login_password"
                                           t-on-input="(ev) => this.onField('login_password', ev)"/>
                                </div>
                                <div class="lq-entry-field lq-entry-field-full">
                                    <label>Ghi chú</label>
                                    <input type="text" t-att-value="state.form.note"
                                           t-on-input="(ev) => this.onField('note', ev)"/>
                                </div>
                            </div>
                            <div t-if="isCloud" class="lq-entry-grid">
                                <div class="lq-entry-field">
                                    <label>Nhà cung cấp cloud</label>
                                    <input type="text" placeholder="AWS / Azure / GCP..."
                                           t-att-value="state.form.cloud_provider"
                                           t-on-input="(ev) => this.onField('cloud_provider', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Tài khoản / Subscription</label>
                                    <input type="text" t-att-value="state.form.cloud_account"
                                           t-on-input="(ev) => this.onField('cloud_account', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Region</label>
                                    <input type="text" t-att-value="state.form.cloud_region"
                                           t-on-input="(ev) => this.onField('cloud_region', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Loại dịch vụ</label>
                                    <input type="text" t-att-value="state.form.cloud_service_type"
                                           t-on-input="(ev) => this.onField('cloud_service_type', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Chu kỳ thanh toán</label>
                                    <select t-att-value="state.form.cloud_billing_cycle"
                                            t-on-change="(ev) => this.onField('cloud_billing_cycle', ev)">
                                        <t t-foreach="cloudBilling" t-as="cb" t-key="cb.value || 'empty'">
                                            <option t-att-selected="isSel(cb.value, state.form.cloud_billing_cycle)" t-att-value="cb.value" t-esc="cb.label"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Ngân sách dự kiến</label>
                                    <input type="number" min="0" step="1000" placeholder="0"
                                           t-att-value="state.form.cloud_budget"
                                           t-on-input="(ev) => this.onField('cloud_budget', ev)"/>
                                </div>
                            </div>
                            <div t-if="isNetwork" class="lq-entry-grid">
                                <div class="lq-entry-field">
                                    <label>Địa chỉ quản trị</label>
                                    <input type="text" placeholder="https://... (nếu được phép)"
                                           t-att-value="state.form.admin_url"
                                           t-on-input="(ev) => this.onField('admin_url', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Hết hạn bảo hành</label>
                                    <input type="text" placeholder="dd/mm/yyyy"
                                           t-att-value="state.form.warranty_end"
                                           t-on-input="(ev) => this.onField('warranty_end', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Hết hạn license</label>
                                    <input type="text" placeholder="dd/mm/yyyy"
                                           t-att-value="state.form.license_end"
                                           t-on-input="(ev) => this.onField('license_end', ev)"/>
                                </div>
                                <div class="lq-entry-field">
                                    <label>Firmware</label>
                                    <input type="text" t-att-value="state.form.firmware_version"
                                           t-on-input="(ev) => this.onField('firmware_version', ev)"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <footer class="lq-entry-foot">
                        <button type="button" class="lq-entry-btn is-cancel"
                                t-att-disabled="state.saving"
                                t-on-click="onCancel">
                            <i class="fa fa-times"/> Hủy
                        </button>
                        <button type="button" class="lq-entry-btn is-save"
                                t-att-disabled="state.saving"
                                t-on-click="onSave">
                            <i class="fa fa-save"/>
                            <t t-if="state.saving">Đang lưu...</t>
                            <t t-else="">Lưu tài sản</t>
                        </button>
                    </footer>
                </t>
            </div>
        </div>
    </t>
</templates>
