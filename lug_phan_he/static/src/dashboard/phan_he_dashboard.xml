<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_phan_he.PhanHeDashboard">
        <div class="o_phan_he_shell o_action">
            <aside class="o_phan_he_sidebar">
                <div class="o_phan_he_sidebar_brand" t-on-click="() => this.onOverview()" role="button" title="Tổng quan">
                    <span class="o_phan_he_brand_text">DỊCH VỤ INTERNET</span>
                </div>
                <nav class="o_phan_he_sidebar_nav">
                    <button type="button"
                            class="o_phan_he_nav_item"
                            t-att-class="state.activeNav === 'overview' ? 'is-active' : ''"
                            t-on-click="() => this.onOverview()">
                        <i class="fa fa-home"/>
                        <span>Tổng quan</span>
                    </button>

                    <t t-foreach="navSections" t-as="section" t-key="section.id">
                        <div class="o_phan_he_nav_group"
                             t-att-class="isGroupOpen(section.id) ? 'is-open' : ''">
                            <button type="button"
                                    class="o_phan_he_nav_section"
                                    t-on-click="() => this.toggleGroup(section.id)">
                                <i t-att-class="'fa ' + section.icon"/>
                                <span t-esc="section.label"/>
                                <t t-if="section.id === 'alerts' and alertCount > 0">
                                    <span class="o_phan_he_nav_badge" t-esc="alertCount"/>
                                </t>
                                <i class="fa fa-angle-down o_phan_he_nav_caret"/>
                            </button>
                            <t t-if="isGroupOpen(section.id)">
                                <t t-foreach="section.children" t-as="child" t-key="child.id">
                                    <button type="button"
                                            class="o_phan_he_nav_sub"
                                            t-att-class="navChildClass(child)"
                                            t-on-click="() => this.onNavChild(child)">
                                        <i t-att-class="'fa ' + (child.icon || 'fa-circle-o')"
                                           t-att-style="child.iconColor ? ('color:' + child.iconColor) : null"/>
                                        <span t-esc="child.label"/>
                                        <t t-if="child.badgeKey">
                                            <b t-esc="state.data[child.badgeKey] || 0"/>
                                        </t>
                                    </button>
                                </t>
                            </t>
                        </div>
                    </t>
                </nav>
            </aside>

            <div class="o_phan_he_dashboard">
                <div class="o_phan_he_dash_top">
                    <div>
                        <h1>
                            <t t-if="state.activeNav === 'reports'">
                                <t t-if="state.reportPeriod === 'month'">Báo cáo chi phí tháng</t>
                                <t t-elif="state.reportPeriod === 'quarter'">Báo cáo chi phí quý</t>
                                <t t-else="">Báo cáo chi phí năm</t>
                            </t>
                            <t t-else="">Dashboard <t t-esc="appTitle"/></t>
                        </h1>
                        <p>
                            <t t-esc="appTitle"/> · Cập nhật
                            <t t-esc="state.data.updated_at || '—'"/>
                        </p>
                    </div>
                    <div class="o_phan_he_dash_user">
                        <span class="o_phan_he_avatar"><i class="fa fa-user"/></span>
                        <div>
                            <strong t-esc="state.data.user_name || 'Administrator'"/>
                            <small t-esc="state.data.role_label || ''"/>
                        </div>
                    </div>
                </div>

                <t t-if="state.loading">
                    <div class="o_phan_he_dash_loading">Đang tải dữ liệu...</div>
                </t>
                <t t-else="">
                    <t t-if="state.activeNav === 'reports'">
                    <section class="o_phan_he_section o_phan_he_payment_report">
                        <h2 class="o_phan_he_section_title">
                            <span class="o_phan_he_section_num">BC</span>
                            Báo cáo theo trạng thái thanh toán
                        </h2>
                        <p class="o_phan_he_panel_hint">
                            4 danh sách tách khung theo trạng thái · click dòng để mở phiếu thanh toán
                        </p>
                        <div class="o_phan_he_pay_report_grid">
                            <t t-foreach="state.paymentReport.tables or []" t-as="table" t-key="table.key">
                                <div class="o_phan_he_pay_report_col"
                                     t-att-class="'is-' + (table.tone || table.key)">
                                    <div class="o_phan_he_pay_report_head">
                                        <div>
                                            <strong t-esc="table.title"/>
                                            <small>
                                                <t t-esc="table.count"/> phiếu ·
                                                <t t-esc="formatMoneyVnd(table.total)"/>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="o_phan_he_pay_report_body">
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Cửa hàng</th>
                                                    <th class="num">Số tiền</th>
                                                    <th>Hạn TT</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="!(table.rows || []).length">
                                                    <tr>
                                                        <td colspan="3" class="o_phan_he_empty">Không có dữ liệu</td>
                                                    </tr>
                                                </t>
                                                <t t-foreach="table.rows or []" t-as="row" t-key="row.id">
                                                    <tr class="is-clickable" t-on-click="() => this.openPayment(row)">
                                                        <td>
                                                            <div class="o_phan_he_pay_store" t-esc="row.store || '—'"/>
                                                            <small t-esc="row.code"/>
                                                        </td>
                                                        <td class="num" t-esc="formatNumber(row.amount)"/>
                                                        <td>
                                                            <t t-esc="formatIsoDate(table.key === 'paid' ? row.date_paid : row.date_due)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </section>
                    </t>
                    <t t-else="">
                    <!-- 1. Thống kê chi phí theo miền -->
                    <section class="o_phan_he_section">
                        <h2 class="o_phan_he_section_title">
                            <span class="o_phan_he_section_num">1</span>
                            Thống kê chi phí theo miền (tháng hiện tại)
                        </h2>
                        <div class="o_phan_he_region_kpis">
                            <t t-foreach="state.data.region_kpis or []" t-as="kpi" t-key="kpi.id">
                                <div class="o_phan_he_region_card"
                                     t-att-class="regionTone(kpi.code, kpi_index)"
                                     t-att-style="'--accent:' + (kpi.color || '#64748b')">
                                    <div class="o_phan_he_region_label" t-esc="kpi.title"/>
                                    <div class="o_phan_he_region_amount" t-esc="formatMoneyVnd(kpi.amount)"/>
                                </div>
                            </t>
                        </div>
                    </section>

                    <!-- 2. Cảnh báo -->
                    <section class="o_phan_he_section">
                        <h2 class="o_phan_he_section_title">
                            <span class="o_phan_he_section_num">2</span>
                            Cảnh báo &amp; trạng thái hợp đồng
                        </h2>
                        <div class="o_phan_he_alert_cards">
                            <t t-foreach="state.data.alert_cards or []" t-as="card" t-key="card.id">
                                <button type="button"
                                        class="o_phan_he_alert_card"
                                        t-att-class="'is-' + card.level"
                                        t-on-click="() => this.onAlertClick(card)">
                                    <div class="o_phan_he_alert_card_head">
                                        <i t-att-class="'fa ' + card.icon"/>
                                        <span t-esc="card.title"/>
                                    </div>
                                    <div class="o_phan_he_alert_card_count">
                                        <strong t-esc="padCount(card.count)"/>
                                        <span t-esc="card.unit"/>
                                    </div>
                                    <div class="o_phan_he_alert_card_break">
                                        <t t-foreach="card.breakdown or []" t-as="b" t-key="b.id">
                                            <span>
                                                <i class="fa fa-circle" t-att-style="'color:' + b.color"/>
                                                <t t-esc="b.short"/>: <b t-esc="b.count"/>
                                            </span>
                                        </t>
                                    </div>
                                </button>
                            </t>
                        </div>
                    </section>

                    <!-- 3. Charts -->
                    <section class="o_phan_he_section">
                        <h2 class="o_phan_he_section_title">
                            <span class="o_phan_he_section_num">3</span>
                            Trực quan hóa dữ liệu
                        </h2>

                        <div class="o_phan_he_panel o_phan_he_chart_trend o_phan_he_chart_trend_wide">
                            <div class="o_phan_he_chart_head">
                                <h3>
                                    <i class="fa fa-line-chart"/>
                                    Xu hướng chi phí Internet — 12 tháng
                                </h3>
                                <span class="o_phan_he_chart_unit">Đơn vị: Triệu VNĐ</span>
                            </div>
                            <div class="o_phan_he_trend_legend">
                                <t t-foreach="state.data.trend_series or []" t-as="s" t-key="s.id">
                                    <div class="o_phan_he_trend_legend_item">
                                        <span class="o_phan_he_dot" t-att-style="'background:' + s.color"/>
                                        <span t-esc="s.name"/>
                                    </div>
                                </t>
                            </div>
                            <t t-set="chart" t-value="multiLineTrendChart()"/>
                            <div class="o_phan_he_trend_svg_wrap"
                                 t-on-mouseleave="onTrendLeave">
                                <svg class="o_phan_he_multiline_chart"
                                     t-att-viewBox="'0 0 ' + chart.W + ' ' + chart.H"
                                     width="100%"
                                     height="280"
                                     preserveAspectRatio="xMidYMid meet">
                                    <t t-foreach="chart.grid" t-as="g" t-key="g_index">
                                        <line t-att-x1="chart.padL"
                                              t-att-x2="chart.padL + chart.cw"
                                              t-att-y1="g.y"
                                              t-att-y2="g.y"
                                              class="o_phan_he_grid_line"/>
                                        <text t-att-x="chart.padL - 8"
                                              t-att-y="g.y + 3"
                                              class="o_phan_he_axis_y"
                                              text-anchor="end"
                                              t-esc="g.label"/>
                                    </t>

                                    <t t-if="chart.tooltip">
                                        <line t-att-x1="chart.tooltip.x"
                                              t-att-x2="chart.tooltip.x"
                                              t-att-y1="chart.padT"
                                              t-att-y2="chart.baselineY"
                                              class="o_phan_he_hover_guide"/>
                                    </t>

                                    <t t-foreach="chart.lines" t-as="line" t-key="'ln-' + line.id">
                                        <polyline fill="none"
                                                  t-att-stroke="line.color"
                                                  t-att-stroke-width="line.isTotal ? 3 : 2.2"
                                                  stroke-linejoin="round"
                                                  stroke-linecap="round"
                                                  t-att-points="line.linePoints"/>
                                        <t t-foreach="line.dots" t-as="dot" t-key="dot_index">
                                            <circle t-att-cx="dot.x"
                                                    t-att-cy="dot.y"
                                                    r="3.5"
                                                    t-att-fill="line.color"
                                                    stroke="#fff"
                                                    stroke-width="1.6"/>
                                        </t>
                                    </t>

                                    <t t-foreach="chart.xLabels" t-as="xl" t-key="xl_index">
                                        <text t-att-x="xl.x"
                                              t-att-y="chart.H - 10"
                                              class="o_phan_he_axis_x"
                                              text-anchor="middle"
                                              t-esc="xl.text"/>
                                    </t>

                                    <t t-foreach="chart.hitZones" t-as="hz" t-key="'hz-' + hz.index">
                                        <rect t-att-x="hz.x"
                                              t-att-y="chart.padT"
                                              t-att-width="hz.width"
                                              t-att-height="chart.ch"
                                              fill="transparent"
                                              class="o_phan_he_trend_hit"
                                              t-on-mouseenter="() => this.onTrendHover(hz.index)"/>
                                    </t>
                                </svg>

                                <div t-if="chart.tooltip" class="o_phan_he_trend_tooltip"
                                     t-att-style="'left:' + ((chart.tooltip.x / chart.W) * 100) + '%'">
                                    <strong t-esc="chart.tooltip.label"/>
                                    <t t-foreach="chart.tooltip.items" t-as="it" t-key="'tip-' + it.id">
                                        <div class="o_phan_he_trend_tip_row">
                                            <span class="o_phan_he_dot" t-att-style="'background:' + it.color"/>
                                            <span t-esc="it.name"/>
                                            <b t-esc="formatMoneyVnd(it.value)"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="o_phan_he_charts_bottom">
                            <div class="o_phan_he_panel o_phan_he_chart_bars">
                                <div class="o_phan_he_chart_head">
                                    <h3>
                                        <i class="fa fa-bar-chart"/>
                                        Cơ cấu chi phí theo miền
                                        <t t-if="state.data.current_month">
                                            (Tháng <t t-esc="monthLabelPad()"/>)
                                        </t>
                                    </h3>
                                </div>
                                <div class="o_phan_he_hbar_list">
                                    <t t-foreach="costStructureRows()" t-as="row" t-key="row.id">
                                        <div class="o_phan_he_hbar_row">
                                            <div class="o_phan_he_hbar_label">
                                                <span class="o_phan_he_dot" t-att-style="'background:' + row.color"/>
                                                <span t-esc="row.name"/>
                                            </div>
                                            <div class="o_phan_he_hbar_track">
                                                <div class="o_phan_he_hbar_fill"
                                                     t-att-style="'width:' + row.pct + '%;background:' + row.color"/>
                                            </div>
                                            <div class="o_phan_he_hbar_vals">
                                                <b t-esc="formatMoneyVnd(row.amount)"/>
                                                <span t-esc="row.pct + '%'"/>
                                            </div>
                                        </div>
                                    </t>
                                    <div t-if="!(costStructureRows() || []).length" class="o_phan_he_empty">
                                        Không có dữ liệu
                                    </div>
                                </div>
                            </div>

                            <div class="o_phan_he_panel o_phan_he_chart_top">
                                <div class="o_phan_he_chart_head">
                                    <h3>
                                        <i class="fa fa-trophy"/>
                                        Top 5 chi nhánh chi phí cao
                                    </h3>
                                </div>
                                <div class="o_phan_he_hbar_list">
                                    <t t-foreach="topBranchRows()" t-as="row" t-key="row.id">
                                        <div class="o_phan_he_hbar_row is-purple">
                                            <div class="o_phan_he_hbar_label">
                                                <span class="o_phan_he_rank" t-esc="row_index + 1"/>
                                                <span t-esc="row.name"/>
                                            </div>
                                            <div class="o_phan_he_hbar_track">
                                                <div class="o_phan_he_hbar_fill is-grad"
                                                     t-att-style="'width:' + row.pct + '%'"/>
                                            </div>
                                            <div class="o_phan_he_hbar_vals">
                                                <b t-esc="formatMoneyVnd(row.amount)"/>
                                            </div>
                                        </div>
                                    </t>
                                    <div t-if="!(topBranchRows() || []).length" class="o_phan_he_empty">
                                        Không có dữ liệu
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 4. Bảng tổng hợp -->
                    <section class="o_phan_he_section">
                        <div class="o_phan_he_section_head_row">
                            <h2 class="o_phan_he_section_title">
                                <span class="o_phan_he_section_num">4</span>
                                Bảng tổng hợp chi phí chi tiết từ tháng 1 đến tháng 12
                                <small>(Đơn vị: VNĐ)</small>
                            </h2>
                            <div class="o_phan_he_year_tools">
                                <label class="o_phan_he_year_filter">
                                    Năm
                                    <select t-att-value="state.filters.year" t-on-change="onYearChange">
                                        <t t-foreach="yearOptions" t-as="y" t-key="y">
                                            <option t-att-value="y"
                                                    t-att-selected="y === state.filters.year"
                                                    t-esc="y"/>
                                        </t>
                                    </select>
                                </label>
                                <button type="button"
                                        class="btn btn-primary o_phan_he_btn_export_excel"
                                        t-on-click="onExportExcel"
                                        t-att-disabled="state.exporting">
                                    <i class="fa fa-file-excel-o"/>
                                    <t t-if="state.exporting">Đang xuất...</t>
                                    <t t-else="">Xuất Excel</t>
                                </button>
                            </div>
                        </div>
                        <div class="o_phan_he_panel o_phan_he_year_panel">
                            <div class="table-responsive">
                                <table class="o_phan_he_year_table">
                                    <thead>
                                        <tr>
                                            <th class="col-month">Tháng</th>
                                            <t t-foreach="state.data.mien_meta or []" t-as="m" t-key="m.id">
                                                <th class="num col-money">Chi phí <t t-esc="m.name"/></th>
                                            </t>
                                            <th class="num col-money">Tổng chi phí</th>
                                            <th class="col-status">Trạng thái / Lưu ý</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.data.monthly_table or []" t-as="row" t-key="row.month">
                                            <tr t-att-class="row.is_current ? 'is-current' : ''">
                                                <td class="col-month">
                                                    <t t-esc="row.label"/>
                                                    <t t-if="row.is_current"> ★</t>
                                                </td>
                                                <t t-foreach="row.amounts or []" t-as="a" t-key="a.mien_id">
                                                    <td class="num col-money" t-esc="formatNumber(a.amount)"/>
                                                </t>
                                                <td class="num total col-money" t-esc="formatNumber(row.total)"/>
                                                <td class="col-status">
                                                    <span class="o_phan_he_status_pill"
                                                          t-att-class="'is-' + row.status"
                                                          t-esc="row.status_label"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th class="col-month">LŨY KẾ</th>
                                            <t t-foreach="state.data.year_totals or []" t-as="yt" t-key="yt.mien_id">
                                                <th class="num col-money" t-esc="formatNumber(yt.amount)"/>
                                            </t>
                                            <th class="num col-money" t-esc="formatNumber(state.data.year_grand_total)"/>
                                            <th class="col-status">Tổng cả năm</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </section>
                    </t>
                </t>
            </div>
        </div>
    </t>
</templates>
