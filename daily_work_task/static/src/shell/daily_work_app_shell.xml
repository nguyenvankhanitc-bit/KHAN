<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkAppShell">
        <div t-attf-class="o_dwd_shell {{ shellClassName }}">
            <header class="o_dwd_topbar">
                <div class="o_dwd_topbar_left">
                    <!-- Điện thoại: nút ≡ mở menu Công việc (thay nút «Menu» trên thanh tím) -->
                    <button type="button"
                            class="o_dwd_burger o_dwd_burger_mobile d-inline-flex d-lg-none"
                            title="Menu Công việc"
                            t-on-click="openMobileNav">
                        <i class="fa fa-bars"/>
                    </button>
                    <button type="button"
                            class="o_dwd_burger d-none d-lg-inline-flex"
                            t-on-click="toggleSidebar"
                            t-att-title="state.sidebarCollapsed ? 'Mở rộng thanh bên' : 'Thu gọn thanh bên'"
                            t-att-aria-expanded="(!state.sidebarCollapsed).toString()">
                        <i t-att-class="state.sidebarCollapsed ? 'fa fa-indent' : 'fa fa-bars'"/>
                    </button>
                    <strong class="o_dwd_brand">CÔNG VIỆC</strong>
                </div>
                <nav class="o_dwd_topnav">
                    <button type="button"
                            t-att-class="'o_dwd_topnav_item' + (isActive('employee_ws') ? ' active' : '')"
                            t-on-click="() => this.openNav('employee_ws')">
                        <i class="fa fa-pencil-square-o"/><span>Quản lý công việc</span>
                    </button>
                    <button type="button"
                            t-att-class="'o_dwd_topnav_item' + (isActive('projects') ? ' active' : '')"
                            t-on-click="() => this.openNav('projects')"
                            title="Dự án (Tôi phụ trách)">
                        <i class="fa fa-folder-open-o"/><span>Dự án</span>
                    </button>
                    <button type="button"
                            t-att-class="'o_dwd_topnav_item' + (isActive('projects_supervisor') ? ' active' : '')"
                            t-on-click="() => this.openNav('projects_supervisor')"
                            title="Dự án (Tôi giám sát)">
                        <i class="fa fa-eye"/><span>Giám sát DA</span>
                    </button>
                    <button type="button" class="o_dwd_topnav_item" t-on-click="() => this.openNav('today')">
                        <i class="fa fa-sun-o"/><span>Hôm nay</span>
                        <t t-if="kpi.today"><em class="o_dwd_nav_badge" t-esc="kpi.today"/></t>
                    </button>
                    <t t-if="state.canAssign">
                        <button type="button" class="o_dwd_topnav_item" t-on-click="() => this.openNav('assign')">
                            <i class="fa fa-share-square-o"/><span>Giao việc</span>
                        </button>
                    </t>
                    <t t-if="state.canViewOthers">
                        <button type="button" t-att-class="'o_dwd_topnav_item' + (isActive('viewer') ? ' active' : '')" t-on-click="() => this.openNav('viewer')">
                            <i class="fa fa-eye"/><span>Xem CV NV</span>
                        </button>
                    </t>
                    <t t-if="state.canViewChecklist">
                        <button type="button" t-att-class="'o_dwd_topnav_item' + (isActive('team_checklist') ? ' active' : '')" t-on-click="() => this.openNav('team_checklist')">
                            <i class="fa fa-check-square-o"/><span>Kiểm tra CV</span>
                        </button>
                    </t>
                    <t t-if="state.canViewOthers">
                        <button type="button" class="o_dwd_topnav_item" t-on-click="() => this.openNav('report')">
                            <i class="fa fa-bar-chart"/><span>BC tổng</span>
                        </button>
                    </t>
                    <button type="button"
                            t-att-class="'o_dwd_topnav_item' + (isActive('overview') ? ' active' : '')"
                            t-on-click="() => this.openNav('overview')">
                        <i class="fa fa-user-circle"/><span>BC cá nhân</span>
                    </button>
                    <button type="button"
                            t-att-class="'o_dwd_topnav_item' + (isActive('team_report') ? ' active' : '')"
                            t-on-click="() => this.openNav('team_report')">
                        <i class="fa fa-users"/><span>CV chi tiết team</span>
                    </button>
                    <t t-if="state.canAssignAdd">
                        <button type="button"
                                t-att-class="'o_dwd_topnav_item' + (isActive('team_assign_add') ? ' active' : '')"
                                t-on-click="() => this.openNav('team_assign_add')">
                            <i class="fa fa-plus-square"/><span>Thêm phân công</span>
                        </button>
                    </t>
                    <t t-if="state.canAssignList">
                        <button type="button"
                                t-att-class="'o_dwd_topnav_item' + (isActive('team_assign_list') || isActive('team_assign') ? ' active' : '')"
                                t-on-click="() => this.openNav('team_assign_list')">
                            <i class="fa fa-list-alt"/><span>DS phân công</span>
                        </button>
                        <button type="button"
                                t-att-class="'o_dwd_topnav_item' + (isActive('team_plan') ? ' active' : '')"
                                t-on-click="() => this.openNav('team_plan')">
                            <i class="fa fa-calendar-check-o"/><span>Plan team</span>
                        </button>
                    </t>
                    <t t-if="state.canSeePerformance">
                        <button type="button" t-att-class="'o_dwd_topnav_item' + (isActive('performance') ? ' active' : '')" t-on-click="() => this.openNav('performance')">
                            <i class="fa fa-line-chart"/><span>Hiệu suất</span>
                        </button>
                    </t>
                    <t t-if="state.isManager">
                        <button type="button" class="o_dwd_topnav_item" t-on-click="() => this.openNav('kpi')">
                            <i class="fa fa-trophy"/><span>BC KPI</span>
                        </button>
                    </t>
                    <button type="button" class="o_dwd_topnav_item" t-on-click="() => this.openNav('overdue')">
                        <i class="fa fa-exclamation-triangle"/><span>Quá hạn</span>
                        <t t-if="kpi.overdue"><em class="o_dwd_nav_badge" t-esc="kpi.overdue"/></t>
                    </button>
                </nav>
                <div class="o_dwd_topbar_right">
                    <button type="button" class="o_dwd_notif" title="Việc quá hạn"
                            t-on-click="() => this.openNav('overdue')">
                        <i class="fa fa-bell"/>
                        <t t-if="kpi.overdue">
                            <em class="o_dwd_badge red" t-esc="kpi.overdue"/>
                        </t>
                    </button>
                </div>
            </header>

            <div class="o_dwd_body">
                <div t-if="state.mobileNavOpen"
                     class="o_dwd_offcanvas_backdrop d-lg-none"
                     t-on-click="closeMobileNav"/>
                <aside t-att-class="sidebarClass" t-att-style="sidebarStyle">
                    <div class="o_dwd_offcanvas_header d-flex d-lg-none align-items-center justify-content-between">
                        <strong class="o_dwd_offcanvas_title">Menu Công việc</strong>
                        <button type="button" class="btn btn-sm btn-light" t-on-click="closeMobileNav" aria-label="Đóng">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div class="o_dwd_side_section">
                        <div class="o_dwd_side_label">📌 CÔNG VIỆC</div>
                        <button type="button"
                                t-att-class="'o_dwd_side_item' + (isActive('employee_ws') ? ' active' : '')"
                                title="Quản lý công việc"
                                t-on-click="() => this.openNav('employee_ws')">
                            <i class="fa fa-pencil-square-o"/><span>Quản lý công việc</span>
                        </button>
                        <button type="button"
                                t-att-class="'o_dwd_side_item' + (isActive('projects') ? ' active' : '')"
                                title="Dự án (Tôi phụ trách)"
                                t-on-click="() => this.openNav('projects')">
                            <i class="fa fa-folder-open-o"/><span>Dự án (Tôi phụ trách)</span>
                        </button>
                        <button type="button"
                                t-att-class="'o_dwd_side_item' + (isActive('projects_supervisor') ? ' active' : '')"
                                title="Dự án (Tôi giám sát)"
                                t-on-click="() => this.openNav('projects_supervisor')">
                            <i class="fa fa-eye"/><span>Dự án (Tôi giám sát)</span>
                        </button>
                        <button t-if="state.canTeamwork" type="button" t-att-class="'o_dwd_side_item' + (isActive('team_work') ? ' active' : '')" title="Phân công việc team"
                                t-on-click="() => this.openNav('team_work')">
                            <i class="fa fa-share-alt"/><span>Phân công việc team</span>
                        </button>
                        <button type="button"
                                t-att-class="'o_dwd_side_item' + (isActive('plan') ? ' active' : '')"
                                title="Plan CV cá nhân"
                                t-on-click="() => this.openNav('plan')">
                            <i class="fa fa-th"/><span>Plan CV cá nhân</span>
                        </button>
                        <t t-if="state.canTeamPlan">
                            <button type="button"
                                    t-att-class="'o_dwd_side_item' + (isActive('team_plan') ? ' active' : '')"
                                    title="Plan tổng team"
                                    t-on-click="() => this.openNav('team_plan')">
                                <i class="fa fa-calendar-check-o"/><span>Plan tổng team</span>
                            </button>
                        </t>
                        <!-- Công việc hôm nay / Giao việc / Xem CV NV / Checklist CV team / Kanban: chuyển vào thanh tab trang Quản lý công việc -->
                        <button type="button" class="o_dwd_side_item" title="Công việc quá hạn"
                                t-on-click="() => this.openNav('overdue')">
                            <i class="fa fa-exclamation-triangle"/><span>Công việc quá hạn</span>
                            <t t-if="kpi.overdue"><em class="o_dwd_side_count" t-esc="kpi.overdue"/></t>
                        </button>
                        <button type="button" class="o_dwd_side_item" title="Nhắc việc"
                                t-on-click="() => this.openNav('reminders')">
                            <i class="fa fa-bell-o"/><span>Nhắc việc</span>
                            <t t-if="reminderCount">
                                <em class="o_dwd_side_count" t-esc="reminderCount"/>
                            </t>
                        </button>
                    </div>
                    <div t-att-class="'o_dwd_side_section o_dwr_side' + (state.reportOpen ? '' : ' is-closed')">
                        <button type="button" class="o_dwr_side_head" t-if="reportTabs.length"
                                t-att-aria-expanded="state.reportOpen ? 'true' : 'false'"
                                title="Thu gọn / mở rộng BÁO CÁO"
                                t-on-click="toggleReportSection">
                            <i class="fa fa-bar-chart o_dwr_side_icon"/><span>BÁO CÁO</span>
                            <i t-att-class="'fa o_dwr_side_chev ' + (state.reportOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/>
                        </button>
                        <button type="button" t-if="reportTabs.length"
                                t-att-class="'o_dwd_side_item' + (activeReportTab ? ' active' : '')"
                                title="Các loại báo cáo"
                                t-on-click="openReportMenu">
                            <i class="fa fa-th-list"/><span>Các loại báo cáo</span>
                            <em class="o_dwd_side_count o_dwr_side_n" t-esc="reportTabs.length"/>
                        </button>
                    </div>
                    <t t-if="state.canAssignSection">
                        <div class="o_dwd_side_section">
                            <div class="o_dwd_side_label">📋 PHÂN CÔNG CÔNG VIỆC</div>
                            <!-- Đã bỏ: dùng nút «Phân công hạng mục» trên Danh sách phân công -->
                            <t t-if="false">
                                <button type="button"
                                        t-att-class="'o_dwd_side_item' + (isActive('team_assign_add') ? ' active' : '')"
                                        title="Thêm phân công công việc"
                                        t-on-click="() => this.openNav('team_assign_add')">
                                    <i class="fa fa-plus-square"/><span>Thêm phân công công việc</span>
                                </button>
                            </t>
                            <t t-if="state.canAssignList">
                                <button type="button"
                                        t-att-class="'o_dwd_side_item' + (isActive('team_assign_list') || isActive('team_assign') ? ' active' : '')"
                                        title="Danh sách phân công việc"
                                        t-on-click="() => this.openNav('team_assign_list')">
                                    <i class="fa fa-list-alt"/><span>Danh sách phân công công việc</span>
                                </button>
                            </t>
                            <t t-if="state.canAssignPersonnel">
                                <button type="button"
                                        t-att-class="'o_dwd_side_item' + (isActive('personnel_work') ? ' active' : '')"
                                        title="Công việc theo nhân sự"
                                        t-on-click="() => this.openNav('personnel_work')">
                                    <i class="fa fa-id-badge"/><span>Công việc theo nhân sự</span>
                                </button>
                            </t>
                            <t t-if="state.canAssignCategory">
                                <button type="button"
                                        t-att-class="'o_dwd_side_item' + (isActive('work_group') ? ' active' : '')"
                                        title="Hạng mục"
                                        t-on-click="() => this.openNav('work_group')">
                                    <i class="fa fa-sitemap"/><span>Hạng mục</span>
                                </button>
                            </t>
                        </div>
                    </t>
                    <div class="o_dwd_side_section">
                        <div class="o_dwd_side_label">📚 TIỆN ÍCH</div>
                        <button type="button" t-att-class="'o_dwd_side_item' + (isActive('notebook') ? ' active' : '')" title="Danh bạ"
                                t-on-click="() => this.openNav('notebook')">
                            <i class="fa fa-book"/><span>Danh bạ</span>
                        </button>
                        <button type="button" t-att-class="'o_dwd_side_item' + (isActive('work_note') ? ' active' : '')" title="Ghi chú công việc"
                                t-on-click="() => this.openNav('work_note')">
                            <span class="o_dwd_emoji_icon" aria-hidden="true">📝</span><span>Ghi chú</span>
                        </button>
                    </div>
                    <t t-if="state.isManager">
                        <div class="o_dwd_side_section">
                            <div class="o_dwd_side_label">QUẢN TRỊ HỆ THỐNG</div>
                            <button type="button" class="o_dwd_side_item" title="Email nhắc việc"
                                    t-on-click="() => this.openNav('send_mail')">
                                <i class="fa fa-envelope"/><span>Email nhắc việc</span>
                            </button>
                            <button type="button"
                                    t-att-class="'o_dwd_side_item o_dwd_side_toggle' + (state.configOpen ? ' open' : '')"
                                    title="Cài đặt"
                                    t-on-click="() => this.state.configOpen = !state.configOpen">
                                <i class="fa fa-sliders"/><span>Cài đặt</span>
                                <i t-att-class="'fa o_dwd_side_chev ' + (state.configOpen ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                            </button>
                            <t t-if="state.configOpen">
                                <div class="o_dwd_side_sub">
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('team') ? ' active' : '')" title="Team"
                                            t-on-click="() => this.openNav('team')">
                                        <i class="fa fa-users"/><span>Team</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('recurring') ? ' active' : '')" title="Công việc lặp lại"
                                            t-on-click="() => this.openNav('recurring')">
                                        <i class="fa fa-refresh"/><span>Công việc lặp lại</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('employees') ? ' active' : '')" title="Danh sách nhân viên"
                                            t-on-click="() => this.openNav('employees')">
                                        <i class="fa fa-address-book-o"/><span>Danh sách nhân viên</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('access') ? ' active' : '')" title="Phân quyền xem / giao / sửa / xóa"
                                            t-on-click="() => this.openNav('access')">
                                        <i class="fa fa-lock"/><span>Phân quyền xem / giao / sửa / xóa</span>
                                    </button>
                                    <button type="button" class="o_dwd_side_item sub" title="Phân quyền phân công công việc"
                                            t-on-click="() => this.openNav('assign_access')">
                                        <i class="fa fa-clipboard"/><span>Phân quyền phân công công việc</span>
                                    </button>
                                    <button type="button" class="o_dwd_side_item sub" title="Phân quyền Plan tổng"
                                            t-on-click="() => this.openNav('team_plan_access')">
                                        <i class="fa fa-calendar-check-o"/><span>Phân quyền Plan tổng</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('self_review') ? ' active' : '')" title="Phân quyền tự kiểm tra CV"
                                            t-on-click="() => this.openNav('self_review')">
                                        <i class="fa fa-user-circle-o"/><span>Phân quyền tự kiểm tra CV</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('rating_tier') ? ' active' : '')" title="Xếp loại hiệu suất"
                                            t-on-click="() => this.openNav('rating_tier')">
                                        <i class="fa fa-star-half-o"/><span>Xếp loại hiệu suất</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('eval_tier') ? ' active' : '')" title="Xếp loại đạt"
                                            t-on-click="() => this.openNav('eval_tier')">
                                        <i class="fa fa-check-square-o"/><span>Xếp loại đạt</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('report_perm') ? ' active' : '')" title="Phân quyền báo cáo"
                                            t-on-click="() => this.openNav('report_perm')">
                                        <i class="fa fa-key"/><span>Phân quyền báo cáo</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('report_access') ? ' active' : '')" title="Phân quyền Báo cáo tổng"
                                            t-on-click="() => this.openNav('report_access')">
                                        <i class="fa fa-shield"/><span>Phân quyền Báo cáo tổng</span>
                                    </button>
                                    <button type="button" t-att-class="'o_dwd_side_item sub' + (isActive('performance_access') ? ' active' : '')" title="Phân quyền Báo cáo hiệu suất"
                                            t-on-click="() => this.openNav('performance_access')">
                                        <i class="fa fa-line-chart"/><span>Phân quyền Báo cáo hiệu suất</span>
                                    </button>
                                </div>
                            </t>
                        </div>
                    </t>
                </aside>
                <div t-if="!state.sidebarCollapsed"
                     t-att-class="'o_dwd_sidebar_resizer' + (state.sidebarResizing ? ' active' : '')"
                     title="Kéo để đổi độ rộng thanh bên (double-click để mặc định)"
                     t-on-pointerdown="onSidebarResizeStart"
                     t-on-dblclick="resetSidebarWidth">
                    <span class="o_dwd_sidebar_resizer_grip" aria-hidden="true"/>
                </div>
                <main t-att-class="'o_dwd_main o_dwd_main_embed' + (activeReportTab ? ' o_dwr_has_hub' : '')">
                    <div t-if="activeReportTab" class="o_dwr_hub">
                        <h1 class="o_dwr_hub_title">
                            <i t-att-class="'fa ' + activeReportTab.icon"/>
                            <span t-esc="activeReportTab.label.toUpperCase()"/>
                        </h1>
                        <div class="o_dwr_hub_tabs" role="tablist">
                            <t t-foreach="reportTabs" t-as="it" t-key="it.nav">
                                <button type="button" role="tab"
                                        t-att-class="'o_dwr_hub_tab' + (activeNav === it.nav ? ' active' : '')"
                                        t-on-click="() => this.openNav(it.nav)">
                                    <i t-att-class="'fa ' + it.icon"/><span t-esc="it.label"/>
                                </button>
                            </t>
                        </div>
                    </div>
                    <t t-slot="default"/>
                </main>
            </div>
        </div>
    </t>
</templates>
