<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_lug_project" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lug.project</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="55"/>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <block title="Thông báo công việc dự án" id="lug_project_deadline_notification_block">
                    <setting id="lug_notify_lead_days_setting" string="Thời gian thông báo"
                             help="Gửi thông báo trước hạn N ngày cho người phụ trách, giám sát và nhân sự công việc">
                        <div class="content-group">
                            <div class="mt16 row">
                                <label for="lug_notify_lead_days" string="Thời gian thông báo" class="col-3 o_light_label"/>
                                <field name="lug_notify_lead_days" class="oe_inline col-2"/>
                                <span class="col-1 text-muted">ngày</span>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
