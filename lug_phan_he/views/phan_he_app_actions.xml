<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard & danh sách riêng cho từng app (ngoài Internet) -->
    <record id="action_phan_he_dashboard_camera" model="ir.actions.client">
        <field name="name">Dashboard Camera</field>
        <field name="tag">phan_he_dashboard</field>
        <field name="context">{'phan_he_service_type_code': 'camera', 'phan_he_app_title': 'Camera'}</field>
    </record>

    <record id="action_phan_he_dashboard_attendance" model="ir.actions.client">
        <field name="name">Dashboard Máy chấm công</field>
        <field name="tag">phan_he_dashboard</field>
        <field name="context">{'phan_he_service_type_code': 'attendance', 'phan_he_app_title': 'Máy chấm công'}</field>
    </record>

    <record id="action_phan_he_dashboard_linkq_hrm" model="ir.actions.client">
        <field name="name">Dashboard LinkQ HRM</field>
        <field name="tag">phan_he_dashboard</field>
        <field name="context">{'phan_he_service_type_code': 'linkq_hrm', 'phan_he_app_title': 'LinkQ HRM'}</field>
    </record>

    <record id="action_phan_he_dashboard_linkq_nb" model="ir.actions.client">
        <field name="name">LinkQ ERP</field>
        <field name="tag">phan_he_dashboard</field>
        <field name="context">{'phan_he_service_type_code': 'linkq_nb', 'phan_he_app_title': 'LinkQ ERP'}</field>
    </record>

    <record id="action_linkq_store_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">linkq_store_dashboard</field>
    </record>

    <record id="action_linkq_permission_matrix" model="ir.actions.client">
        <field name="name">Phân quyền</field>
        <field name="tag">linkq_permission_matrix</field>
    </record>

    <record id="action_linkq_roster_lock_settings" model="ir.actions.client">
        <field name="name">Cài đặt khóa lịch ca</field>
        <field name="tag">linkq_roster_lock_settings</field>
    </record>

    <record id="action_linkq_shift_summary_report" model="ir.actions.client">
        <field name="name">Báo cáo tổng hợp</field>
        <field name="tag">linkq_shift_summary_report</field>
    </record>

    <record id="view_linkq_roster_lock_event_list" model="ir.ui.view">
        <field name="name">linkq.roster.lock.event.list</field>
        <field name="model">linkq.roster.lock.event</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="event_time"/>
                <field name="event_type"/>
                <field name="name"/>
                <field name="detail"/>
                <field name="roster_id"/>
            </list>
        </field>
    </record>

    <record id="view_linkq_roster_lock_event_form" model="ir.ui.view">
        <field name="name">linkq.roster.lock.event.form</field>
        <field name="model">linkq.roster.lock.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="event_type"/>
                        <field name="event_time"/>
                        <field name="name"/>
                        <field name="detail"/>
                        <field name="roster_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_popup_sap_khoa" model="ir.actions.act_window">
        <field name="name">Thông báo: Lịch ca sắp khóa</field>
        <field name="res_model">linkq.roster.lock.event</field>
        <field name="view_mode">list,form</field>
        <field name="target">new</field>
        <field name="domain">[('event_type', '=', 'expiring')]</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <record id="action_popup_da_khoa" model="ir.actions.act_window">
        <field name="name">Thông báo: Lịch ca đã khóa</field>
        <field name="res_model">linkq.roster.lock.event</field>
        <field name="view_mode">list,form</field>
        <field name="target">new</field>
        <field name="domain">[('event_type', '=', 'locked')]</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <record id="action_popup_nhac_nho" model="ir.actions.act_window">
        <field name="name">Thông báo: Nhắc nhở xếp ca</field>
        <field name="res_model">linkq.roster.lock.event</field>
        <field name="view_mode">list,form</field>
        <field name="target">new</field>
        <field name="domain">[('event_type', '=', 'reminder')]</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <record id="action_phan_he_dashboard_server" model="ir.actions.client">
        <field name="name">Dashboard Máy chủ</field>
        <field name="tag">phan_he_dashboard</field>
        <field name="context">{'phan_he_service_type_code': 'server', 'phan_he_app_title': 'Máy chủ'}</field>
    </record>

    <!-- Camera -->
    <record id="action_phan_he_service_tracking_camera" model="ir.actions.act_window">
        <field name="name">Danh sách điểm Camera</field>
        <field name="res_model">phan.he.service</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('service_type_id', '=', ref('service_type_camera'))]"/>
        <field name="limit">200</field>
        <field name="context" eval="{
            'default_service_type_id': ref('service_type_camera'),
            'default_state': 'active',
            'default_ops_status': 'active',
            'search_default_group_mien': 1,
            'phan_he_service_type_code': 'camera',
        }"/>
        <field name="search_view_id" ref="view_phan_he_service_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_phan_he_service_tracking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_phan_he_service_entry_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có điểm Camera</p>
        </field>
    </record>

    <record id="action_phan_he_service_entry_camera" model="ir.actions.act_window">
        <field name="name">Nhập liệu Camera</field>
        <field name="res_model">phan.he.service</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context" eval="{
            'default_service_type_id': ref('service_type_camera'),
            'default_state': 'active',
            'default_ops_status': 'active',
            'form_view_initial_mode': 'edit',
        }"/>
        <field name="view_id" ref="view_phan_he_service_entry_form"/>
    </record>

