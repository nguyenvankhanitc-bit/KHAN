<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lug_project_type_list" model="ir.ui.view">
        <field name="name">lug.project.type.list</field>
        <field name="model">lug.project.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lug_project_type_form" model="ir.ui.view">
        <field name="name">lug.project.type.form</field>
        <field name="model">lug.project.type</field>
        <field name="arch" type="xml">
            <form string="Loại dự án">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lug_project_type" model="ir.actions.act_window">
        <field name="name">Loại dự án</field>
        <field name="res_model">lug.project.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
