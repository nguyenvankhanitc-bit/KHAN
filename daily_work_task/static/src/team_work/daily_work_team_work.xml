<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkTeamWork">
        <div class="o_daily_work_dashboard o_daily_work_team_work o_action">
            <DailyWorkAppShell t-props="{ activeNav: shellActiveNav }">
                <div class="o_dtw">
                    <!-- Thanh tiêu đề -->
                    <div class="o_dtw_banner">
                        <i class="fa fa-clipboard o_dtw_banner_ico"/>
                        <h1>PHÂN CÔNG CÔNG VIỆC TEAM <t t-esc="(state.teamName || '').toUpperCase()"/></h1>
                        <div class="o_dtw_banner_month">
                            <i class="fa fa-calendar"/>
                            <div><small>Tháng kế hoạch</small><b t-esc="monthLabel"/></div>
                        </div>
                        <button type="button" class="btn o_dtw_btn_excel" t-att-disabled="state.exporting" t-on-click="onExport">
                            <i class="fa fa-file-excel-o"/> Xuất Excel
                        </button>
                        <button type="button" class="btn o_dtw_btn_save" t-att-disabled="state.saving"
                                t-on-click="onSave">
                            <i class="fa fa-paper-plane"/> <t t-esc="state.saving ? 'Đang lưu...' : 'Lưu'"/>
                        </button>
                    </div>

                    <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-spinner fa-spin fa-2x"/></div>
                    <div t-elif="state.message" class="alert alert-warning m-0" t-esc="state.message"/>
                    <t t-else="">
                        <!-- Phòng ban / Team / Người điều phối / Tháng -->
                        <div class="o_dtw_card o_dtw_filters">
                            <div class="o_dtw_field">
                                <label><i class="fa fa-building-o"/> Phòng ban</label>
                                <select class="form-select" t-on-change="onDept">
                                    <t t-foreach="state.departments" t-as="d" t-key="d.id">
                                        <option t-att-value="d.id" t-att-selected="d.id === state.departmentId" t-esc="d.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="o_dtw_field">
                                <label><i class="fa fa-user-o"/> Người điều phối</label>
                                <select class="form-select" t-on-change="onCoordinator">
                                    <t t-foreach="state.members" t-as="m" t-key="m.user_id">
                                        <option t-att-value="m.user_id" t-att-selected="m.user_id === state.coordinatorId" t-esc="m.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="o_dtw_field">
                                <label><i class="fa fa-users"/> <t t-esc="'Team'"/></label>
                                <select class="form-select" t-on-change="onTeam">
                                    <t t-foreach="teamsOfDept" t-as="t" t-key="t.id">
                                        <option t-att-value="t.id" t-att-selected="t.id === state.teamId" t-esc="t.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="o_dtw_field">
                                <label><i class="fa fa-calendar"/> Tháng kế hoạch</label>
                                <select class="form-select" t-on-change="onMonth">
                                    <t t-foreach="monthOptions" t-as="mo" t-key="mo.key">
                                        <option t-att-value="mo.key" t-att-selected="mo.key === monthKey" t-esc="mo.label"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <!-- Hạng mục cha -->
                        <div class="o_dtw_card">
                            <h3 class="o_dtw_title"><i class="fa fa-list-alt"/> HẠNG MỤC CHA</h3>
                            <div class="o_dtw_cat">
                                <div class="o_dtw_field o_dtw_stt">
                                    <label># STT</label>
                                    <input type="text" class="form-control" readonly="readonly" t-att-value="nextStt"/>
                                </div>
                                <div class="o_dtw_field">
                                    <label><i class="fa fa-folder-o"/> Hạng mục</label>
                                    <select class="form-select" t-on-change="onCat">
                                        <option value="0" t-att-selected="!state.catId">— Chọn hạng mục —</option>
                                        <t t-foreach="state.categories" t-as="c" t-key="c.id">
                                            <option t-att-value="c.id" t-att-selected="c.id === state.catId" t-esc="c.label"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_dtw_field">
                                    <label><i class="fa fa-pencil-square-o"/> Tên công việc
                                        <small class="text-muted fw-normal">(gợi ý từ Quản lý công việc cá nhân · để trống = tên chi tiết)</small>
                                    </label>
                                    <input type="text" class="form-control" list="o_dtw_task_names" autocomplete="off"
                                           placeholder="Gõ hoặc chọn tên công việc..." t-model="state.taskName"/>
                                    <datalist id="o_dtw_task_names">
                                        <t t-foreach="nameSuggestions" t-as="n" t-key="n"><option t-att-value="n"/></t>
                                    </datalist>
                                </div>
                            </div>
                            <!-- Tên chi tiết hạng mục: tick chọn nhiều cùng lúc -->
                            <div class="o_dtw_details">
                                <div class="o_dtw_details_head">
                                    <label><i class="fa fa-list-ul"/> Tên chi tiết hạng mục
                                        <span class="o_dtw_count" t-esc="'(' + pickedDetails.length + '/' + catDetails.length + ' đã chọn)'"/>
                                        <span class="o_dtw_count">· không tick = giao theo hạng mục</span>
                                    </label>
                                    <button t-if="catDetails.length" type="button" class="btn btn-link btn-sm p-0" t-on-click="toggleAllDetails">
                                        <t t-esc="allDetailsPicked ? 'Bỏ chọn tất cả' : 'Chọn tất cả'"/>
                                    </button>
                                </div>
                                <div t-if="catDetails.length" class="o_dtw_details_list">
                                    <label t-foreach="catDetails" t-as="d" t-key="d.id" class="o_dtw_person">
                                        <input type="checkbox" class="form-check-input" t-att-checked="state.detailPicked[d.id]"
                                               t-on-change="() => this.toggleDetail(d)"/>
                                        <span t-esc="d.name"/>
                                    </label>
                                </div>
                                <div t-else="" class="text-muted small">
                                    Hạng mục này chưa có chi tiết — công việc sẽ gắn thẳng vào hạng mục.
                                </div>
                            </div>
                            <div class="o_dtw_plan">
                                <div class="o_dtw_field">
                                    <label><i class="fa fa-calendar"/> Ngày thực hiện</label>
                                    <div class="o_dtw_date">
                                        <input type="text" class="form-control" placeholder="dd/mm/yyyy"
                                               t-att-value="fmt(state.form.date_start)" t-on-change="(ev) => this.onRowDate(state.form, 'date_start', ev)"/>
                                        <button type="button" class="btn btn-link p-0 o_dtw_date_btn" t-on-click="(ev) => this.openPicker(ev)">
                                            <i class="fa fa-calendar"/>
                                        </button>
                                        <input type="date" class="o_dtw_date_picker" tabindex="-1" t-att-value="state.form.date_start"
                                               t-on-change="(ev) => this.onPicker(state.form, 'date_start', ev)"/>
                                    </div>
                                </div>
                                <div class="o_dtw_field">
                                    <label><i class="fa fa-calendar"/> Deadline</label>
                                    <div class="o_dtw_date">
                                        <input type="text" class="form-control" placeholder="dd/mm/yyyy"
                                               t-att-value="fmt(state.form.deadline)" t-on-change="(ev) => this.onRowDate(state.form, 'deadline', ev)"/>
                                        <button type="button" class="btn btn-link p-0 o_dtw_date_btn" t-on-click="(ev) => this.openPicker(ev)">
                                            <i class="fa fa-calendar"/>
                                        </button>
                                        <input type="date" class="o_dtw_date_picker" tabindex="-1" t-att-value="state.form.deadline"
                                               t-on-change="(ev) => this.onPicker(state.form, 'deadline', ev)"/>
                                    </div>
                                </div>
                                <div class="o_dtw_field">
                                    <label><i class="fa fa-user-o"/> Người kiểm tra</label>
                                    <select class="form-select" t-on-change="(ev) => this.onForm('checker_id', ev)">
                                        <option value="0" t-att-selected="!state.form.checker_id">—</option>
                                        <t t-foreach="state.members" t-as="m" t-key="m.user_id">
                                            <option t-att-value="m.user_id" t-att-selected="m.user_id === state.form.checker_id" t-esc="m.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_dtw_field">
                                    <label><i class="fa fa-sticky-note-o"/> Ghi chú</label>
                                    <input type="text" class="form-control" placeholder="Ghi chú..."
                                           t-att-value="state.form.note" t-on-change="(ev) => this.onForm('note', ev)"/>
                                </div>
                            </div>
                        </div>

                        <!-- Người phụ trách -->
                        <div class="o_dtw_card">
                            <h3 class="o_dtw_title"><i class="fa fa-users"/> NGƯỜI PHỤ TRÁCH (XUỐNG CÔNG VIỆC CÁ NHÂN)</h3>
                            <div class="o_dtw_people">
                                <div class="o_dtw_people_pick">
                                    <label>Chọn nhân sự</label>
                                    <div class="o_dtw_search">
                                        <i class="fa fa-search"/>
                                        <input type="text" class="form-control" placeholder="Tìm kiếm và chọn nhiều nhân sự..."
                                               t-model="state.query"/>
                                    </div>
                                    <div class="o_dtw_people_list">
                                        <label t-foreach="filteredMembers" t-as="m" t-key="m.user_id" class="o_dtw_person">
                                            <input type="checkbox" class="form-check-input" t-att-checked="state.picked[m.user_id]"
                                                   t-on-change="() => this.togglePick(m)"/>
                                            <span t-esc="m.name"/>
                                        </label>
                                        <div t-if="!filteredMembers.length" class="text-muted small p-2">Không có nhân sự phù hợp.</div>
                                    </div>
                                </div>
                                <div class="o_dtw_people_chosen">
                                    <label>Đã chọn <b t-esc="pickedMembers.length"/> nhân sự</label>
                                    <div class="o_dtw_chips">
                                        <span t-foreach="pickedMembers" t-as="m" t-key="m.user_id" class="o_dtw_chip">
                                            <t t-esc="m.name"/>
                                            <button type="button" class="btn btn-link p-0" t-on-click="() => this.unpick(m)">×</button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Danh sách công việc phân công: chỉ xem (việc đã phân của Team trong tháng kế hoạch) -->
                        <div class="o_dtw_card">
                            <div class="o_dtw_list_head">
                                <h3 class="o_dtw_title"><i class="fa fa-tasks"/> DANH SÁCH CÔNG VIỆC PHÂN CÔNG</h3>
                                <span class="o_dtw_list_meta" t-esc="'Tháng ' + monthLabel + ' · ' + state.listRows.length + ' công việc'"/>
                                <span class="o_dtw_spacer"/>
                                <button type="button" class="btn btn-sm btn-success" t-att-disabled="state.exporting" t-on-click="onExport">
                                    <i class="fa fa-file-excel-o"/> Xuất Excel
                                </button>
                            </div>
                            <div class="o_dtw_table_wrap">
                                <table class="o_dtw_table is-view">
                                    <thead>
                                        <tr>
                                            <th class="c-stt">STT</th>
                                            <th class="c-person">Nhân sự</th>
                                            <th class="c-cat">Hạng mục</th>
                                            <th>Nội dung công việc</th>
                                            <th class="c-date">Ngày thực hiện</th>
                                            <th class="c-date">Deadline</th>
                                            <th class="c-person">Người kiểm tra</th>
                                            <th class="c-state">Trạng thái</th>
                                            <th class="c-note">Ghi chú</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="state.listLoading">
                                            <td colspan="9" class="text-center text-muted py-3"><i class="fa fa-spinner fa-spin"/></td>
                                        </tr>
                                        <t t-else="">
                                            <tr t-foreach="state.listRows" t-as="r" t-key="r.id"
                                                t-att-class="state.canWrite ? 'o_dtw_row_link' : ''"
                                                t-att-title="state.canWrite ? 'Bấm để sửa công việc' : ''"
                                                t-on-click="() => this.openEdit(r)">
                                                <td class="text-center" t-esc="r_index + 1"/>
                                                <td t-esc="r.employee"/>
                                                <td>
                                                    <div t-esc="r.category"/>
                                                    <small t-if="r.detail" class="o_dtw_row_detail" t-esc="r.detail"/>
                                                </td>
                                                <td>
                                                    <a t-if="state.canWrite" href="#" class="o_dtw_name_link"
                                                       t-on-click.prevent="() => this.openEdit(r)">
                                                        <i class="fa fa-pencil-square-o"/> <t t-esc="r.name"/>
                                                    </a>
                                                    <t t-else="" t-esc="r.name"/>
                                                </td>
                                                <td class="text-center" t-esc="fmt(r.date_start)"/>
                                                <td class="text-center" t-esc="fmt(r.deadline)"/>
                                                <td t-esc="r.checker"/>
                                                <td class="text-center"><span t-att-class="stateClass(r.state)" t-esc="r.state_label"/></td>
                                                <td class="o_dtw_note" t-esc="r.note"/>
                                            </tr>
                                            <tr t-if="!state.listRows.length">
                                                <td colspan="9" class="text-center text-muted py-4">
                                                    Chưa có công việc phân công trong tháng này. Chọn Hạng mục, tick chi tiết + nhân sự rồi bấm «Lưu».
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </div>
                <!-- Sửa công việc phân công: bấm «Lưu» mới có hiệu lực -->
                <div t-if="state.edit" class="o_dtw_modal_backdrop" t-on-click.self="closeEdit">
                    <div class="o_dtw_modal" role="dialog">
                        <div class="o_dtw_modal_head">
                            <h4><i class="fa fa-pencil-square-o"/> SỬA CÔNG VIỆC PHÂN CÔNG</h4>
                            <button type="button" class="btn btn-link p-0" title="Đóng" t-on-click="closeEdit"><i class="fa fa-times"/></button>
                        </div>
                        <div class="o_dtw_modal_body">
                            <div class="o_dtw_modal_info">
                                <span><b>Hạng mục:</b> <t t-esc="state.edit.category"/><t t-if="state.edit.detail"> · <t t-esc="state.edit.detail"/></t></span>
                                <span><b>Trạng thái:</b> <t t-esc="state.edit.state_label"/></span>
                            </div>
                            <div class="o_dtw_modal_grid">
                                <div class="o_dtw_field">
                                    <label>Nhân sự</label>
                                    <select class="form-select" t-on-change="(ev) => this.onEdit('user_id', ev)">
                                        <t t-foreach="state.members" t-as="m" t-key="m.user_id">
                                            <option t-att-value="m.user_id" t-att-selected="m.user_id === state.edit.user_id" t-esc="m.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_dtw_field">
                                    <label>Người kiểm tra</label>
                                    <select class="form-select" t-on-change="(ev) => this.onEdit('checker_id', ev)">
                                        <option value="0" t-att-selected="!state.edit.checker_id">—</option>
                                        <t t-foreach="state.members" t-as="m" t-key="m.user_id">
                                            <option t-att-value="m.user_id" t-att-selected="m.user_id === state.edit.checker_id" t-esc="m.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_dtw_field o_dtw_span2">
                                    <label>Nội dung công việc</label>
                                    <input type="text" class="form-control" t-att-value="state.edit.name"
                                           t-on-change="(ev) => this.onEdit('name', ev)"/>
                                </div>
                                <div class="o_dtw_field">
                                    <label>Ngày thực hiện</label>
                                    <div class="o_dtw_date">
                                        <input type="text" class="form-control" placeholder="dd/mm/yyyy"
                                               t-att-value="fmt(state.edit.date_start)" t-on-change="(ev) => this.onRowDate(state.edit, 'date_start', ev)"/>
                                        <button type="button" class="btn btn-link p-0 o_dtw_date_btn" t-on-click="(ev) => this.openPicker(ev)">
                                            <i class="fa fa-calendar"/>
                                        </button>
                                        <input type="date" class="o_dtw_date_picker" tabindex="-1" t-att-value="state.edit.date_start"
                                               t-on-change="(ev) => this.onPicker(state.edit, 'date_start', ev)"/>
                                    </div>
                                </div>
                                <div class="o_dtw_field">
                                    <label>Deadline</label>
                                    <div class="o_dtw_date">
                                        <input type="text" class="form-control" placeholder="dd/mm/yyyy"
                                               t-att-value="fmt(state.edit.deadline)" t-on-change="(ev) => this.onRowDate(state.edit, 'deadline', ev)"/>
                                        <button type="button" class="btn btn-link p-0 o_dtw_date_btn" t-on-click="(ev) => this.openPicker(ev)">
                                            <i class="fa fa-calendar"/>
                                        </button>
                                        <input type="date" class="o_dtw_date_picker" tabindex="-1" t-att-value="state.edit.deadline"
                                               t-on-change="(ev) => this.onPicker(state.edit, 'deadline', ev)"/>
                                    </div>
                                </div>
                                <div class="o_dtw_field o_dtw_span2">
                                    <label>Ghi chú</label>
                                    <textarea class="form-control" rows="2" t-att-value="state.edit.note"
                                              t-on-change="(ev) => this.onEdit('note', ev)"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_dtw_modal_foot">
                            <button type="button" class="btn btn-light" t-att-disabled="state.editSaving" t-on-click="closeEdit">Hủy</button>
                            <button type="button" class="btn btn-primary" t-att-disabled="state.editSaving" t-on-click="saveEdit">
                                <i class="fa fa-save"/> <t t-esc="state.editSaving ? 'Đang lưu...' : 'Lưu'"/>
                            </button>
                        </div>
                    </div>
                </div>
            </DailyWorkAppShell>
        </div>
    </t>
</templates>
