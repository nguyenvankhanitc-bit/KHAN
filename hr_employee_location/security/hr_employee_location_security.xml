<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_employee_location" model="ir.module.category">
        <field name="name">Vị trí nhân viên &amp; Bản đồ cửa hàng</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_hr_employee_location_user" model="res.groups">
        <field name="name">Người dùng xem bản đồ</field>
        <field name="category_id" ref="module_category_hr_employee_location"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Được phép xem bản đồ vị trí nhân viên và mạng lưới cửa hàng.</field>
    </record>

    <record id="group_hr_employee_location_manager" model="res.groups">
        <field name="name">Quản lý định vị</field>
        <field name="category_id" ref="module_category_hr_employee_location"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_employee_location_user'))]"/>
        <field name="comment">Toàn quyền quản lý cấu hình geocoding, nhập tọa độ thủ công và xem toàn bộ nhân viên.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
</odoo>
