<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyTaskFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <button type="button"
                    class="btn btn-primary o_dwt_cp_save"
                    t-on-click.stop="() => this.saveButtonClicked()">
                Lưu
            </button>
            <button type="button"
                    class="btn btn-outline-secondary o_dwt_cp_cancel"
                    t-on-click.stop="discard">
                Hủy
            </button>
        </xpath>
        <xpath expr="//div[hasclass('o_form_view_container')]" position="after">
            <!-- Điện thoại: thanh Hủy / Lưu cố định đáy màn hình -->
            <div t-if="env.isSmall" class="o_dwt_mobile_savebar">
                <button type="button" class="btn o_dwt_mbar_cancel" t-on-click.stop="discard">
                    <i class="fa fa-times"/> Hủy
                </button>
                <button type="button" class="btn o_dwt_mbar_save" t-on-click.stop="() => this.saveButtonClicked()">
                    <i class="fa fa-floppy-o"/> Lưu
                </button>
            </div>
        </xpath>
    </t>
</templates>
