<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lưu trữ hình ảnh: mỗi ngày 02:30 sáng giờ Việt Nam (= 19:30 UTC hôm trước) xóa cuốn chiếu ảnh cột "Hình ảnh" quá hạn.
         Bật / tắt và số tháng lưu trữ chỉnh ở Checklist Audit > Cài đặt > Lưu trữ hình ảnh (mặc định TẮT). -->
    <data noupdate="1">
        <record id="cron_store_photo_purge" model="ir.cron">
            <field name="name">Checklist Audit: Xóa cuốn chiếu hình ảnh phiếu đánh giá</field>
            <field name="model_id" ref="model_store_photo_retention"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_photos()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=19, minute=30, second=0, microsecond=0) + timedelta(days=0 if (DateTime.now().hour, DateTime.now().minute) &lt; (19, 30) else 1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
