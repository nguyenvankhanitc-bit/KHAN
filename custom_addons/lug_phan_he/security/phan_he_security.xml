<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_phan_he">
        <field name="name">Quản lý dịch vụ</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="sequence">49</field>
    </record>

    <record id="group_phan_he_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_phan_he_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('group_phan_he_viewer'))]"/>
    </record>

    <record id="group_phan_he_user" model="res.groups">
        <field name="name">Nhân viên (alias)</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('group_phan_he_staff'))]"/>
    </record>

    <record id="group_phan_he_area" model="res.groups">
        <field name="name">Area Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('group_phan_he_staff'))]"/>
    </record>

    <record id="group_phan_he_regional" model="res.groups">
        <field name="name">Regional Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('group_phan_he_area'))]"/>
    </record>

    <record id="group_phan_he_service_manager" model="res.groups">
        <field name="name">Service Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('group_phan_he_regional'))]"/>
    </record>

    <record id="group_phan_he_manager" model="res.groups">
        <field name="name">Quản lý (alias)</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('group_phan_he_service_manager'))]"/>
    </record>

    <record id="group_phan_he_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_phan_he"/>
        <field name="implied_ids" eval="[(4, ref('group_phan_he_service_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company only — không chặn dữ liệu khi chưa gán miền/khu vực -->
    <record id="rule_phan_he_store_company" model="ir.rule">
        <field name="name">Store multi-company</field>
        <field name="model_id" ref="model_phan_he_store"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_phan_he_provider_company" model="ir.rule">
        <field name="name">Provider multi-company</field>
        <field name="model_id" ref="model_phan_he_provider"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_phan_he_service_company" model="ir.rule">
        <field name="name">Service multi-company</field>
        <field name="model_id" ref="model_phan_he_service"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_phan_he_payment_company" model="ir.rule">
        <field name="name">Payment multi-company</field>
        <field name="model_id" ref="model_phan_he_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_phan_he_document_company" model="ir.rule">
        <field name="name">Document multi-company</field>
        <field name="model_id" ref="model_phan_he_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_phan_he_invoice_company" model="ir.rule">
        <field name="name">Invoice multi-company</field>
        <field name="model_id" ref="model_phan_he_invoice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_phan_he_bank_company" model="ir.rule">
        <field name="name">Bank multi-company</field>
        <field name="model_id" ref="model_phan_he_bank_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Vô hiệu hóa rule phạm vi cũ nếu còn (tránh list trống) -->
    <record id="rule_store_org_scope" model="ir.rule">
        <field name="name">Store: phạm vi tổ chức (tắt)</field>
        <field name="model_id" ref="model_phan_he_store"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(4, ref('group_phan_he_viewer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_store_admin_all" model="ir.rule">
        <field name="name">Store: Service Manager+</field>
        <field name="model_id" ref="model_phan_he_store"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(4, ref('group_phan_he_service_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_service_org_scope" model="ir.rule">
        <field name="name">Service: phạm vi tổ chức (tắt)</field>
        <field name="model_id" ref="model_phan_he_service"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(4, ref('group_phan_he_viewer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_service_admin_all" model="ir.rule">
        <field name="name">Service: Service Manager+</field>
        <field name="model_id" ref="model_phan_he_service"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(4, ref('group_phan_he_service_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_payment_org_scope" model="ir.rule">
        <field name="name">Payment: phạm vi tổ chức (tắt)</field>
        <field name="model_id" ref="model_phan_he_payment"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(4, ref('group_phan_he_viewer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_payment_admin_all" model="ir.rule">
        <field name="name">Payment: Service Manager+</field>
        <field name="model_id" ref="model_phan_he_payment"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(4, ref('group_phan_he_service_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
