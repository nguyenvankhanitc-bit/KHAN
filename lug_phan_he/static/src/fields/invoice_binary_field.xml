<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lug_phan_he.InvoiceBinaryField">
        <div class="oe_fileupload ph-inet-invoice-upload" t-att-class="props.className || ''" aria-atomic="true">
            <div class="o_attachments">
                <t t-foreach="files" t-as="file" t-key="file.id or file_index">
                    <div class="o_attachment o_attachment_many2many o_attachment_editable" t-att-title="file.name">
                        <div class="o_attachment_wrap">
                            <t t-set="ext" t-value="getExtension(file)"/>
                            <t t-set="url" t-value="getUrl(file.id)"/>
                            <div class="o_image_box float-start">
                                <a t-att-href="url" download="">
                                    <span class="o_image o_preview_image o_hover" t-att-data-mimetype="file.mimetype" t-att-data-ext="ext" role="img"/>
                                </a>
                            </div>
                            <div class="caption">
                                <a class="ml4" t-att-href="url" download=""><t t-esc="file.name"/></a>
                            </div>
                            <div class="caption small">
                                <a class="ml4 small text-uppercase" t-att-href="url" download=""><b><t t-esc="ext"/></b></a>
                            </div>
                            <div class="o_attachment_uploaded">
                                <i class="text-success fa fa-check" title="Đã tải"/>
                            </div>
                            <div t-if="!props.readonly" class="o_attachment_delete"
                                 t-on-click.stop="() => this.onFileRemove(file.id)">×</div>
                        </div>
                    </div>
                </t>
            </div>
            <div t-if="!props.readonly" class="oe_add ph-inet-drop-hint">
                <FileInput
                    acceptedFileExtensions="props.acceptedFileExtensions"
                    multiUpload="true"
                    onUpload.bind="onFileUploaded"
                    resModel="props.record.resModel"
                    resId="0"
                >
                    <button type="button" class="btn btn-primary ph-inet-upload-btn">
                        <i class="fa fa-cloud-upload"/> Tải file hóa đơn
                    </button>
                </FileInput>
                <div class="text-muted small mt-2">Kéo thả hoặc chọn PDF, ảnh, Word, Excel</div>
            </div>
        </div>
    </t>
</templates>
