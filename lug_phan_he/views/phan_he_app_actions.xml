    <!-- Camera -->
    <record id="action_phan_he_service_tracking_camera" model="ir.actions.act_window">
        <field name="name">Danh sách điểm Camera</field>
        <field name="res_model">phan.he.service</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('service_type_id', '=', ref('service_type_camera'))]"/>
        <field name="limit">200</field>
        <field name="context" eval="{
            'default_service_type_id': ref('service_type_camera'),
            'default_state': 'active',
            'default_ops_status': 'active',
            'search_default_group_mien': 1,
            'phan_he_service_type_code': 'camera',
        }"/>
        <field name="search_view_id" ref="view_phan_he_service_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_phan_he_service_tracking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_phan_he_service_entry_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có điểm Camera</p>
        </field>
    </record>

    <record id="action_phan_he_service_entry_camera" model="ir.actions.act_window">
        <field name="name">Nhập liệu Camera</field>
        <field name="res_model">phan.he.service</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context" eval="{
            'default_service_type_id': ref('service_type_camera'),
            'default_state': 'active',
            'default_ops_status': 'active',
            'form_view_initial_mode': 'edit',
        }"/>
        <field name="view_id" ref="view_phan_he_service_entry_form"/>
    </record>

