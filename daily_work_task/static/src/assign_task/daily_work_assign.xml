<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkAssign">
        <div t-att-class="'o_daily_work_assign o_action' + (state.viewMode === 'detail' ? ' o_dwa_mode_detail' : '')">
            <div class="o_content o_dwa_scroll">
                <t t-if="state.loading">
                    <div class="text-center p-5">
                        <i class="fa fa-spinner fa-spin fa-2x"/>
                    </div>
                </t>
                <t t-else="">
                    <t t-if="state.viewMode === 'detail'">
                        <div class="o_dwa_detail_shell" t-ref="detailShell"
                             t-att-style="'--o-dwa-detail-left-width:' + state.detailLeftWidth + 'px'">
                            <aside class="o_dwa_detail_left">
                                <button type="button" class="btn o_dwa_detail_new"
                                        t-on-click="closeTaskDetail">
                                    <i class="fa fa-arrow-left"/> Quay lại phiếu giao
                                </button>
                                <div class="o_dwa_detail_filters">
                                    <div class="o_dwa_detail_filters_title">BỘ LỌC</div>
                                    <input type="search" class="form-control form-control-sm"
                                           placeholder="Tìm công việc..."
                                           t-model="state.detail.filterQuery"/>
                                    <select class="form-select form-select-sm"
                                            t-model="state.detail.filterState">
                                        <option value="">Tất cả trạng thái</option>
                                        <t t-foreach="state.states" t-as="s" t-key="s.value">
                                            <option t-att-value="s.value" t-esc="s.label"/>
                                        </t>
                                    </select>
                                    <select class="form-select form-select-sm"
                                            t-model.number="state.detail.filterAssignee">
                                        <option value="0">Tất cả nhân viên</option>
                                        <t t-foreach="assigneeFilterOptions" t-as="emp" t-key="emp.id">
                                            <option t-att-value="emp.id" t-esc="emp.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_dwa_detail_list_title">DANH SÁCH CÔNG VIỆC</div>
                                <div class="o_dwa_detail_task_list">
                                    <t t-foreach="detailSidebarTasks" t-as="t" t-key="t.id">
                                        <button type="button"
                                                t-att-class="'o_dwa_detail_task_card' + (t.id === state.detail.taskId ? ' active' : '')"
                                                t-on-click="() => this.selectDetailTask(t)">
                                            <div class="o_dwa_detail_card_top">
                                                <strong t-esc="t.name"/>
                                                <span t-att-class="'o_dwa_badge ' + priorityClass(t.priority)"
                                                      t-esc="t.priority_label"/>
                                            </div>
                                            <div class="o_dwa_detail_card_meta">
                                                <span t-esc="t.assignee_name"/>
                                                <span t-esc="t.deadline_display"/>
                                            </div>
                                            <span t-att-class="'o_dwa_state_badge ' + stateBadgeClass(t.state)"
                                                  t-esc="t.state_label"/>
                                        </button>
                                    </t>
                                    <div t-if="!detailSidebarTasks.length" class="o_dwa_detail_empty">
                                        Không có việc phù hợp.
                                    </div>
                                </div>
                            </aside>

                            <div class="o_dwa_detail_splitter"
                                 title="Kéo trái/phải để đổi chiều rộng danh sách"
                                 t-on-pointerdown="onDetailSplitterPointerDown">
                                <button type="button" class="o_dwa_detail_splitter_btn"
                                        title="Thu hẹp"
                                        t-on-click.stop="() => this.nudgeDetailSplitter(-24)">
                                    <i class="fa fa-caret-left"/>
                                </button>
                                <span class="o_dwa_detail_splitter_grip">
                                    <i class="fa fa-ellipsis-v"/>
                                </span>
                                <button type="button" class="o_dwa_detail_splitter_btn"
                                        title="Mở rộng"
                                        t-on-click.stop="() => this.nudgeDetailSplitter(24)">
                                    <i class="fa fa-caret-right"/>
                                </button>
                            </div>

                            <main class="o_dwa_detail_center">
                                <t t-if="state.detail.loading">
                                    <div class="text-center p-5">
                                        <i class="fa fa-spinner fa-spin fa-2x"/>
                                    </div>
                                </t>
                                <t t-elif="state.detail.data">
                                    <header class="o_dwa_detail_head">
                                        <div>
                                            <h1>
                                                <t t-esc="state.detail.data.name"/>
                                                <span t-att-class="'o_dwa_badge ' + priorityClass(state.detail.data.priority)"
                                                      t-esc="state.detail.data.priority_label"/>
                                            </h1>
                                        </div>
                                        <div class="o_dwa_detail_head_actions">
                                            <select class="form-select form-select-sm"
                                                    t-att-value="state.detail.data.state"
                                                    t-on-change="onDetailStateChange">
                                                <t t-foreach="state.states" t-as="s" t-key="'ds-' + s.value">
                                                    <option t-att-value="s.value" t-esc="s.label"/>
                                                </t>
                                            </select>
                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                    t-on-click="closeTaskDetail">
                                                Đóng
                                            </button>
                                        </div>
                                    </header>

                                    <div class="o_dwa_detail_grid">
                                        <div><label>Người giao</label><strong t-esc="state.detail.data.assigned_by_name || '—'"/></div>
                                        <div><label>Người nhận</label><strong t-esc="state.detail.data.assignee_name || '—'"/></div>
                                        <div><label>Deadline</label><strong t-esc="state.detail.data.deadline_display || '—'"/></div>
                                        <div><label>Hạng mục</label><strong t-esc="state.detail.data.work_group_label || '—'"/></div>
                                        <div>
                                            <label>Trạng thái</label>
                                            <span t-att-class="'o_dwa_state_badge ' + stateBadgeClass(state.detail.data.state)"
                                                  t-esc="state.detail.data.state_label"/>
                                        </div>
                                        <div><label>Ngày giao việc</label><strong t-esc="state.detail.data.assign_datetime_display || state.detail.data.assign_date_display || '—'"/></div>
                                        <div><label>Ưu tiên</label>
                                            <span t-att-class="'o_dwa_badge ' + priorityClass(state.detail.data.priority)"
                                                  t-esc="state.detail.data.priority_label"/>
                                        </div>
                                        <div><label>Bộ phận</label><strong t-esc="state.detail.data.department_label || '—'"/></div>
                                    </div>

                                    <section class="o_dwa_detail_section">
                                        <h3>Mô tả công việc</h3>
                                        <p class="o_dwa_detail_desc"
                                           t-esc="state.detail.data.description_text || 'Chưa có mô tả.'"/>
                                    </section>

                                    <section class="o_dwa_detail_section">
                                        <h3>Checklist</h3>
                                        <ul class="o_dwa_checklist">
                                            <t t-foreach="state.detail.data.checklist || []" t-as="item" t-key="item.id">
                                                <li>
                                                    <label>
                                                        <input type="checkbox" t-att-checked="item.done"
                                                               t-on-change="() => this.onToggleChecklist(item)"/>
                                                        <span t-att-class="item.done ? 'done' : ''" t-esc="item.name"/>
                                                    </label>
                                                </li>
                                            </t>
                                        </ul>
                                        <form class="o_dwa_checklist_add" t-on-submit="onAddChecklist">
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Thêm hạng mục checklist..."
                                                   t-model="state.detail.checklistDraft"/>
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Thêm</button>
                                        </form>
                                    </section>
                                </t>
                            </main>

                            <aside class="o_dwa_detail_right">
                                <div class="o_dwa_detail_tabs">
                                    <button type="button"
                                            t-att-class="state.detail.tab === 'chat' ? 'active' : ''"
                                            t-on-click="() => this.setDetailTab('chat')">Trao đổi</button>
                                    <button type="button"
                                            t-att-class="state.detail.tab === 'history' ? 'active' : ''"
                                            t-on-click="() => this.setDetailTab('history')">Nhật ký</button>
                                </div>
                                <t t-if="state.detail.tab === 'chat'">
                                    <div class="o_dwa_detail_chat_pane">
                                        <div class="o_dwa_detail_chat_body" t-ref="detailChatBody">
                                            <t t-if="!(state.detail.data and state.detail.data.messages and state.detail.data.messages.length)">
                                                <div class="o_dwa_detail_empty">Chưa có tin nhắn.</div>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="state.detail.data.messages" t-as="msg" t-key="msg.id">
                                                    <div t-att-class="'o_dwa_chat_msg' + (msg.is_mine ? ' mine' : '')">
                                                        <img class="o_dwa_chat_avatar" t-att-src="msg.author_avatar" alt=""/>
                                                        <div class="o_dwa_chat_bubble">
                                                            <div class="o_dwa_chat_meta">
                                                                <strong t-esc="msg.author_name"/>
                                                                <span t-esc="msg.date_display"/>
                                                            </div>
                                                            <div class="o_dwa_chat_text" t-esc="msg.body_text"/>
                                                        </div>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>
                                        <footer class="o_dwa_detail_chat_foot">
                                            <textarea class="form-control o_dwa_detail_chat_input"
                                                      rows="2"
                                                      placeholder="Nhập tin nhắn... (Enter để gửi)"
                                                      t-model="state.detail.chatDraft"
                                                      t-on-keydown="onDetailChatKeydown"/>
                                            <button type="button" class="btn btn-primary o_dwa_detail_chat_send"
                                                    t-on-click="sendDetailDiscussion"
                                                    t-att-disabled="state.detail.saving || !(state.detail.chatDraft || '').trim()">
                                                <i class="fa fa-paper-plane"/>
                                            </button>
                                        </footer>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="o_dwa_detail_history">
                                        <t t-foreach="(state.detail.data and state.detail.data.history) || []" t-as="h" t-key="h.id">
                                            <div class="o_dwa_history_item">
                                                <div class="o_dwa_history_meta">
                                                    <strong t-esc="h.author_name"/>
                                                    <span t-esc="h.date_display"/>
                                                </div>
                                                <div t-esc="h.body_text"/>
                                            </div>
                                        </t>
                                        <div t-if="!(state.detail.data and state.detail.data.history and state.detail.data.history.length)"
                                             class="o_dwa_detail_empty">Chưa có nhật ký.</div>
                                    </div>
                                </t>
                            </aside>
                        </div>
                    </t>
                    <t t-else="">
                    <div class="o_dwa_layout" t-ref="layoutBox"
                         t-att-style="'--o-dwa-left-width:' + state.leftWidth + 'px'">
                        <aside class="o_dwa_form_panel">
                            <h3 class="o_dwa_form_title">
                                <i class="fa fa-pencil-square-o"/> Phiếu giao việc
                            </h3>
                            <p class="o_dwa_panel_hint">
                                Điền phiếu bên trái — việc sẽ vào
                                <strong>Nhân viên nhập CV</strong> của người được giao.
                            </p>
                            <form t-on-submit="onSubmit">
                                <div class="o_dwa_field">
                                    <label>Tên công việc <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control"
                                           placeholder="Nhập tên nhiệm vụ cần giao..."
                                           t-model="state.form.name" required="required"/>
                                </div>
                                <div class="o_dwa_field">
                                    <label>Hạn hoàn thành <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control"
                                           t-model="state.form.deadline" required="required"/>
                                </div>
                                <div class="o_dwa_field">
                                    <label>Người được giao <span class="text-danger">*</span></label>
                                    <div class="o_dwa_autocomplete" t-ref="assigneeBox">
                                        <div class="o_dwa_autocomplete_input_wrap">
                                            <i class="fa fa-search o_dwa_autocomplete_icon"/>
                                            <input type="text"
                                                   class="form-control o_dwa_autocomplete_input"
                                                   placeholder="Gõ tên nhân viên để tìm..."
                                                   autocomplete="off"
                                                   t-model="state.assigneeQuery"
                                                   t-on-focus="onAssigneeFocus"
                                                   t-on-input="onAssigneeInput"
                                                   t-on-keydown="onAssigneeKeydown"/>
                                            <button type="button"
                                                    class="btn o_dwa_autocomplete_clear"
                                                    t-if="state.assigneeQuery || state.form.assignee_id"
                                                    title="Xóa"
                                                    t-on-click="clearAssignee">
                                                <i class="fa fa-times"/>
                                            </button>
                                        </div>
                                        <t t-if="state.form.assignee_id and selectedAssignee">
                                            <div class="o_dwa_assignee_selected">
                                                <i class="fa fa-check-circle"/>
                                                Đã chọn: <strong t-esc="selectedAssignee.name"/>
                                                <t t-if="selectedAssignee.department">
                                                    <span class="text-muted">
                                                        — <t t-esc="selectedAssignee.department"/>
                                                    </span>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="state.assigneeOpen">
                                            <ul class="o_dwa_autocomplete_list">
                                                <t t-if="!assigneeSuggestions.length">
                                                    <li class="o_dwa_autocomplete_empty">
                                                        Không tìm thấy nhân viên phù hợp.
                                                    </li>
                                                </t>
                                                <t t-foreach="assigneeSuggestions" t-as="emp" t-key="emp.id">
                                                    <li t-att-class="emp_index === state.assigneeHighlight ? 'o_dwa_autocomplete_item active' : 'o_dwa_autocomplete_item'"
                                                        t-on-pointerdown.prevent="() => this.selectAssignee(emp)">
                                                        <span class="o_dwa_ac_name" t-esc="emp.name"/>
                                                        <span class="o_dwa_ac_meta">
                                                            <t t-if="emp.department" t-esc="emp.department"/>
                                                            <t t-if="emp.email">
                                                                <t t-if="emp.department"> · </t>
                                                                <t t-esc="emp.email"/>
                                                            </t>
                                                        </span>
                                                    </li>
                                                </t>
                                            </ul>
                                        </t>
                                    </div>
                                    <small class="text-muted">Gõ tên (không phân biệt dấu) — chọn từ danh sách gợi ý.</small>
                                </div>
                                <div class="o_dwa_field">
                                    <label>Bộ phận</label>
                                    <input type="text" class="form-control" readonly="readonly"
                                           t-att-value="selectedAssignee
                                                ? (autoDepartmentLabel || '— Chưa gắn bộ phận trên hồ sơ NV')
                                                : '— Chọn nhân viên để tự điền'"/>
                                    <small class="text-muted">Tự động theo hồ sơ nhân viên được chọn.</small>
                                </div>
                                <div class="o_dwa_field">
                                    <label>Hạng mục</label>
                                    <select class="form-select" t-model="state.form.work_group_id"
                                            t-att-disabled="!filteredWorkGroups.length">
                                        <option value="">-- Chọn hạng mục --</option>
                                        <t t-foreach="filteredWorkGroups" t-as="g" t-key="g.id">
                                            <option t-att-value="g.id" t-esc="g.name"/>
                                        </t>
                                    </select>
                                    <small class="text-muted">
                                        <t t-if="!selectedAssignee">
                                            Chọn nhân viên trước để tải hạng mục theo bộ phận.
                                        </t>
                                        <t t-elif="!filteredWorkGroups.length">
                                            Không có hạng mục bạn được phép dùng cho bộ phận này
                                            (kiểm tra Cấu hình → Hạng mục → User áp dụng).
                                        </t>
                                        <t t-else="">
                                            Chỉ hiện hạng mục bạn nằm trong User áp dụng (theo bộ phận NV).
                                        </t>
                                    </small>
                                </div>
                                <div class="o_dwa_field">
                                    <label>Mức độ ưu tiên</label>
                                    <select class="form-select" t-model="state.form.priority">
                                        <t t-foreach="state.priorities" t-as="p" t-key="p.value">
                                            <option t-att-value="p.value" t-esc="p.label"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_dwa_field">
                                    <label>Trạng thái ban đầu</label>
                                    <select class="form-select" t-model="state.form.state">
                                        <t t-foreach="state.states" t-as="s" t-key="s.value">
                                            <option t-att-value="s.value" t-esc="s.label"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_dwa_field">
                                    <label>Ghi chú / mô tả</label>
                                    <textarea class="form-control" rows="3"
                                              placeholder="Mô tả yêu cầu giao việc..."
                                              t-model="state.form.note"/>
                                </div>
                                <button type="submit" class="btn o_dwa_submit"
                                        t-att-disabled="state.saving">
                                    <i class="fa fa-paper-plane"/>
                                    <t t-if="state.saving"> Đang giao...</t>
                                    <t t-else=""> Giao việc ngay</t>
                                </button>
                            </form>
                        </aside>

                        <div class="o_dwa_splitter"
                             title="Kéo trái/phải để đổi kích thước"
                             t-on-pointerdown="onSplitterPointerDown">
                            <button type="button" class="o_dwa_splitter_btn"
                                    title="Thu hẹp phiếu"
                                    t-on-click.stop="() => this.nudgeSplitter(-40)">
                                <i class="fa fa-caret-left"/>
                            </button>
                            <span class="o_dwa_splitter_grip">
                                <i class="fa fa-ellipsis-v"/>
                            </span>
                            <button type="button" class="o_dwa_splitter_btn"
                                    title="Mở rộng phiếu"
                                    t-on-click.stop="() => this.nudgeSplitter(40)">
                                <i class="fa fa-caret-right"/>
                            </button>
                        </div>

                        <section class="o_dwa_table_panel">
                            <div class="o_dwa_right_head">
                                <h2 class="o_dwa_right_title">
                                    <i class="fa fa-share-square-o"/> Giao việc cho nhân viên
                                </h2>
                                <p class="o_dwa_panel_hint">
                                    Danh sách việc đã giao — nhóm theo nhân sự, hạn từ sớm đến muộn.
                                </p>
                            </div>
                            <div class="o_dwa_table_head">
                                <h3 class="o_dwa_table_title">
                                    <i class="fa fa-list"/> Việc đã giao (chưa hoàn thành)
                                </h3>
                                <div class="o_dwa_table_actions">
                                    <select class="form-select form-select-sm o_dwa_filter"
                                            t-model="state.filterAssignee"
                                            title="Lọc theo nhân sự">
                                        <option value="0">Tất cả nhân viên</option>
                                        <t t-foreach="assigneeFilterOptions" t-as="emp" t-key="emp.id">
                                            <option t-att-value="emp.id" t-esc="emp.name"/>
                                        </t>
                                    </select>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            t-on-click="onRefresh">
                                        <i class="fa fa-refresh"/>
                                    </button>
                                </div>
                            </div>
                            <div class="o_dwa_table_wrap">
                                <t t-if="!taskGroups.length">
                                    <div class="text-center text-muted py-4">
                                        Chưa có việc đang giao. Hãy tạo phiếu bên trái.
                                    </div>
                                </t>
                                <div class="o_dwa_groups" t-else="">
                                    <t t-foreach="taskGroups" t-as="group" t-key="group.key">
                                        <details class="o_dwa_group" open="open">
                                            <summary class="o_dwa_group_summary">
                                                <span class="o_dwa_group_title">
                                                    <i class="fa fa-user"/>
                                                    <strong t-esc="group.assignee_name"/>
                                                    <t t-if="group.department_label">
                                                        <span class="o_dwa_group_dept" t-esc="group.department_label"/>
                                                    </t>
                                                </span>
                                                <span class="o_dwa_group_count">
                                                    <t t-esc="group.tasks.length"/> việc
                                                </span>
                                            </summary>
                                            <table class="o_dwa_table">
                                                <thead>
                                                    <tr>
                                                        <th>Tên công việc</th>
                                                        <th>Hạng mục</th>
                                                        <th>Hạn</th>
                                                        <th>Ưu tiên</th>
                                                        <th>Trạng thái</th>
                                                        <th class="o_dwa_th_discuss">Thảo luận</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="group.tasks" t-as="task" t-key="task.id">
                                                        <tr>
                                                            <td>
                                                                <button type="button" class="o_dwa_task_link"
                                                                        t-on-click="() => this.openTaskDetail(task)"
                                                                        t-esc="task.name"/>
                                                            </td>
                                                            <td t-esc="task.work_group_label || '—'"/>
                                                            <td t-esc="task.deadline_display"/>
                                                            <td>
                                                                <span t-att-class="'o_dwa_badge ' + priorityClass(task.priority)"
                                                                      t-esc="task.priority_label"/>
                                                            </td>
                                                            <td>
                                                                <span t-att-class="'o_dwa_state_badge ' + stateBadgeClass(task.state)"
                                                                      t-esc="task.state_label"/>
                                                            </td>
                                                            <td class="o_dwa_td_discuss">
                                                                <button type="button"
                                                                        t-att-class="'o_dwa_discuss_btn' + (task.discussion_unread ? ' has-unread' : '')"
                                                                        t-att-title="'Thảo luận: ' + (task.name || '')"
                                                                        t-on-click="() => this.openDiscussion(task)">
                                                                    <i class="fa fa-comments"/>
                                                                    <t t-if="discussionBadge(task)">
                                                                        <span class="o_dwa_discuss_badge"
                                                                              t-esc="discussionBadge(task)"/>
                                                                    </t>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </details>
                                    </t>
                                </div>
                            </div>
                        </section>
                    </div>
                    </t>
                </t>
            </div>

            <!-- Popup thảo luận theo việc -->
            <t t-if="state.chat.open">
                <div class="o_dwa_chat_panel">
                    <header class="o_dwa_chat_head">
                        <div class="o_dwa_chat_head_text">
                            <strong>
                                <i class="fa fa-comments"/> Thảo luận:
                                <t t-esc="state.chat.taskName"/>
                            </strong>
                            <span class="o_dwa_chat_sub" t-if="state.chat.assigneeName">
                                Người nhận: <t t-esc="state.chat.assigneeName"/>
                            </span>
                        </div>
                        <button type="button" class="btn btn-sm btn-light o_dwa_chat_close"
                                title="Đóng" t-on-click="closeDiscussion">
                            <i class="fa fa-times"/>
                        </button>
                    </header>
                    <div class="o_dwa_chat_body" t-ref="chatBody">
                        <t t-if="state.chat.loading">
                            <div class="o_dwa_chat_empty">
                                <i class="fa fa-spinner fa-spin"/> Đang tải...
                            </div>
                        </t>
                        <t t-elif="!state.chat.messages.length">
                            <div class="o_dwa_chat_empty">
                                Chưa có tin nhắn. Hãy bắt đầu thảo luận về việc này.
                            </div>
                        </t>
                        <t t-else="">
                            <t t-foreach="state.chat.messages" t-as="msg" t-key="msg.id">
                                <div t-att-class="'o_dwa_chat_msg' + (msg.is_mine ? ' mine' : '')">
                                    <img class="o_dwa_chat_avatar" t-att-src="msg.author_avatar" alt=""/>
                                    <div class="o_dwa_chat_bubble">
                                        <div class="o_dwa_chat_meta">
                                            <strong t-esc="msg.author_name"/>
                                            <span t-esc="msg.date_display"/>
                                        </div>
                                        <div class="o_dwa_chat_text" t-esc="msg.body_text"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                    <footer class="o_dwa_chat_foot">
                        <textarea class="form-control o_dwa_chat_input"
                                  rows="2"
                                  placeholder="Nhập tin nhắn... (Enter để gửi)"
                                  t-model="state.chat.draft"
                                  t-on-keydown="onChatKeydown"
                                  t-att-disabled="state.chat.sending ? 'disabled' : undefined"/>
                        <button type="button" class="btn btn-primary o_dwa_chat_send"
                                t-att-disabled="state.chat.sending || !(state.chat.draft || '').trim()"
                                t-on-click="sendDiscussion">
                            <i t-att-class="state.chat.sending ? 'fa fa-spinner fa-spin' : 'fa fa-paper-plane'"/>
                        </button>
                    </footer>
                </div>
            </t>
        </div>
    </t>
</templates>
