<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lug_project_phase_list" model="ir.ui.view">
        <field name="name">lug.project.phase.list</field>
        <field name="model">lug.project.phase</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code" string="Mã"/>
                <field name="name"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lug_project_phase_form" model="ir.ui.view">
        <field name="name">lug.project.phase.form</field>
        <field name="model">lug.project.phase</field>
        <field name="arch" type="xml">
            <form string="Giai đoạn">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lug_project_phase" model="ir.actions.act_window">
        <field name="name">Giai đoạn</field>
        <field name="res_model">lug.project.phase</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
