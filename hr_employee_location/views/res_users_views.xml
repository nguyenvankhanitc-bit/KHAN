<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_device_limit" model="ir.ui.view">
        <field name="name">res.users.form.inherit.device.limit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="inside">
                <group string="Giới hạn thiết bị đăng nhập" groups="base.group_system">
                    <field name="exempt_device_limit"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
