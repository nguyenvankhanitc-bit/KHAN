<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        App root: không gắn action/web_icon trong XML (lab hay ParseError khi đọc icon).
        Icon gán ở post-migrate; click app → leaf đầu (Nhập công việc).
        IA: CÔNG VIỆC | BÁO CÁO | TIỆN ÍCH (+ Cấu hình ẩn cho manager).
    -->
    <menuitem id="menu_daily_work_root"
              name="Công việc hàng ngày"
              sequence="36"
              groups="daily_work_task.group_daily_work_user"/>

    <!-- ========== 📌 CÔNG VIỆC ========== -->
    <menuitem id="menu_daily_work_cat_tasks"
              name="CÔNG VIỆC"
              parent="menu_daily_work_root"
              sequence="10"
              groups="daily_work_task.group_daily_work_user"/>

