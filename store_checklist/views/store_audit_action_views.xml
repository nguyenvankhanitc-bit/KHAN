<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_audit_action_form" model="ir.ui.view">
        <field name="name">store.audit.action.form</field>
        <field name="model">store.audit.action</field>
        <field name="arch" type="xml">
            <form string="Khắc phục">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="audit_id"/>
                            <field name="store_id"/>
                            <field name="line_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_found"/>
                            <field name="responsible_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="deadline"/>
                            <field name="date_done" options="{'numeric': true}"/>
                            <field name="reviewer_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="issue"/>
                        <field name="root_cause"/>
                        <field name="action_plan"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_store_audit_action_list" model="ir.ui.view">
        <field name="name">store.audit.action.list</field>
        <field name="model">store.audit.action</field>
        <field name="arch" type="xml">
            <list group_edit="0" group_delete="0" string="Khắc phục" decoration-danger="state != 'done' and deadline and deadline &lt; current_date">
                <field name="date_found"/>
                <field name="store_id"/>
                <field name="audit_id" optional="show"/>
                <field name="line_id"/>
                <field name="issue"/>
                <field name="action_plan"/>
                <field name="responsible"/>
                <field name="deadline"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'doing'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_store_audit_action_search" model="ir.ui.view">
        <field name="name">store.audit.action.search</field>
        <field name="model">store.audit.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="issue"/>
                <field name="store_id"/>
                <field name="responsible"/>
                <filter name="todo" string="Chưa hoàn thành" domain="[('state', '!=', 'done')]"/>
                <group>
                    <filter name="group_store" string="Cửa hàng" context="{'group_by': 'store_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Popup "Xử lý sai phạm" (mở từ Xử lý sai phạm › Cửa hàng có biên bản): bảng như file Excel theo dõi khắc phục -->
    <record id="view_store_audit_action_violation_list" model="ir.ui.view">
        <field name="name">store.audit.action.violation.list</field>
        <field name="model">store.audit.action</field>
        <field name="arch" type="xml">
            <list js_class="store_violation_list" editable="bottom" create="0" delete="0" group_edit="0" group_delete="0" string="Xử lý sai phạm" class="o_store_violation_list">
                <field name="line_sequence" string="STT" width="60px" readonly="1"/>
                <field name="line_id" string="Tiêu chí sai phạm" width="200px" readonly="1"/>
                <field name="issue" string="Chi tiết lỗi giám sát ghi nhận" width="260px"/>
                <field name="line_max_score" width="85px" readonly="1" options="{'hide_trailing_zeros': true}"/>
                <field name="line_actual_score" width="85px" readonly="1" options="{'hide_trailing_zeros': true}"/>
                <field name="score_deduct" width="85px" readonly="1" options="{'hide_trailing_zeros': true}"/>
                <field name="responsible_ids" widget="many2many_tags" options="{'no_create': true}" width="150px"/>
                <field name="action_plan" string="Nội dung khắc phục" width="260px"/>
                <field name="date_done" width="125px" options="{'numeric': true}"/>
                <field name="state" string="Trạng thái xử lý" width="115px"
                       decoration-warning="state == 'doing'" decoration-success="state == 'done'" decoration-muted="state == 'todo'"/>
                <field name="reviewer_ids" widget="many2many_tags" options="{'no_create': true}" width="130px"/>
                <field name="control_done" width="140px"/>
            </list>
        </field>
    </record>

    <record id="action_store_audit_action" model="ir.actions.act_window">
        <field name="name">Theo dõi khắc phục</field>
        <field name="res_model">store.audit.action</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>
</odoo>
