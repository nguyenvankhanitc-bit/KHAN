<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eam_model_list" model="ir.ui.view">
        <field name="name">eam.model.list</field>
        <field name="model">eam.model</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="code"/>
                <field name="category_id"/>
                <field name="brand_id"/>
                <field name="name"/>
                <field name="default_warranty_month"/>
                <field name="default_cost"/>
                <field name="equipment_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_eam_model_form" model="ir.ui.view">
        <field name="name">eam.model.form</field>
        <field name="model">eam.model</field>
        <field name="arch" type="xml">
            <form string="Danh mục tài sản">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_equipment" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="equipment_count" widget="statinfo" string="Tài sản"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" placeholder="MDL00001"/></h1>
                        <label for="name"/>
                        <h2><field name="name" placeholder="FTKB25"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" options="{'no_create_edit': True}"/>
                            <field name="brand_id"/>
                            <field name="display_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="default_warranty_month"/>
                            <field name="default_cost"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="uom_note"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Thông số kỹ thuật">
                        <field name="specification" nolabel="1" placeholder="Công suất, CPU, kích thước..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eam_model_search" model="ir.ui.view">
        <field name="name">eam.model.search</field>
        <field name="model">eam.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Nhóm" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Thương hiệu" name="group_brand" context="{'group_by': 'brand_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eam_model" model="ir.actions.act_window">
        <field name="name">Danh mục tài sản</field>
        <field name="res_model">eam.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eam_model_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm danh mục (Model)</p>
            <p>Mỗi dòng = Nhóm + Thương hiệu + Model (ví dụ Máy lạnh / Daikin / FTKB25).</p>
        </field>
    </record>
</odoo>
