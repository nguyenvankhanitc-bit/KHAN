<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkMonthlyReport">
        <div class="o_daily_work_dashboard o_daily_work_monthly_report o_action">
            <DailyWorkAppShell t-props="{ activeNav: shellActiveNav }">
                <div class="o_dmr_shell">
                    <!-- Đầu trang giống Báo cáo cá nhân: avatar · tên · chức danh/phòng ban · tiêu đề + tháng · bộ lọc -->
                    <header class="o_dmr_head">
                        <div class="o_dmr_profile"/>
                        <!-- Tiêu đề canh giữa: Báo cáo công việc / Họ và tên / Tháng … Năm … -->
                        <div class="o_dmr_center_title">
                            <h1>BÁO CÁO CÔNG VIỆC</h1>
                            <div>Họ và tên: <b t-esc="state.data and state.data.employee ? state.data.employee.name : ''"/></div>
                            <div t-if="state.data and state.data.employee" class="o_dmr_center_sub">
                                <t t-esc="state.data.employee.job_title or 'Nhân viên'"/>
                                <t t-if="state.data.employee.department"> · <t t-esc="state.data.employee.department"/></t>
                            </div>
                            <div t-esc="'Tháng ' + state.month + ' Năm ' + state.year"/>
                        </div>
                        <div class="o_dmr_tools">
                            <select class="o_dmr_ctrl" t-on-change="onMonthSelect">
                                <t t-foreach="monthOptions" t-as="m" t-key="m">
                                    <option t-att-value="m" t-att-selected="m === state.month" t-esc="'Tháng ' + m"/>
                                </t>
                            </select>
                            <input type="number" class="o_dmr_ctrl o_dmr_year" min="2000" max="2100"
                                   t-att-value="state.year" t-on-change="onYearInput"/>
                            <button type="button" class="btn btn-light btn-sm o_dmr_btn" t-att-disabled="state.loading" t-on-click="() => this.load()">
                                <i class="fa fa-refresh"/> Làm mới
                            </button>
                            <button type="button" class="btn btn-success btn-sm o_dmr_btn" t-att-disabled="state.exporting or !state.data or state.data.message" t-on-click="onExport">
                                <i t-att-class="state.exporting ? 'fa fa-spinner fa-spin' : 'fa fa-file-excel-o'"/> Xuất Excel
                            </button>
                        </div>
                    </header>

                    <div t-if="state.loading" class="o_dmr_empty"><i class="fa fa-spinner fa-spin"/> Đang tải…</div>
                    <div t-elif="!state.data" class="o_dmr_empty">Không có dữ liệu.</div>
                    <div t-elif="state.data.message" class="alert alert-warning m-3" t-esc="state.data.message"/>
                    <t t-else="">
                        <t t-set="d" t-value="state.data"/>
                        <!-- Dashboard giống Báo cáo cá nhân -->
                        <div class="o_dmr_kpis">
                            <div class="o_dmr_kpi"><span class="ico blue"><i class="fa fa-briefcase"/></span>
                                <div><small>TỔNG CÔNG VIỆC</small><b t-esc="kpi.total || 0"/><em>100%</em></div></div>
                            <div class="o_dmr_kpi"><span class="ico green"><i class="fa fa-check-circle"/></span>
                                <div><small>HOÀN THÀNH</small><b t-esc="kpi.done || 0"/><em t-esc="pct(kpi.done)"/></div></div>
                            <div class="o_dmr_kpi"><span class="ico amber"><i class="fa fa-hourglass-half"/></span>
                                <div><small>ĐANG THỰC HIỆN</small><b t-esc="kpi.in_progress || 0"/><em t-esc="pct(kpi.in_progress)"/></div></div>
                            <div class="o_dmr_kpi"><span class="ico red"><i class="fa fa-clock-o"/></span>
                                <div><small>QUÁ HẠN</small><b t-esc="kpi.overdue || 0"/><em t-esc="pct(kpi.overdue)"/></div></div>
                            <div class="o_dmr_kpi"><span class="ico violet"><i class="fa fa-hourglass"/></span>
                                <div><small>TỔNG THỜI GIAN</small><b t-esc="(kpi.duration_hours || 0) + ' giờ'"/><em>Trong tháng</em></div></div>
                            <div class="o_dmr_kpi"><span class="ico teal"><i class="fa fa-line-chart"/></span>
                                <div><small>HIỆU SUẤT</small><b t-esc="(kpi.efficiency || 0) + '%'"/><em>Theo QL đánh giá</em></div></div>
                            <div class="o_dmr_kpi is-progress">
                                <div><small>TIẾN ĐỘ HOÀN THÀNH</small><b t-esc="(kpi.avg_progress || 0) + '%'"/>
                                    <div class="o_dmr_bar"><span t-att-style="'width:' + Math.min(100, kpi.avg_progress || 0) + '%'"/></div></div></div>
                        </div>
                        <div class="o_dmr_charts">
                            <div class="o_dmr_card">
                                <h4>Tỷ lệ trạng thái công việc</h4>
                                <div class="o_dmr_donut_row">
                                    <div class="o_dmr_donut"><canvas t-ref="stateChart"/>
                                        <div class="o_dmr_donut_center"><b t-esc="kpi.total || 0"/><small>Tổng việc</small></div></div>
                                    <ul class="o_dmr_legend">
                                        <li t-foreach="stateLegend" t-as="lg" t-key="lg.key">
                                            <i t-att-style="'background:' + lg.color"/><span t-esc="lg.label"/>
                                            <b t-esc="lg.count"/><em t-esc="'(' + pct(lg.count) + ')'"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="o_dmr_card">
                                <h4>Xu hướng hoàn thành công việc (theo tuần)</h4>
                                <div class="o_dmr_line"><canvas t-ref="weeklyChart"/></div>
                            </div>
                            <div class="o_dmr_card">
                                <h4>Đánh giá hiệu suất tháng</h4>
                                <div class="o_dmr_eval_row">
                                    <div class="o_dmr_donut"><canvas t-ref="evalChart"/>
                                        <div class="o_dmr_donut_center"><b t-esc="(evaluation.score || 0) + '%'"/></div></div>
                                    <div class="o_dmr_eval_info">
                                        <div class="o_dmr_stars"><i t-foreach="stars" t-as="s" t-key="s_index" t-att-class="s"/></div>
                                        <div>Đánh giá: <b t-esc="evaluation.rating || '—'"/></div>
                                        <dl>
                                            <dt>Tổng công việc</dt><dd t-esc="evaluation.total || 0"/>
                                            <dt>Hoàn thành</dt><dd t-esc="evaluation.done || 0"/>
                                            <dt>Quá hạn</dt><dd class="red" t-esc="evaluation.overdue || 0"/>
                                            <dt>Tổng thời gian</dt><dd t-esc="(evaluation.hours || 0) + ' giờ'"/>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="o_dmr_paper">

                            <div class="o_dmr_table_wrap" t-ref="tableWrap">
                                <table class="o_dmr_table">
                                    <thead>
                                        <tr>
                                            <th rowspan="2" class="c-stt">STT</th>
                                            <th rowspan="2" class="c-name">NỘI DUNG CÔNG VIỆC</th>
                                            <th rowspan="2" class="c-dl">DEADLINES</th>
                                            <th rowspan="2" class="c-days">SỐ NGÀY</th>
                                            <th colspan="3" class="c-freqhead">TẦN SUẤT THỰC HIỆN</th>
                                            <th rowspan="2" class="c-tg">TG THỰC HIỆN (ĐVT: PHÚT)</th>
                                            <th colspan="2" class="is-green">ĐỊNH BIÊN</th>
                                            <th colspan="2" class="is-green">THỰC HIỆN</th>
                                            <th rowspan="2" class="c-desc">GHI CHÚ</th>
                                            <th colspan="2">QUẢN LÝ ĐÁNH GIÁ</th>
                                        </tr>
                                        <tr>
                                            <th class="c-freq">NGÀY</th>
                                            <th class="c-freq">TUẦN</th>
                                            <th class="c-freq">THÁNG</th>
                                            <th class="c-num">THỜI GIAN (THEO GIỜ)</th>
                                            <th class="c-pct">%</th>
                                            <th class="c-num">THỜI GIAN (THEO GIỜ)</th>
                                            <th class="c-num">MỨC ĐỘ HOÀN THÀNH</th>
                                            <th class="c-num">% HOÀN THÀNH</th>
                                            <th class="c-note">GHI CHÚ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="o_dmr_band"><td colspan="15">NHÓM CÔNG VIỆC THEO MTCV CHI TIẾT</td></tr>
                                        <tr t-if="!d.groups.length"><td colspan="15" class="o_dmr_none">Chưa có công việc thuộc hạng mục trong tháng.</td></tr>
                                        <t t-foreach="d.groups" t-as="g" t-key="g.code">
                                            <tr class="o_dmr_group">
                                                <td class="c" t-esc="g.code"/>
                                                <td t-esc="g.name"/>
                                                <td/><td/><td/><td/><td/><td/>
                                                <td class="c" t-esc="fmt(g.plan_hours)"/>
                                                <td class="c" t-esc="g.plan_pct + '%'"/>
                                                <td class="c" t-esc="fmt(g.actual_hours)"/>
                                                <td class="c" t-esc="g.progress + '%'" title="% Hoàn thành CV TB hạng mục (AVERAGE) — như Báo cáo cá nhân"/>
                                                <td/>
                                                <td class="c" t-esc="g.mgr_pct + '%'" title="% Hoàn thành TB do Quản lý đánh giá (Kiểm tra CV)"/>
                                                <td/>
                                            </tr>
                                            <t t-foreach="g.lines" t-as="l" t-key="g.code + '-' + l.stt">
                                                <t t-call="daily_work_task.DailyWorkMonthlyReportLine"/>
                                            </t>
                                        </t>
                                        <tr class="o_dmr_band"><td colspan="15">NHÓM CÔNG VIỆC KHÁC (NẾU CÓ)</td></tr>
                                        <t t-if="d.other">
                                            <t t-foreach="d.other.lines" t-as="l" t-key="'o-' + l.stt">
                                                <t t-call="daily_work_task.DailyWorkMonthlyReportLine"/>
                                            </t>
                                            <tr class="o_dmr_group">
                                                <td colspan="8" class="c">TỔNG THỜI GIAN (THEO H)</td>
                                                <td class="o_dmr_slash"/><td class="o_dmr_slash"/>
                                                <td class="c" t-esc="fmt(d.other.actual_hours)"/>
                                                <td/><td/><td/><td/>
                                            </tr>
                                        </t>
                                        <tr class="o_dmr_group">
                                            <td colspan="8" class="c">TỔNG THỜI GIAN THỰC HIỆN TRONG THÁNG (THEO H)</td>
                                            <td class="c" t-esc="fmt(d.total_plan_hours)"/>
                                            <td class="o_dmr_slash"/>
                                            <td class="c" t-esc="fmt(d.total_actual_hours)"/>
                                            <td class="c" t-esc="d.total_progress + '%'"/>
                                            <td/>
                                            <td class="c" t-esc="d.total_mgr_pct + '%'"/>
                                            <td/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="o_dmr_eval">
                                <b>Đánh giá của cấp quản lý/ trưởng bộ phận:</b>
                                <div class="o_dmr_dots"/><div class="o_dmr_dots"/><div class="o_dmr_dots"/>
                                <div class="o_dmr_date">Ngày............................</div>
                                <div class="o_dmr_sign">
                                    <div><b>Người lập</b><span t-esc="d.employee.name"/></div>
                                    <div><b>Trưởng bộ phận</b></div>
                                    <div><b>Ban Giám đốc</b></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </DailyWorkAppShell>
        </div>
    </t>

    <t t-name="daily_work_task.DailyWorkMonthlyReportLine">
        <tr>
            <td class="c" t-esc="l.stt"/>
            <td t-esc="l.name"/>
            <td class="c" t-esc="l.deadline"/>
            <td class="c" t-esc="l.freq"/>
            <td class="c" t-esc="l.day"/>
            <td class="c" t-esc="l.week"/>
            <td class="c" t-esc="l.month"/>
            <td class="c" t-esc="l.minutes or ''"/>
            <td class="c" t-esc="fmt(l.plan_hours)"/>
            <td class="c" t-esc="l.plan_pct + '%'"/>
            <td class="c" t-esc="fmt(l.actual_hours)"/>
            <td class="c" t-esc="l.progress + '%'"/>
            <!-- GHI CHÚ = ghi chú nhập ở Danh sách công việc cá nhân (Quản lý công việc) -->
            <td class="c-desc-cell" t-esc="l.note"/>
            <!-- QUẢN LÝ ĐÁNH GIÁ: nhập trên Kiểm tra CV -->
            <td class="c" t-esc="l.mgr_pct + '%'" title="% Hoàn thành do Quản lý đánh giá (Kiểm tra CV)"/>
            <td class="c-desc-cell" t-esc="l.mgr_note"/>
        </tr>
    </t>
</templates>
