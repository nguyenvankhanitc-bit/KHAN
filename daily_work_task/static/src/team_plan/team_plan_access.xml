<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daily_work_task.DailyWorkTeamPlanAccess">
        <!-- Dùng chung giao diện ma trận Phân quyền phân công (o_daily_work_assign_access) -->
        <div class="o_daily_work_dashboard o_daily_work_assign_access o_daily_work_team_plan_access o_action">
            <DailyWorkAppShell t-props="{ activeNav: shellActiveNav }">
                <div class="o_daa_shell">
                    <header class="o_daa_header">
                        <div class="o_daa_header_left">
                            <h1>Phân quyền Plan tổng</h1>
                            <p class="o_daa_subtitle">
                                Xem / Thêm / Chỉnh sửa / Xóa công việc trên Plan tổng team · Thêm, Chỉnh sửa, Xóa tự kèm Xem · Quản lý luôn có toàn quyền
                            </p>
                        </div>
                        <div class="o_daa_header_actions">
                            <button type="button" class="btn o_daa_btn_cancel" t-att-disabled="state.saving" t-on-click="onCancel">
                                <i class="fa fa-times"/> Hủy
                            </button>
                            <button type="button" class="btn o_daa_btn_save" t-att-disabled="state.saving or !state.dirty" t-on-click="onSave">
                                <i class="fa fa-save"/>
                                <t t-if="state.saving"> Đang lưu...</t>
                                <t t-else=""> Lưu</t>
                            </button>
                        </div>
                    </header>

                    <t t-if="state.loading">
                        <div class="o_daa_loading"><i class="fa fa-spinner fa-spin fa-2x"/></div>
                    </t>
                    <t t-else="">
                        <div class="o_daa_toolbar">
                            <button type="button" class="btn o_daa_btn_add" t-on-click="addRow">
                                <i class="fa fa-plus"/> Thêm user
                            </button>
                            <span t-if="state.dirty" class="o_daa_dirty">● Có thay đổi chưa lưu</span>
                        </div>

                        <div class="o_daa_table_wrap">
                            <table class="o_daa_table">
                                <thead>
                                    <tr>
                                        <th class="o_daa_col_stt" rowspan="2">STT</th>
                                        <th class="o_daa_col_user" rowspan="2">User</th>
                                        <th class="o_daa_col_group" rowspan="2">Nhóm quyền</th>
                                        <th colspan="5" class="o_daa_col_perms_head">Quyền</th>
                                        <th class="o_daa_col_act" rowspan="2">Thao tác</th>
                                    </tr>
                                    <tr>
                                        <th class="o_daa_col_perm">Xem</th>
                                        <th class="o_daa_col_perm">Thêm</th>
                                        <th class="o_daa_col_perm">Chỉnh sửa</th>
                                        <th class="o_daa_col_perm">Xóa</th>
                                        <th class="o_daa_col_perm">All</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.rows" t-as="row" t-key="row.key">
                                        <tr class="o_daa_row o_daa_row_first o_daa_row_last">
                                            <td class="o_daa_col_stt" t-esc="row_index + 1"/>
                                            <td class="o_daa_col_user">
                                                <div class="o_daa_multi" t-on-click.stop="() => { row.open = true; }">
                                                    <span t-if="employeeOf(row)" class="o_daa_tag">
                                                        <span t-esc="employeeOf(row).name"/>
                                                        <button type="button" class="o_daa_tag_x" title="Bỏ chọn"
                                                                t-on-click.stop="() => this.clearEmployee(row)">×</button>
                                                    </span>
                                                    <input t-else="" type="text" class="o_daa_multi_input"
                                                           placeholder="Gõ tên để tìm / chọn user..."
                                                           t-att-value="row.query"
                                                           t-on-input="(ev) => this.onQueryInput(row, ev)"
                                                           t-on-focus="() => { row.open = true; }"
                                                           t-on-blur="() => this.onQueryBlur(row)"
                                                           t-on-keydown="(ev) => this.onQueryKeydown(row, ev)"/>
                                                </div>
                                                <div t-if="row.open and !row.employee_id and suggestions(row).length" class="o_daa_suggest">
                                                    <t t-foreach="suggestions(row)" t-as="sug" t-key="sug.id">
                                                        <button type="button" class="o_daa_suggest_item"
                                                                t-on-mousedown.prevent="() => this.pickEmployee(row, sug.id)">
                                                            <strong t-esc="sug.name"/>
                                                            <span t-if="sug.department_name" class="o_daa_suggest_dept" t-esc="sug.department_name"/>
                                                        </button>
                                                    </t>
                                                </div>
                                            </td>
                                            <td class="o_daa_col_group">Plan tổng team</td>
                                            <t t-foreach="PERMS" t-as="perm" t-key="perm.key + '-' + (row[perm.key] ? '1' : '0')">
                                                <td class="o_daa_col_perm">
                                                    <label class="o_daa_check">
                                                        <input type="checkbox" t-att-checked="row[perm.key] or undefined"
                                                               t-on-change="(ev) => this.togglePerm(row, perm.key, ev)"/>
                                                        <span class="o_daa_box"/>
                                                    </label>
                                                </td>
                                            </t>
                                            <td class="o_daa_col_perm" t-key="'all-' + (isAll(row) ? '1' : '0')">
                                                <label class="o_daa_check">
                                                    <input type="checkbox" t-att-checked="isAll(row) or undefined"
                                                           t-on-change="(ev) => this.toggleAll(row, ev)"/>
                                                    <span class="o_daa_box"/>
                                                </label>
                                            </td>
                                            <td class="o_daa_col_act">
                                                <button type="button" class="btn btn-link o_daa_btn_del" title="Xóa dòng"
                                                        t-on-click="() => this.removeRow(row)">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </DailyWorkAppShell>
        </div>
    </t>
</templates>
