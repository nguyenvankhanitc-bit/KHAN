<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="lug_project.LugPlistUserChip">
        <span class="o_lug_plist_user" t-att-title="user.name">
            <t t-if="user.avatar_url">
                <img class="o_lug_plist_user_img" t-att-src="user.avatar_url" t-att-alt="user.name"/>
            </t>
            <t t-else="">
                <span class="o_lug_plist_user_init" t-att-style="'background:' + user.color" t-esc="user.initial"/>
            </t>
            <span t-if="showName" class="o_lug_plist_user_name" t-esc="user.name"/>
        </span>
    </t>

    <t t-name="lug_project.LugPlistAssignees">
        <div class="o_lug_plist_assignees">
            <t t-if="!assignees.users.length">
                <span class="o_lug_plist_muted">—</span>
            </t>
            <t t-else="">
                <t t-foreach="assignees.users" t-as="user" t-key="user.id">
                    <t t-call="lug_project.LugPlistUserChip">
                        <t t-set="user" t-value="user"/>
                        <t t-set="showName" t-value="false"/>
                    </t>
                </t>
                <span t-if="assignees.extra" class="o_lug_plist_user_more">+<t t-esc="assignees.extra"/></span>
            </t>
        </div>
    </t>

    <t t-name="lug_project.LugProjectList">
        <div class="o_lug_plist" data-lug-plist="v4-light">
            <header class="o_lug_plist_toolbar">
                <button type="button" class="o_lug_plist_btn o_lug_plist_btn--primary" t-on-click="onNew">
                    Mới
                </button>
                <div class="o_lug_plist_search">
                    <i class="fa fa-search"/>
                    <input type="search"
                           placeholder="Tìm kiếm dự án, cửa hàng..."
                           t-att-value="state.search"
                           t-on-input="onSearchInput"/>
                </div>
                <div class="o_lug_plist_pager">
                    <span t-esc="pagerLabel"/>
                    <button type="button" class="o_lug_plist_pg" t-att-disabled="!canPrev" t-on-click="prevPage">
                        <i class="fa fa-angle-left"/>
                    </button>
                    <button type="button" class="o_lug_plist_pg" t-att-disabled="!canNext" t-on-click="nextPage">
                        <i class="fa fa-angle-right"/>
                    </button>
                </div>
            </header>

            <t t-if="state.loading">
                <div class="o_lug_plist_loading">
                    <i class="fa fa-spinner fa-spin"/> Đang tải danh sách...
                </div>
            </t>
            <t t-elif="!state.rows.length">
                <div class="o_lug_plist_empty">Không có dự án nào.</div>
            </t>
            <t t-else="">
                <div class="o_lug_plist_table_wrap">
                    <table class="o_lug_plist_table">
                        <thead>
                            <tr>
                                <th class="col-stt">STT</th>
                                <th class="col-code">MÃ DỰ ÁN</th>
                                <th class="col-name">TÊN CỬA HÀNG / DỰ ÁN</th>
                                <th class="col-type">LOẠI DỰ ÁN</th>
                                <th class="col-deadline">DEADLINE</th>
                                <th class="col-manager">TRƯỞNG DỰ ÁN</th>
                                <th class="col-assignee">NGƯỜI PHỤ TRÁCH</th>
                                <th class="col-status">TRẠNG THÁI</th>
                                <th class="col-time">TIMELEFT</th>
                                <th class="col-exp"/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.rows" t-as="row" t-key="row.id">
                                <tr t-att-class="'o_lug_plist_row' + (isExpanded(row.id) ? ' is-open' : '')"
                                    t-on-click="() => this.toggleRow(row.id)">
                                    <td class="col-stt" t-esc="row.stt"/>
                                    <td class="col-code"><span class="o_lug_plist_code" t-esc="row.code"/></td>
                                    <td class="col-name" t-esc="row.name"/>
                                    <td class="col-type">
                                        <span t-if="row.type.tone !== 'none'"
                                              t-att-class="'o_lug_plist_type is-' + row.type.tone"
                                              t-esc="row.type.label"/>
                                        <span t-else="" class="o_lug_plist_muted">—</span>
                                    </td>
                                    <td t-att-class="'col-deadline' + (row.deadline_late ? ' is-late' : '')" t-esc="row.deadline or '—'"/>
                                    <td class="col-manager">
                                        <t t-if="row.manager">
                                            <t t-call="lug_project.LugPlistUserChip">
                                                <t t-set="user" t-value="row.manager"/>
                                                <t t-set="showName" t-value="true"/>
                                            </t>
                                        </t>
                                        <span t-else="" class="o_lug_plist_muted">—</span>
                                    </td>
                                    <td class="col-assignee">
                                        <t t-call="lug_project.LugPlistAssignees">
                                            <t t-set="assignees" t-value="row.assignees"/>
                                        </t>
                                    </td>
                                    <td class="col-status">
                                        <span t-att-class="'o_lug_plist_pill is-' + row.status" t-esc="row.status_label"/>
                                    </td>
                                    <td class="col-time">
                                        <span t-att-class="'o_lug_plist_tl is-' + (row.timeleft.state or 'none')">
                                            <i t-if="row.timeleft.state === 'done'" class="fa fa-check"/>
                                            <i t-elif="row.timeleft.state === 'ok'" class="fa fa-hourglass-half"/>
                                            <i t-elif="row.timeleft.state === 'late'" class="fa fa-exclamation-triangle"/>
                                            <span t-esc="row.timeleft.short or row.timeleft.label"/>
                                        </span>
                                    </td>
                                    <td class="col-exp">
                                        <span class="o_lug_plist_exp_btn">
                                            <i t-att-class="'fa fa-chevron-' + (isExpanded(row.id) ? 'down' : 'right')"/>
                                        </span>
                                    </td>
                                </tr>
                                <tr t-if="isExpanded(row.id)" class="o_lug_plist_detail_row">
                                    <td colspan="10">
                                        <t t-if="state.detailLoading === row.id">
                                            <div class="o_lug_plist_detail_loading">
                                                <i class="fa fa-spinner fa-spin"/> Đang tải chi tiết...
                                            </div>
                                        </t>
                                        <t t-elif="state.details[row.id]">
                                            <t t-set="detail" t-value="state.details[row.id]"/>
                                            <section class="o_lug_plist_detail">
                                                <header class="o_lug_plist_detail_head">
                                                    <h3>CHI TIẾT THÔNG TIN DỰ ÁN BAN ĐẦU</h3>
                                                    <div class="o_lug_plist_wf">
                                                        <t t-foreach="workflowOptions" t-as="opt" t-key="opt.key">
                                                            <button type="button"
                                                                    t-att-class="'o_lug_plist_wf_btn' + (detail.workflow_state === opt.key ? ' is-active' : '')"
                                                                    t-on-click.stop="() => this.setWorkflow(row.id, opt.key)"
                                                                    t-esc="opt.label"/>
                                                        </t>
                                                    </div>
                                                </header>
                                                <div class="o_lug_plist_detail_grid">
                                                    <div class="o_lug_plist_detail_info">
                                                        <dl>
                                                            <dt>Mã dự án</dt><dd class="o_lug_plist_code" t-esc="detail.code"/>
                                                            <dt>Tên dự án</dt><dd t-esc="detail.name"/>
                                                            <dt>Tên cửa hàng</dt><dd t-esc="detail.name"/>
                                                            <dt>Loại dự án</dt>
                                                            <dd>
                                                                <span t-if="detail.type.tone !== 'none'"
                                                                      t-att-class="'o_lug_plist_type is-' + detail.type.tone"
                                                                      t-esc="detail.type.label"/>
                                                                <span t-else="" class="o_lug_plist_muted">—</span>
                                                            </dd>
                                                            <dt>Trưởng dự án</dt>
                                                            <dd>
                                                                <t t-if="detail.manager">
                                                                    <t t-call="lug_project.LugPlistUserChip">
                                                                        <t t-set="user" t-value="detail.manager"/>
                                                                        <t t-set="showName" t-value="true"/>
                                                                    </t>
                                                                </t>
                                                                <span t-else="" class="o_lug_plist_muted">—</span>
                                                            </dd>
                                                            <dt>Người phụ trách</dt>
                                                            <dd>
                                                                <t t-call="lug_project.LugPlistAssignees">
                                                                    <t t-set="assignees" t-value="detail.assignees"/>
                                                                </t>
                                                            </dd>
                                                            <dt>File PDF đính kèm</dt>
                                                            <dd>
                                                                <t t-if="detail.pdf_id">
                                                                    <button type="button" class="o_lug_plist_link" t-on-click.stop="() => this.openPdf(row.id)">
                                                                        <i class="fa fa-file-pdf-o"/> <t t-esc="detail.pdf_name"/>
                                                                    </button>
                                                                </t>
                                                                <t t-else="">—</t>
                                                            </dd>
                                                        </dl>
                                                    </div>
                                                    <div class="o_lug_plist_detail_timeline">
                                                        <dl>
                                                            <dt>Ngày bắt đầu</dt><dd t-esc="detail.date_start or '—'"/>
                                                            <dt>Deadline</dt><dd class="is-strong" t-esc="detail.deadline or '—'"/>
                                                            <dt>Ngày kết thúc dự kiến</dt><dd t-esc="detail.date_end or '—'"/>
                                                            <dt>Ngày cung cấp</dt><dd t-esc="detail.supply_date or '—'"/>
                                                        </dl>
                                                        <div class="o_lug_plist_timeleft_total">
                                                            <strong>Timeleft tổng:</strong>
                                                            <span t-att-class="'o_lug_plist_tl is-' + (detail.timeleft.state or 'none')">
                                                                <i class="fa fa-hourglass-half"/>
                                                                <t t-esc="detail.timeleft.label"/>
                                                                <t t-if="detail.timeleft.hint"> (<t t-esc="detail.timeleft.hint"/>)</t>
                                                            </span>
                                                        </div>
                                                        <div class="o_lug_plist_progress">
                                                            <div class="o_lug_plist_progress_label">
                                                                <strong>Tiến độ công việc:</strong>
                                                                <span t-esc="progressLabel(detail)"/>
                                                            </div>
                                                            <div class="o_lug_plist_progress_track">
                                                                <i t-att-style="'width:' + (detail.progress_pct || 0) + '%'"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <section class="o_lug_plist_phases">
                                                    <header class="o_lug_plist_phases_head">
                                                        DANH SÁCH CÔNG VIỆC CHI TIẾT THEO GIAI ĐOẠN:
                                                    </header>
                                                    <div class="o_lug_plist_phases_table_wrap">
                                                        <table class="o_lug_plist_phases_table">
                                                            <thead>
                                                                <tr>
                                                                    <th>GIAI ĐOẠN</th>
                                                                    <th>TÊN CÔNG VIỆC GIAI ĐOẠN</th>
                                                                    <th>PHỤ TRÁCH</th>
                                                                    <th>DEADLINE</th>
                                                                    <th>KẾT QUẢ</th>
                                                                    <th>TRẠNG THÁI</th>
                                                                    <th>TIMELEFT</th>
                                                                    <th>GHI CHÚ</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <t t-foreach="detail.stages" t-as="stage" t-key="stage.id">
                                                                    <t t-foreach="stage.tasks" t-as="task" t-key="task.id">
                                                                        <tr>
                                                                            <td>
                                                                                <span t-att-class="'o_lug_plist_phase is-' + stage.phase_tone" t-esc="stage.phase_label"/>
                                                                            </td>
                                                                            <td t-esc="task.name"/>
                                                                            <td><i class="fa fa-user o_lug_plist_task_user"/> <t t-esc="task.assignees"/></td>
                                                                            <td t-esc="task.deadline or '—'"/>
                                                                            <td t-esc="task.result"/>
                                                                            <td>
                                                                                <span t-att-class="'o_lug_plist_task_pill is-' + task.state" t-esc="task.state_label"/>
                                                                            </td>
                                                                            <td>
                                                                                <span t-att-class="'o_lug_plist_tl is-' + (task.timeleft.state or 'none')">
                                                                                    <i t-if="task.timeleft.state === 'ok'" class="fa fa-hourglass-half"/>
                                                                                    <i t-elif="task.timeleft.state === 'late'" class="fa fa-exclamation-triangle"/>
                                                                                    <t t-esc="task.timeleft.short or task.timeleft.label"/>
                                                                                </span>
                                                                            </td>
                                                                            <td t-esc="task.notes or '—'"/>
                                                                        </tr>
                                                                    </t>
                                                                    <tr t-if="!stage.tasks.length" class="o_lug_plist_phase_empty">
                                                                        <td>
                                                                            <span t-att-class="'o_lug_plist_phase is-' + stage.phase_tone" t-esc="stage.phase_label"/>
                                                                        </td>
                                                                        <td colspan="7" class="o_lug_plist_muted">Chưa có công việc trong giai đoạn này.</td>
                                                                    </tr>
                                                                </t>
                                                                <tr t-if="!detail.stages.length">
                                                                    <td colspan="8" class="o_lug_plist_muted">Chưa có giai đoạn công việc.</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </section>

                                                <footer class="o_lug_plist_detail_actions">
                                                    <button type="button" class="o_lug_plist_btn o_lug_plist_btn--primary" t-on-click.stop="() => this.editProject(row.id)">
                                                        <i class="fa fa-pencil"/> Sửa dự án
                                                    </button>
                                                    <button type="button" class="o_lug_plist_btn o_lug_plist_btn--ghost" t-on-click.stop="() => this.addTask(row.id)">
                                                        + Thêm công việc
                                                    </button>
                                                    <button type="button" class="o_lug_plist_btn o_lug_plist_btn--ghost" t-on-click.stop="() => this.viewGantt(row.id)">
                                                        <i class="fa fa-bar-chart"/> Xem Gantt Chart
                                                    </button>
                                                </footer>
                                            </section>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>

</templates>
